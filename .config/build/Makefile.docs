# FLEXT Documentation Makefile
# This Makefile provides convenient commands for managing FLEXT documentation

.PHONY: help install-docs clean-docs build-docs serve-docs generate-docs validate-docs deploy-docs

# Default target
help: ## Show this help message
	@echo "FLEXT Documentation Management"
	@echo "=============================="
	@echo ""
	@echo "Available commands:"
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

# Install documentation dependencies
install-docs: ## Install MkDocs and documentation dependencies
	@echo "Installing documentation dependencies..."
	pip install -e ".[docs]"
	@echo "✓ Documentation dependencies installed"

# Clean documentation build artifacts
clean-docs: ## Clean documentation build artifacts
	@echo "Cleaning documentation build artifacts..."
	rm -rf site/
	rm -rf docs/.cache/
	rm -rf docs/build/
	@echo "✓ Documentation build artifacts cleaned"

# Build documentation
build-docs: ## Build documentation with MkDocs
	@echo "Building documentation..."
	mkdocs build --clean
	@echo "✓ Documentation built successfully"

# Serve documentation locally
serve-docs: ## Serve documentation locally for development
	@echo "Starting documentation server..."
	@echo "Documentation will be available at: http://localhost:8000"
	@echo "Press Ctrl+C to stop the server"
	mkdocs serve

# Generate complete documentation
generate-docs: ## Generate complete documentation including API docs and diagrams
	@echo "Generating complete documentation..."
	python scripts/generate_docs.py --clean
	@echo "✓ Complete documentation generated"

# Generate only component documentation
generate-components: ## Generate only component documentation
	@echo "Generating component documentation..."
	python scripts/generate_docs.py --components-only
	@echo "✓ Component documentation generated"

# Development workflow
dev-docs: ## Generate and serve documentation for development
	@echo "Starting development documentation workflow..."
	python scripts/generate_docs.py --clean --serve

# Validate documentation
validate-docs: ## Validate documentation build with strict mode
	@echo "Validating documentation..."
	mkdocs build --strict
	@echo "✓ Documentation validation passed"

# Check for broken links
check-links: ## Check for broken links in documentation
	@echo "Checking for broken links..."
	@if command -v linkchecker >/dev/null 2>&1; then \
		linkchecker http://localhost:8000; \
	else \
		echo "linkchecker not found. Install with: pip install linkchecker"; \
	fi

# Deploy documentation to GitHub Pages
deploy-docs: ## Deploy documentation to GitHub Pages
	@echo "Deploying documentation to GitHub Pages..."
	mkdocs gh-deploy --force
	@echo "✓ Documentation deployed to GitHub Pages"

# Generate API documentation
api-docs: ## Generate API documentation only
	@echo "Generating API documentation..."
	python -m flext_tools.documentation.generator --api-only
	@echo "✓ API documentation generated"

# Generate architecture diagrams
diagrams: ## Generate architecture diagrams only
	@echo "Generating architecture diagrams..."
	python -m flext_tools.documentation.generator --diagrams-only
	@echo "✓ Architecture diagrams generated"

# Update documentation dependencies
update-docs-deps: ## Update documentation dependencies
	@echo "Updating documentation dependencies..."
	pip install --upgrade -e ".[docs]"
	@echo "✓ Documentation dependencies updated"

# Calculate documentation coverage
coverage-docs: ## Calculate documentation coverage
	@echo "Calculating documentation coverage..."
	@python -c "
import os
from pathlib import Path

def count_files(directory, extensions):
    count = 0
    for ext in extensions:
        count += len(list(Path(directory).rglob(f'*{ext}')))
    return count

docs_dir = Path('docs')
projects_dir = Path('docs/projects')

if docs_dir.exists():
    md_files = count_files(docs_dir, ['.md'])
    py_files = count_files(Path('.'), ['.py'])
    
    # Count projects with documentation
    projects_with_docs = 0
    if projects_dir.exists():
        for project_dir in projects_dir.iterdir():
            if project_dir.is_dir() and (project_dir / 'README.md').exists():
                projects_with_docs += 1
    
    total_projects = len([d for d in Path('.').iterdir() if d.is_dir() and d.name.startswith('flext-')])
    
    print(f'📄 Markdown files: {md_files}')
    print(f'🐍 Python files: {py_files}')
    print(f'📦 Projects with docs: {projects_with_docs}/{total_projects}')
    print(f'📊 Documentation coverage: {projects_with_docs/total_projects*100:.1f}%')
else:
    print('❌ Documentation directory not found')
"

# Format documentation
format-docs: ## Format documentation files
	@echo "Formatting documentation files..."
	@if command -v mdformat >/dev/null 2>&1; then \
		mdformat docs/; \
		echo "✓ Documentation formatted"; \
	else \
		echo "mdformat not found. Install with: pip install mdformat"; \
	fi

# Lint documentation
lint-docs: ## Lint documentation files
	@echo "Linting documentation files..."
	@if command -v markdownlint >/dev/null 2>&1; then \
		markdownlint docs/; \
		echo "✓ Documentation linting passed"; \
	else \
		echo "markdownlint not found. Install with: npm install -g markdownlint-cli"; \
	fi

# Backup documentation
backup-docs: ## Backup current documentation
	@echo "Backing up documentation..."
	@if [ -d "docs" ]; then \
		tar -czf "docs-backup-$$(date +%Y%m%d-%H%M%S).tar.gz" docs/; \
		echo "✓ Documentation backed up"; \
	else \
		echo "❌ Documentation directory not found"; \
	fi

# Restore documentation from backup
restore-docs: ## Restore documentation from backup
	@echo "Restoring documentation from backup..."
	@if [ -f "docs-backup-*.tar.gz" ]; then \
		ls -t docs-backup-*.tar.gz | head -1 | xargs tar -xzf; \
		echo "✓ Documentation restored"; \
	else \
		echo "❌ No backup files found"; \
	fi

# Generate documentation report
report-docs: ## Generate documentation report
	@echo "Generating documentation report..."
	@echo "📊 FLEXT Documentation Report"
	@echo "=============================="
	@echo "📁 Documentation structure:"
	@find docs/ -type f -name "*.md" | head -10 | sed 's/^/  /'
	@echo ""
	@echo "📝 Code blocks: $$(grep -r '```' docs/ | wc -l)"
	@echo "🎨 Diagrams: $$(grep -r '```mermaid' docs/ | wc -l)"
	@echo "🔗 Links: $$(grep -r 'http' docs/ | wc -l)"
	@echo "📦 Components: $$(find docs/projects -maxdepth 1 -type d 2>/dev/null | wc -l)"

# Full documentation workflow
all-docs: install-docs clean-docs generate-docs build-docs ## Complete documentation workflow
	@echo "✓ Complete documentation workflow finished"

# Quick documentation generation
quick-docs: clean-docs generate-components build-docs ## Quick documentation generation
	@echo "✓ Quick documentation generation finished"

# Documentation statistics
stats-docs: ## Show documentation statistics
	@echo "📊 FLEXT Documentation Statistics"
	@echo "================================"
	@echo "📄 Total markdown files: $$(find docs/ -name '*.md' | wc -l)"
	@echo "📁 Documentation directories: $$(find docs/ -type d | wc -l)"
	@echo "🔗 Internal links: $$(grep -r '\[.*\](.*\.md)' docs/ | wc -l)"
	@echo "🌐 External links: $$(grep -r 'http' docs/ | wc -l)"
	@echo "📝 Code blocks: $$(grep -r '```' docs/ | wc -l)"
	@echo "🎨 Mermaid diagrams: $$(grep -r '```mermaid' docs/ | wc -l)"
	@echo "📦 Component docs: $$(find docs/projects -name 'README.md' | wc -l)"
	@echo "📚 API docs: $$(find docs/reference -name '*.md' | wc -l)"
	@echo "🏗️ Architecture docs: $$(find docs/developer/architecture -name '*.md' | wc -l)"
