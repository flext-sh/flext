#!/usr/bin/env python3
"""Algar LDAP/OUD CLI wrapper - alg-ldap."""

import sys
import os
from pathlib import Path

# Add the source directory to Python path
sys.path.insert(0, str(Path(__file__).parent / "project-algar-oud" / "src"))

# Change to source directory for proper execution
os.chdir(str(Path(__file__).parent / "project-algar-oud" / "src"))

try:
    from oud_automation.cli.app import main
    main(sys.argv[1:])
except ImportError as e:
    print(f"❌ Error importing Algar LDAP CLI: {e}")
    print("Make sure dependencies are installed and FLX framework is available")
    sys.exit(1)
except Exception as e:
    print(f"❌ Error running Algar LDAP CLI: {e}")
    sys.exit(1)