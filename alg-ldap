#!/usr/bin/env python3
"""client-a LDAP/OUD CLI wrapper - alg-ldap."""

import sys
import os
from pathlib import Path

# Add the source directory to Python path
sys.path.insert(0, str(Path(__file__).parent / "project-client-a-oud" / "src"))

# Change to source directory for proper execution
os.chdir(str(Path(__file__).parent / "project-client-a-oud" / "src"))

try:
    from oud_automation.cli.app import main
    main(sys.argv[1:])
except ImportError as e:
    print(f"❌ Error importing client-a LDAP CLI: {e}")
    print("Make sure dependencies are installed and FLX framework is available")
    sys.exit(1)
except Exception as e:
    print(f"❌ Error running client-a LDAP CLI: {e}")
    sys.exit(1)