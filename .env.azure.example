# Azure OpenAI Configuration for FLX Analyzer
# ----------------------------------------
# This file contains the environment variables needed for the Azure OpenAI
# integration in the FLX Analyzer tool.
#
# To use this file:
# 1. Copy this file to .env.azure
# 2. Fill in your Azure OpenAI credentials
# 3. Run the analyzer with --enable-azure-openai flag
#
# Note: You will need an Azure subscription with access to Azure OpenAI Services.

# Azure OpenAI Embeddings Configuration
# -------------------------------------
# These settings are used for semantic code analysis to detect similar functions
# based on their meaning rather than just syntax.

# API key for your Azure OpenAI embeddings deployment
AZURE_OPENAI_EMBEDDING_API_KEY=your_embedding_api_key_here

# The endpoint URL for your Azure OpenAI resource
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-resource-name.openai.azure.com

# The deployment name for your embedding model
# Recommended: text-embedding-ada-002 or text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002

# The API version to use
AZURE_OPENAI_EMBEDDING_API_VERSION=2023-05-15

# Azure OpenAI LLM Configuration
# -----------------------------
# These settings are used for advanced code analysis and recommendations.
# The LLM can provide deeper insights into code organization and suggestions.

# API key for your Azure OpenAI LLM deployment
AZURE_OPENAI_LLM_API_KEY=your_llm_api_key_here

# The endpoint URL for your Azure OpenAI resource
AZURE_OPENAI_LLM_ENDPOINT=https://your-resource-name.openai.azure.com

# The deployment name for your LLM model
AZURE_OPENAI_LLM_DEPLOYMENT_NAME=gpt-4

# The model name
AZURE_OPENAI_LLM_MODEL=gpt-4

# The API version to use
AZURE_OPENAI_LLM_API_VERSION=2023-05-15 
