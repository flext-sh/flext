# ============================================================================
# FLEXT WORKSPACE - AGGRESSIVE WHITELIST .gitignore
# Multi-language monorepo: Python 3.13+ | Go 1.21+ | Docker | Singer/Meltano
# Strategy: Block everything by default, explicitly allow only needed files
# ============================================================================

# ============================================================================
# BLOCK EVERYTHING BY DEFAULT
# ============================================================================
/*
/*/

# ============================================================================
# WHITELIST: Project Directories
# ============================================================================
# Allow all FLEXT ecosystem project directories
!flext-*/
!flexcore/

# ============================================================================
# WHITELIST: Workspace Directories
# ============================================================================
!scripts/
!docker/
!docs/
!examples/
!.github/
!cmd/
!pkg/
!src/
!tests/
!typings/
!.vscode/

# ============================================================================
# BLOCK: Beads Workflow (local-only, not tracked)
# ============================================================================
.beads/
**/.beads/

# ============================================================================
# WHITELIST: Root-Level Configuration Files
# ============================================================================

# Python configuration
!pyproject.toml
!poetry.lock
!ruff-shared.toml

# Go configuration
!go.mod
!gopy.mod
!go.sum

# Docker configuration
!.dockerignore

# Build and automation
!Makefile
!Makefile.flext-docker
!*.mk

# Documentation
!README.md
!AGENTS.md
!.markdownlint.json

# Git configuration
!.gitignore
!.gitmodules
!.gitattributes

# Environment templates (NOT .env - keep secrets out!)
!.env.test
!.env.example
!.env.template

# ============================================================================
# WHITELIST: Contents Inside Allowed Directories
# ============================================================================
!flext-*/**
!flexcore/**
!scripts/**
!docker/**
!docs/**
!examples/**
!.github/**
!cmd/**
!pkg/**
!src/**
!tests/**
!typings/**
!.vscode/**

# ============================================================================
# BLOCK: AI/Agent Local Data (NEVER track these)
# ============================================================================

# Claude Code local data (315MB+, contains debug, history, credentials)
.claude/
**/.claude/

# NOTE: .planning/ is NOW TRACKED (commit_docs: true in config.json)
# Archive directories within .planning are still local
.planning/archive/

# AI Plans in docs
docs/plans/

# Aider AI data
.aider/
.aider.conf.yml
.aider.chat.history.md
**/.aider/

# Other AI assistants
.cursor/
.copilot/
.codeium/

# Temporary test/debug scripts (keep main scripts, block test_* pattern at root)
scripts/test_*.py
scripts/test-*.py

# ============================================================================
# BLOCK: Oracle Reference and Test Data
# ============================================================================

# Oracle dump files
**/*.dmp
**/*.DMP

# Oracle logs
**/*.trc
**/*.aud

# Oracle wallet files
**/cwallet.sso
**/ewallet.p12
**/tnsnames.ora
**/sqlnet.ora

# Oracle test/reference data directories
**/oracle_data/
**/oracle_dump/
**/oracle_export/
**/oracle_import/
**/expdp_*/
**/impdp_*/


# ============================================================================
# AGGRESSIVE BLACKLIST: Block artifacts INSIDE whitelisted directories
# ============================================================================

# Python artifacts inside allowed directories
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.so
**/*.egg
**/*.egg-info/
**/dist/
**/build/
**/.eggs/

# Python caches inside allowed directories
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/.hypothesis/
**/.tox/
**/.nox/
**/.benchmarks/

# Coverage reports inside allowed directories
**/htmlcov/
**/.coverage
**/coverage.json
**/.coverage.*
**/coverage.xml
**/*.cover

# Virtual environments inside allowed directories (should never be committed)
**/.venv/
**/venv/
**/env/
**/ENV/
**/.virtualenv/

# Go build artifacts inside allowed directories
**/*.exe
**/*.exe~
**/*.dll
**/*.dylib
**/*.test
**/*.out

# Node.js inside allowed directories
**/node_modules/
**/npm-debug.log
**/yarn-error.log
**/.npm/
**/.yarn/

# IDE and editor files inside allowed directories
**/.idea/
**/*.iml
**/.vscode/*.code-workspace
**/.vscode/internal.invalid.json
**/*.swp
**/*.swo
**/*~
**/.*.sw?

# OS files inside allowed directories
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# Temporary and log files inside allowed directories
**/*.log
**/*.tmp
**/*.temp
**/tmp/
**/temp/
**/.tmp/

# Build and quality tool artifacts inside allowed directories
**/.qlty/
**/.meltano/
**/.serena/

# Backup files inside allowed directories
**/*.bak
**/*.backup
**/*.orig
**/*_backup
**/*_backup_*
**/*.md.backup
**/archived/

# Database files inside allowed directories
**/*.db
**/*.sqlite
**/*.sqlite3

# Compiled files inside allowed directories
**/*.class
**/*.o
**/*.obj
**/*.a

# Archive files inside allowed directories (usually shouldn't be in git)
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.rar
**/*.7z

# ============================================================================
# SECURITY: Explicit Blocks (NEVER commit these)
# ============================================================================

# Environment files with actual secrets
.env
.internal.invalid
.env.production
.env.development
**/.env

# Credentials and keys
*.key
*.pem
*.p12
*.pfx
credentials.json
**/credentials.json
secrets.yaml
secrets.yml
**/.credentials*

# ============================================================================
# ALLOW: Preserve Empty Directories
# ============================================================================

!**/.gitkeep

# ============================================================================
# FINAL SAFETY NET
# ============================================================================

# Ensure these are NEVER committed, even if explicitly added
.milvus/
.claude-data/
.devcontainer/.host-gitconfig
.devcontainer/.env
