# ============================================================================
# FLEXT WORKSPACE - AGGRESSIVE WHITELIST .gitignore
# Multi-language monorepo: Python 3.13+ | Go 1.21+ | Docker | Singer/Meltano
# Strategy: Block everything by default, explicitly allow only needed files
# ============================================================================

# ============================================================================
# BLOCK EVERYTHING BY DEFAULT
# ============================================================================
/*
/*/

# ============================================================================
# WHITELIST: Project Directories
# ============================================================================
# Allow all FLEXT ecosystem project directories
!flext-*/
!flexcore/

# ============================================================================
# WHITELIST: Workspace Directories
# ============================================================================
!scripts/
!docker/
!docs/
!examples/
!.github/
!cmd/
!pkg/
!src/
!tests/
!typings/
!.vscode/

# ============================================================================
# WHITELIST: Root-Level Configuration Files
# ============================================================================

# Python configuration
!pyproject.toml
!poetry.lock
!ruff-shared.toml

# Go configuration
!go.mod
!gopy.mod
!go.sum

# Docker configuration
!.dockerignore

# Build and automation
!Makefile
!Makefile.flext-docker

# Documentation
!README.md
!.markdownlint.json

# Git configuration
!.gitignore
!.gitmodules
!.gitattributes

# Environment templates (NOT .env - keep secrets out!)
!.env.test
!.env.example
!.env.template

# ============================================================================
# WHITELIST: Contents Inside Allowed Directories
# ============================================================================
!flext-*/**
!flexcore/**
!scripts/**
!docker/**
!docs/**
!examples/**
!.github/**
!cmd/**
!pkg/**
!src/**
!tests/**
!typings/**
!.vscode/**

# ============================================================================
# AGGRESSIVE BLACKLIST: Block artifacts INSIDE whitelisted directories
# ============================================================================

# Python artifacts inside allowed directories
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.so
**/*.egg
**/*.egg-info/
**/dist/
**/build/
**/.eggs/

# Python caches inside allowed directories
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/.hypothesis/
**/.tox/
**/.nox/
**/.benchmarks/

# Coverage reports inside allowed directories
**/htmlcov/
**/.coverage
**/coverage.json
**/.coverage.*
**/coverage.xml
**/*.cover

# Virtual environments inside allowed directories (should never be committed)
**/.venv/
**/venv/
**/env/
**/ENV/
**/.virtualenv/

# Go build artifacts inside allowed directories
**/*.exe
**/*.exe~
**/*.dll
**/*.dylib
**/*.test
**/*.out

# Node.js inside allowed directories
**/node_modules/
**/npm-debug.log
**/yarn-error.log
**/.npm/
**/.yarn/

# IDE and editor files inside allowed directories
**/.idea/
**/*.iml
**/.vscode/*.code-workspace
**/.vscode/internal.invalid.json
**/*.swp
**/*.swo
**/*~
**/.*.sw?

# OS files inside allowed directories
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# Temporary and log files inside allowed directories
**/*.log
**/*.tmp
**/*.temp
**/tmp/
**/temp/
**/.tmp/

# Build and quality tool artifacts inside allowed directories
**/.qlty/
**/.meltano/
**/.serena/cache/
**/.claude/cache/

# Backup files inside allowed directories
**/*.bak
**/*.backup
**/*.orig
**/*_backup
**/*_backup_*
**/*.md.backup

# Database files inside allowed directories
**/*.db
**/*.sqlite
**/*.sqlite3

# Compiled files inside allowed directories
**/*.class
**/*.o
**/*.obj
**/*.a

# Archive files inside allowed directories (usually shouldn't be in git)
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.rar
**/*.7z

# ============================================================================
# SECURITY: Explicit Blocks (NEVER commit these)
# ============================================================================

# Environment files with actual secrets
.env
.internal.invalid
.env.production
.env.development
**/.env

# Credentials and keys
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.yaml
secrets.yml

# ============================================================================
# BLOCK: Build Artifacts and Caches
# ============================================================================

# Python artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
dist/
build/
*.egg-info/

# Python caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.benchmarks/

# Coverage
htmlcov/
.coverage
coverage.json
.coverage.*

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Meltano
.meltano/

# Quality tools
.qlty/

# Virtual environments
.venv/
venv/
env/
ENV/

# ============================================================================
# BLOCK: IDE and Editor Files
# ============================================================================

# VS Code workspace files (allow .vscode/ directory but block workspace files)
.vscode/*.code-workspace
.vscode/internal.invalid.json

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~
.*.sw?

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================================
# BLOCK: Temporary and Log Files
# ============================================================================

*.log
*.tmp
*.temp
.tmp/
tmp/
temp/
logs/

# ============================================================================
# BLOCK: Project-Level .gitignore Files (they have their own)
# ============================================================================

# Each project manages its own .gitignore, no need to duplicate here

# ============================================================================
# ALLOW: Preserve Empty Directories
# ============================================================================

!**/.gitkeep

# ============================================================================
# FINAL SAFETY NET
# ============================================================================

# Ensure these are NEVER committed, even if explicitly added
.env
**/.env
*.key
*.pem
credentials.json
secrets.yaml
secrets.yml
