from _typeshed import Incomplete
from typing import ClassVar

class Error(Exception): ...
class DecodeError(Error): ...
class EncodeError(Error): ...

class Message:
    DESCRIPTOR: ClassVar[None] = ...
    def __deepcopy__(self, memo: Incomplete | None = ...): ...
    def __dir__(self): ...
    def __eq__(self, other_msg) -> bool: ...
    def __ne__(self, other_msg) -> bool: ...
    def __hash__(self) -> int: ...
    def __unicode__(self): ...
    def __contains__(self, field_name_or_key) -> bool: ...
    def MergeFrom(self, other_msg): ...
    def CopyFrom(self, other_msg): ...
    def Clear(self): ...
    def SetInParent(self): ...
    def IsInitialized(self): ...
    def MergeFromString(self, serialized): ...
    def ParseFromString(self, serialized): ...
    def SerializeToString(self, **kwargs): ...
    def SerializePartialToString(self, **kwargs): ...
    def ListFields(self): ...
    def HasField(self, field_name): ...
    def ClearField(self, field_name): ...
    def WhichOneof(self, oneof_group): ...
    def HasExtension(self, field_descriptor): ...
    def ClearExtension(self, field_descriptor): ...
    def UnknownFields(self): ...
    def DiscardUnknownFields(self): ...
    def ByteSize(self): ...
    @classmethod
    def FromString(cls, s): ...
    def __reduce__(self): ...
