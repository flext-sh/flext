from _typeshed import Incomplete

class _WrapperBase:
    def __init__(self, obj, method, cache, key, lock: Incomplete | None = ..., cond: Incomplete | None = ...) -> None: ...
    def __call__(self, *args, **kwargs): ...
    def cache_clear(self): ...
    @property
    def cache(self): ...
    @property
    def cache_key(self): ...
    @property
    def cache_lock(self): ...
    @property
    def cache_condition(self): ...

class _DescriptorBase:
    def __init__(self, deprecated: bool = ...) -> None: ...
    def __set_name__(self, owner, name): ...
    def __get__(self, obj, objtype: Incomplete | None = ...): ...

class _DeprecatedDescriptorBase(_DescriptorBase):
    def __init__(self, wrapper, cache_clear) -> None: ...
    def __call__(self, *args, **kwargs): ...
    def cache_clear(self, objtype): ...
