from typing import ClassVar, RenderResult

import rich.jupyter
from rich.console import Console, ConsoleOptions
from rich.measure import Measurement

class Tree(rich.jupyter.JupyterMixin):
    ASCII_GUIDES: ClassVar[tuple] = ...
    TREE_GUIDES: ClassVar[list] = ...
    def __init__(self, label, *, style=..., guide_style=..., expanded: bool = ..., highlight: bool = ..., hide_root: bool = ...) -> None: ...
    def add(self, label, *, style=..., guide_style=..., expanded: bool = ..., highlight=...) -> Tree: ...
    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult: ...
    def __rich_measure__(self, console: Console, options: ConsoleOptions) -> Measurement: ...
