import rich.jupyter

class Status(rich.jupyter.JupyterMixin):
    def __init__(self, status, *, console=..., spinner: str = ..., spinner_style=..., speed: float = ..., refresh_per_second: float = ...) -> None: ...
    def update(self, status=..., *, spinner=..., spinner_style=..., speed=...) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...
    def __rich__(self): ...
    def __enter__(self) -> Status: ...
    def __exit__(self, exc_type, exc_val, exc_tb) -> None: ...
    @property
    def renderable(self): ...
    @property
    def console(self): ...
