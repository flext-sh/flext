from click import Parameter
from click import Context
from typing import ClassVar

import cabc
import t
from _typeshed import Incomplete

class ClickException(Exception):
    exit_code: ClassVar[int] = ...
    def __init__(self, message: str) -> None: ...
    def format_message(self) -> str: ...
    def show(self, file: t.IO[t.Any] | None = ...) -> None: ...

class UsageError(ClickException):
    exit_code: ClassVar[int] = ...
    def __init__(self, message: str, ctx: Context | None = ...) -> None: ...
    def show(self, file: t.IO[t.Any] | None = ...) -> None: ...

class BadParameter(UsageError):
    def __init__(self, message: str, ctx: Context | None = ..., param: Parameter | None = ..., param_hint: cabc.Sequence[str] | str | None = ...) -> None: ...
    def format_message(self) -> str: ...

class MissingParameter(BadParameter):
    def __init__(self, message: str | None = ..., ctx: Context | None = ..., param: Parameter | None = ..., param_hint: cabc.Sequence[str] | str | None = ..., param_type: str | None = ...) -> None: ...
    def format_message(self) -> str: ...

class NoSuchOption(UsageError):
    def __init__(self, option_name: str, message: str | None = ..., possibilities: cabc.Sequence[str] | None = ..., ctx: Context | None = ...) -> None: ...
    def format_message(self) -> str: ...

class BadOptionUsage(UsageError):
    def __init__(self, option_name: str, message: str, ctx: Context | None = ...) -> None: ...

class BadArgumentUsage(UsageError): ...

class NoArgsIsHelpError(UsageError):
    def __init__(self, ctx: Context) -> None: ...
    def show(self, file: t.IO[t.Any] | None = ...) -> None: ...

class FileError(ClickException):
    def __init__(self, filename: str, hint: str | None = ...) -> None: ...
    def format_message(self) -> str: ...

class Abort(RuntimeError): ...

class Exit(RuntimeError):
    exit_code: Incomplete
    def __init__(self, code: int = ...) -> None: ...
