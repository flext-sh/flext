import typing
from typing import Awaitable, ClassVar

__all__ = ['Empty', 'Full', 'Queue']

class Empty(Exception): ...
class Full(Exception): ...

class QueueCommon(typing.Generic):
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    def __init__(self, maxsize: int = ..., use_lifo: bool = ...) -> None: ...
    def empty(self) -> bool: ...
    def full(self) -> bool: ...
    def qsize(self) -> int: ...
    def put_nowait(self, item: _T) -> None: ...
    def put(self, item: _T, block: bool = ..., timeout: float | None = ...) -> None: ...
    def get_nowait(self) -> _T: ...
    def get(self, block: bool = ..., timeout: float | None = ...) -> _T: ...

class Queue(QueueCommon):
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    def __init__(self, maxsize: int = ..., use_lifo: bool = ...) -> None: ...
    def qsize(self) -> int: ...
    def empty(self) -> bool: ...
    def full(self) -> bool: ...
    def put(self, item: _T, block: bool = ..., timeout: float | None = ...) -> None: ...
    def put_nowait(self, item: _T) -> None: ...
    def get(self, block: bool = ..., timeout: float | None = ...) -> _T: ...
    def get_nowait(self) -> _T: ...

class AsyncAdaptedQueue(QueueCommon):
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    @staticmethod
    def await_(awaitable: Awaitable[_T]) -> _T: ...
    def __init__(self, maxsize: int = ..., use_lifo: bool = ...) -> None: ...
    def empty(self) -> bool: ...
    def full(self): ...
    def qsize(self): ...
    def put_nowait(self, item: _T) -> None: ...
    def put(self, item: _T, block: bool = ..., timeout: float | None = ...) -> None: ...
    def get_nowait(self) -> _T: ...
    def get(self, block: bool = ..., timeout: float | None = ...) -> _T: ...

class FallbackAsyncAdaptedQueue(AsyncAdaptedQueue):
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    @staticmethod
    def await_(awaitable: Awaitable[_T]) -> _T: ...
