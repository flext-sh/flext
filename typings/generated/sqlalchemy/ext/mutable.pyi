    def pop(self, *arg): ...
    def popitem(self) -> tuple[_KT, _VT]: ...
    def clear(self) -> None: ...
    @classmethod
    def coerce(cls, key: str, value: Any) -> MutableDict[_KT, _VT] | None: ...

