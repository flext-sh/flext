from typing import Any, ClassVar

import sqlalchemy.pool.base
import sqlalchemy.util.queue
from _typeshed import Incomplete
from sqlalchemy.pool.base import (
    PoolProxiedConnection,
    _CreatorFnType,
    _CreatorWRecFnType,
)

TYPE_CHECKING: bool

class QueuePool(sqlalchemy.pool.base.Pool):
    _is_asyncio: ClassVar[bool] = ...
    _queue_class: ClassVar[type[sqlalchemy.util.queue.Queue]] = ...
    def __init__(self, creator: _CreatorFnType | _CreatorWRecFnType, pool_size: int = ..., max_overflow: int = ..., timeout: float = ..., use_lifo: bool = ..., **kw: Any) -> None: ...
    def recreate(self) -> QueuePool: ...
    def dispose(self) -> None: ...
    def status(self) -> str: ...
    def size(self) -> int: ...
    def timeout(self) -> float: ...
    def checkedin(self) -> int: ...
    def overflow(self) -> int: ...
    def checkedout(self) -> int: ...

class AsyncAdaptedQueuePool(QueuePool):
    _is_asyncio: ClassVar[bool] = ...
    _queue_class: ClassVar[type[sqlalchemy.util.queue.AsyncAdaptedQueue]] = ...
    _dialect: ClassVar[sqlalchemy.pool.base._AsyncConnDialect] = ...

class FallbackAsyncAdaptedQueuePool(AsyncAdaptedQueuePool):
    _queue_class: ClassVar[type[sqlalchemy.util.queue.FallbackAsyncAdaptedQueue]] = ...

class NullPool(sqlalchemy.pool.base.Pool):
    def status(self) -> str: ...
    def recreate(self) -> NullPool: ...
    def dispose(self) -> None: ...

class SingletonThreadPool(sqlalchemy.pool.base.Pool):
    _is_asyncio: ClassVar[bool] = ...
    def __init__(self, creator: _CreatorFnType | _CreatorWRecFnType, pool_size: int = ..., **kw: Any) -> None: ...
    def recreate(self) -> SingletonThreadPool: ...
    def dispose(self) -> None: ...
    def status(self) -> str: ...
    def connect(self) -> PoolProxiedConnection: ...

class StaticPool(sqlalchemy.pool.base.Pool):
    connection: Incomplete
    def status(self) -> str: ...
    def dispose(self) -> None: ...
    def recreate(self) -> StaticPool: ...

class AssertionPool(sqlalchemy.pool.base.Pool):
    def __init__(self, *args: Any, **kw: Any) -> None: ...
    def status(self) -> str: ...
    def dispose(self) -> None: ...
    def recreate(self) -> AssertionPool: ...
