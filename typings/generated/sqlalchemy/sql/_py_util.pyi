import typing
from typing import Any, ClassVar

class prefix_anon_map(dict, typing.Generic):
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    def __missing__(self, key: str) -> str: ...

class cache_anon_map(dict, typing.Generic):
    _index: ClassVar[int] = ...
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    def get_anon(self, object_: Any) -> tuple[str, bool]: ...
    def __missing__(self, key: int) -> str: ...
