    @classmethod
    def __subclasshook__(cls, other): ...
    def __init__(self, *args, **kwargs) -> None: ...

class Operators:
    def __and__(self, other: Any) -> Operators: ...
    def __or__(self, other: Any) -> Operators: ...
    def __invert__(self) -> Operators: ...
    def op(self, opstring: str, precedence: int = ..., is_comparison: bool = ..., return_type: type[TypeEngine[Any]] | TypeEngine[Any] | None = ..., python_impl: Callable[..., Any] | None = ...) -> Callable[[Any], Operators]: ...
    def bool_op(self, opstring: str, precedence: int = ..., python_impl: Callable[..., Any] | None = ...) -> Callable[[Any], Operators]: ...
    def operate(self, op: OperatorType, *other: Any, **kwargs: Any) -> Operators: ...
    def __sa_operate__(self, op: OperatorType, *other: Any, **kwargs: Any) -> Operators: ...
    def reverse_operate(self, op: OperatorType, other: Any, **kwargs: Any) -> Operators: ...

