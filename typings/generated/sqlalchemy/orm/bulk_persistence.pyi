class ORMDMLState(sqlalchemy.orm.context.AbstractORMCompileState):
    is_dml_returning: ClassVar[bool] = ...
    from_statement_ctx: ClassVar[None] = ...
    @classmethod
    def get_entity_description(cls, statement): ...
    @classmethod
    def get_returning_column_descriptions(cls, statement): ...

class BulkUDCompileState(ORMDMLState):
    class default_update_options(sqlalchemy.sql.base.Options):
        _dml_strategy: ClassVar[str] = ...
        _synchronize_session: ClassVar[str] = ...
        _can_use_returning: ClassVar[bool] = ...
        _is_delete_using: ClassVar[bool] = ...
        _is_update_from: ClassVar[bool] = ...
        _autoflush: ClassVar[bool] = ...
        _subject_mapper: ClassVar[None] = ...
        _resolved_values: ClassVar[sqlalchemy.cyextension.immutabledict.immutabledict] = ...
        _eval_condition: ClassVar[None] = ...
        _matched_rows: ClassVar[None] = ...
        _identity_token: ClassVar[None] = ...
        _populate_existing: ClassVar[bool] = ...
        _cache_attrs: ClassVar[tuple] = ...
    @classmethod
    def can_use_returning(cls, dialect: Dialect, mapper: Mapper[Any], *, is_multitable: bool = ..., is_update_from: bool = ..., is_delete_using: bool = ..., is_executemany: bool = ...) -> bool: ...
    @classmethod
    def orm_pre_session_exec(cls, session, statement, params, execution_options, bind_arguments, is_pre_event): ...
    @classmethod
    def orm_setup_cursor_result(cls, session, statement, params, execution_options, bind_arguments, result): ...

