from typing import Any, ClassVar, Self, _DMLTableArgument, _UpdateArg

import sqlalchemy.sql.dml
import sqlalchemy.sql.elements
from _typeshed import Incomplete
from sqlalchemy.sql.selectable import NamedFromClause

__all__ = ['Insert', 'insert']

def insert(table: _DMLTableArgument) -> Insert: ...

class Insert(sqlalchemy.sql.dml.Insert):
    stringify_dialect: ClassVar[str] = ...
    inherit_cache: ClassVar[bool] = ...
    inserted_alias: Incomplete
    def on_duplicate_key_update(self, *args: _UpdateArg, **kw: Any) -> Self: ...
    @property
    def inserted(self): ...

class OnDuplicateClause(sqlalchemy.sql.elements.ClauseElement):
    __visit_name__: ClassVar[str] = ...
    _parameter_ordering: ClassVar[None] = ...
    stringify_dialect: ClassVar[str] = ...
    def __init__(self, inserted_alias: NamedFromClause, update: _UpdateArg) -> None: ...
