import sqlalchemy.dialects.mysql.base
import sqlalchemy.sql.sqltypes as sqltypes
import sqlalchemy.sql.type_api
from typing import Any, ClassVar

class INET4(sqlalchemy.sql.type_api.TypeEngine):
    __visit_name__: ClassVar[str] = ...
    __parameters__: ClassVar[tuple] = ...

class INET6(sqlalchemy.sql.type_api.TypeEngine):
    __visit_name__: ClassVar[str] = ...
    __parameters__: ClassVar[tuple] = ...

class MariaDBTypeCompiler(sqlalchemy.dialects.mysql.base.MySQLTypeCompiler):
    def visit_INET4(self, type_: INET4, **kwargs: Any) -> str: ...
    def visit_INET6(self, type_: INET6, **kwargs: Any) -> str: ...

class MariaDBDialect(sqlalchemy.dialects.mysql.base.MySQLDialect):
    class type_compiler_cls(sqlalchemy.dialects.mysql.base.MySQLTypeCompiler):
        def visit_INET4(self, type_: INET4, **kwargs: Any) -> str: ...
        def visit_INET6(self, type_: INET6, **kwargs: Any) -> str: ...
    is_mariadb: ClassVar[bool] = ...
    supports_statement_cache: ClassVar[bool] = ...
    name: ClassVar[str] = ...
    preparer: ClassVar[type[sqlalchemy.dialects.mysql.base.MariaDBIdentifierPreparer]] = ...
def loader(driver: str) -> type[MariaDBDialect]: ...
