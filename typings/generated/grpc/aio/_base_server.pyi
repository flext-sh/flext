import _abc
import abc
import typing
from typing import ClassVar

import grpc as grpc
import grpc.aio._typing

class Server(abc.ABC):
    __abstractmethods__: ClassVar[frozenset] = ...
    _abc_impl: ClassVar[_abc._abc_data] = ...
    def add_generic_rpc_handlers(self, generic_rpc_handlers: typing.Sequence) -> None: ...
    def add_insecure_port(self, address: str) -> int: ...
    def add_secure_port(self, address: str, server_credentials: grpc.ServerCredentials) -> int: ...
    def start(self) -> None: ...
    def stop(self, grace) -> None: ...
    def wait_for_termination(self, timeout=...) -> bool: ...
    def add_registered_method_handlers(self, service_name, method_handlers): ...

class ServicerContext(typing.Generic, abc.ABC):
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    __abstractmethods__: ClassVar[frozenset] = ...
    _abc_impl: ClassVar[_abc._abc_data] = ...
    def read(self) -> grpc.aio._typing.RequestType: ...
    def write(self, message: grpc.aio._typing.ResponseType) -> None: ...
    def send_initial_metadata(self, initial_metadata) -> None: ...
    def abort(self, code: grpc.StatusCode, details: str = ..., trailing_metadata=...) -> typing.NoReturn: ...
    def set_trailing_metadata(self, trailing_metadata) -> None: ...
    def invocation_metadata(self): ...
    def set_code(self, code: grpc.StatusCode) -> None: ...
    def set_details(self, details: str) -> None: ...
    def set_compression(self, compression: grpc.Compression) -> None: ...
    def disable_next_message_compression(self) -> None: ...
    def peer(self) -> str: ...
    def peer_identities(self): ...
    def peer_identity_key(self): ...
    def auth_context(self) -> typing.Mapping: ...
    def time_remaining(self) -> float: ...
    def trailing_metadata(self): ...
    def code(self): ...
    def details(self): ...
    def add_done_callback(self, callback: typing.Callable) -> None: ...
    def cancelled(self) -> bool: ...
    def done(self) -> bool: ...
