import _abc
import abc
import typing
from typing import ClassVar

import grpc as grpc
import grpc.aio._base_call
import grpc.aio._typing

class UnaryUnaryMultiCallable(typing.Generic, abc.ABC):
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    __abstractmethods__: ClassVar[frozenset] = ...
    _abc_impl: ClassVar[_abc._abc_data] = ...
    def __call__(self, request: grpc.aio._typing.RequestType, *, timeout=..., metadata=..., credentials=..., wait_for_ready=..., compression=...) -> grpc.aio._base_call.UnaryUnaryCall: ...

class UnaryStreamMultiCallable(typing.Generic, abc.ABC):
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    __abstractmethods__: ClassVar[frozenset] = ...
    _abc_impl: ClassVar[_abc._abc_data] = ...
    def __call__(self, request: grpc.aio._typing.RequestType, *, timeout=..., metadata=..., credentials=..., wait_for_ready=..., compression=...) -> grpc.aio._base_call.UnaryStreamCall: ...

class StreamUnaryMultiCallable(abc.ABC):
    __abstractmethods__: ClassVar[frozenset] = ...
    _abc_impl: ClassVar[_abc._abc_data] = ...
    def __call__(self, request_iterator=..., timeout=..., metadata=..., credentials=..., wait_for_ready=..., compression=...) -> grpc.aio._base_call.StreamUnaryCall: ...

class StreamStreamMultiCallable(abc.ABC):
    __abstractmethods__: ClassVar[frozenset] = ...
    _abc_impl: ClassVar[_abc._abc_data] = ...
    def __call__(self, request_iterator=..., timeout=..., metadata=..., credentials=..., wait_for_ready=..., compression=...) -> grpc.aio._base_call.StreamStreamCall: ...

class Channel(abc.ABC):
    __abstractmethods__: ClassVar[frozenset] = ...
    _abc_impl: ClassVar[_abc._abc_data] = ...
    def __aenter__(self): ...
    def __aexit__(self, exc_type, exc_val, exc_tb): ...
    def close(self, grace=...): ...
    def get_state(self, try_to_connect: bool = ...) -> grpc.ChannelConnectivity: ...
    def wait_for_state_change(self, last_observed_state: grpc.ChannelConnectivity) -> None: ...
    def channel_ready(self) -> None: ...
    def unary_unary(self, method: str, request_serializer=..., response_deserializer=..., _registered_method=...) -> UnaryUnaryMultiCallable: ...
    def unary_stream(self, method: str, request_serializer=..., response_deserializer=..., _registered_method=...) -> UnaryStreamMultiCallable: ...
    def stream_unary(self, method: str, request_serializer=..., response_deserializer=..., _registered_method=...) -> StreamUnaryMultiCallable: ...
    def stream_stream(self, method: str, request_serializer=..., response_deserializer=..., _registered_method=...) -> StreamStreamMultiCallable: ...
