import _abc
import typing
from collections.abc import Generator
from typing import Any, ChannelArgumentType, ClassVar

import _channel

__conditional_annotations__: set
ClientCallTracerCapsule: typing.TypeVar
ServerCallTracerFactoryCapsule: typing.TypeVar

class ServerCallTracerFactory:
    def __init__(self, address) -> None: ...
    def __int__(self) -> int: ...

class ObservabilityPlugin(typing.Generic):
    _tracing_enabled: ClassVar[bool] = ...
    _stats_enabled: ClassVar[bool] = ...
    __orig_bases__: ClassVar[tuple] = ...
    __parameters__: ClassVar[tuple] = ...
    __abstractmethods__: ClassVar[frozenset] = ...
    _abc_impl: ClassVar[_abc._abc_data] = ...
    def create_client_call_tracer(self, method_name: bytes, target: bytes) -> ClientCallTracerCapsule: ...
    def save_trace_context(self, trace_id: str, span_id: str, is_sampled: bool) -> None: ...
    def create_server_call_tracer_factory(self, *, xds: bool = ...) -> ServerCallTracerFactoryCapsule | None: ...
    def record_rpc_latency(self, method: str, target: str, rpc_latency: float, status_code: Any) -> None: ...
    def set_tracing(self, enable: bool) -> None: ...
    def set_stats(self, enable: bool) -> None: ...
    def save_registered_method(self, method_name: bytes) -> None: ...
    @property
    def tracing_enabled(self): ...
    @property
    def stats_enabled(self): ...
    @property
    def observability_enabled(self): ...
def get_plugin(*args, **kwds) -> Generator[ObservabilityPlugin | None]: ...
def set_plugin(observability_plugin: ObservabilityPlugin | None) -> None: ...
def observability_init(observability_plugin: ObservabilityPlugin) -> None: ...
def observability_deinit() -> None: ...
def maybe_record_rpc_latency(state: _channel._RPCState) -> None: ...
def create_server_call_tracer_factory_option(xds: bool) -> tuple[ChannelArgumentType] | tuple[()]: ...
