analyze-projects: ## Analyze all projects for orchestration planning
	$(call log_section,Analyzing Projects for Orchestration)
	@echo "$(BOLD)Project Analysis Summary:$(RESET)"
	@echo ""
	@for project in $(ACTIVE_PROJECTS); do \
		if [ -d "$$project" ]; then \
			project_type=$$($(call detect_project_type,$$project)); \
			templates=$$($(call get_project_templates,$$project_type)); \
			capabilities=$$($(call check_project_capabilities,$$project)); \
			has_makefile="No"; \
			makefile_type="None"; \
			if [ -f "$$project/Makefile" ]; then \
				has_makefile="Yes"; \
				if grep -q "Generated by FLEXT Orchestrator" "$$project/Makefile" 2>/dev/null; then \
					makefile_type="Orchestrated"; \
				else \
					makefile_type="Custom"; \
				fi; \
			fi; \
			echo "$(CYAN)$$project$(RESET):"; \
			echo "  Type: $$project_type"; \
			echo "  Templates: $$templates"; \
			echo "  Capabilities: $$capabilities"; \
			echo "  Makefile: $$has_makefile ($$makefile_type)"; \
			echo ""; \
		fi; \
	done

analyze-project: ## Analyze specific project
	@if [ -z "$(PROJECT)" ]; then \
		echo "$(RED)Error: PROJECT variable required$(RESET)"; \
		exit 1; \
	fi
	@echo "$(BOLD)$(CYAN)🔍 Analyzing Project: $(PROJECT)$(RESET)"
	@if [ -d "$(PROJECT)" ]; then \
		echo "Project: $(BOLD)$(PROJECT)$(RESET)"; \
		echo "Directory: $$(pwd)/$(PROJECT)"; \
		echo ""; \
		echo "$(BOLD)Detection Results:$(RESET)"; \
		if echo "$(PROJECT)" | grep -E '^flext-(core|auth|plugin|observability|quality)$$' >/dev/null; then \
			project_type="core"; \
		elif echo "$(PROJECT)" | grep -E '^flext-(api|web|grpc)$$' >/dev/null; then \
			project_type="service"; \
		elif echo "$(PROJECT)" | grep -E '^flext-cli$$' >/dev/null; then \
			project_type="cli"; \
		elif echo "$(PROJECT)" | grep -E '^flext-(tap|target|dbt)-.*$$' >/dev/null; then \
			project_type="singer"; \
		elif echo "$(PROJECT)" | grep -E '^(algar|gruponos)-.*$$' >/dev/null; then \
			project_type="client"; \
		elif echo "$(PROJECT)" | grep -E '^flx-.*$$' >/dev/null; then \
			project_type="legacy"; \
		else \
			project_type="python"; \
		fi; \
		echo "  Type: $$project_type"; \
		if [ "$$project_type" = "core" ]; then \
			templates="base/common.mk python/python.mk"; \
		elif [ "$$project_type" = "service" ]; then \
			templates="base/common.mk python/python.mk service/service.mk"; \
		elif [ "$$project_type" = "cli" ]; then \
			templates="base/common.mk python/python.mk"; \
		elif [ "$$project_type" = "singer" ]; then \
			templates="base/common.mk python/python.mk singer/singer.mk"; \
		elif [ "$$project_type" = "client" ]; then \
			templates="base/common.mk python/python.mk"; \
		elif [ "$$project_type" = "legacy" ]; then \
			templates="base/common.mk"; \
		else \
			templates="base/common.mk python/python.mk"; \
		fi; \
		echo "  Required Templates: $$templates"; \
		capabilities=""; \
		if [ -f "$(PROJECT)/manage.py" ]; then capabilities="$$capabilities django"; fi; \
		if grep -q "FastAPI\|fastapi" "$(PROJECT)"/*.py "$(PROJECT)"/src/*/*.py 2>/dev/null; then capabilities="$$capabilities fastapi"; fi; \
		if grep -q "Flask\|flask" "$(PROJECT)"/*.py "$(PROJECT)"/src/*/*.py 2>/dev/null; then capabilities="$$capabilities flask"; fi; \
		if [ -f "$(PROJECT)/Dockerfile" ]; then capabilities="$$capabilities docker"; fi; \
		if [ -f "$(PROJECT)/docker-compose.yml" ]; then capabilities="$$capabilities compose"; fi; \
		echo "  Detected Capabilities:$$capabilities"; \
		echo ""; \
		echo "$(BOLD)Template Details:$(RESET)"; \
		for template in $$templates; do \
			if [ -f "$(TEMPLATES_DIR)/$$template" ]; then \
				echo "  $(GREEN)✓$(RESET) $$template"; \
			else \
				echo "  $(RED)✗$(RESET) $$template (missing)"; \
			fi; \
		done; \
		echo ""; \
		if [ -f "$(PROJECT)/Makefile" ]; then \
			echo "$(BOLD)Current Makefile:$(RESET)"; \
			if grep -q "Generated by FLEXT Orchestrator" "$(PROJECT)/Makefile" 2>/dev/null; then \
				echo "  $(GREEN)✓$(RESET) Orchestrated (managed)"; \
			else \
				echo "  $(YELLOW)⚠$(RESET) Custom (will be backed up)"; \
			fi; \
		else \
			echo "$(BOLD)Current Makefile:$(RESET)"; \
			echo "  $(RED)✗$(RESET) Missing"; \
		fi; \
	else \
		echo "$(RED)Error: Project directory not found: $(PROJECT)$(RESET)"; \
		exit 1; \
	fi

# ═══════════════════════════════════════════════════════════════════════════
#  TEMPLATE MANAGEMENT TARGETS
# ═══════════════════════════════════════════════════════════════════════════

validate-templates: ## Validate all template files
	$(call log_section,Validating Template Files)
	@template_errors=0; \
	for template in $(BASE_TEMPLATES) $(PYTHON_TEMPLATES) $(SERVICE_TEMPLATES) $(SINGER_TEMPLATES); do \
		template_path="$(TEMPLATES_DIR)/$$template"; \
		if [ -f "$$template_path" ]; then \
			$(call log_info,Validating $$template); \
			if $(MAKE) -f "$$template_path" --dry-run help >/dev/null 2>&1; then \
				echo "  $(GREEN)✓$(RESET) $$template"; \
			else \
				echo "  $(RED)✗$(RESET) $$template (syntax error)"; \
				template_errors=$$((template_errors + 1)); \
			fi; \
		else \
			echo "  $(RED)✗$(RESET) $$template (missing)"; \
			template_errors=$$((template_errors + 1)); \
		fi; \
	done; \
	if [ $$template_errors -eq 0 ]; then \
		$(call log_success,All templates are valid); \
	else \
		$(call log_error,$$template_errors template(s) have issues); \
		exit 1; \
	fi

list-templates: ## List all available templates
	$(call log_section,Available Templates)
	@echo "$(BOLD)Base Templates:$(RESET)"
	@for template in $(BASE_TEMPLATES); do echo "  - $$template"; done
	@echo ""
	@echo "$(BOLD)Python Templates:$(RESET)"
	@for template in $(PYTHON_TEMPLATES); do echo "  - $$template"; done
	@echo ""
	@echo "$(BOLD)Service Templates:$(RESET)"
	@for template in $(SERVICE_TEMPLATES); do echo "  - $$template"; done
	@echo ""
	@echo "$(BOLD)Singer Templates:$(RESET)"
	@for template in $(SINGER_TEMPLATES); do echo "  - $$template"; done

# ═══════════════════════════════════════════════════════════════════════════
#  MAINTENANCE TARGETS
# ═══════════════════════════════════════════════════════════════════════════

update-orchestrated: ## Update all orchestrated Makefiles
	$(call log_section,Updating Orchestrated Makefiles)
	@updated_count=0; \
	for project in $(ACTIVE_PROJECTS); do \
		if [ -f "$$project/Makefile" ] && grep -q "Generated by FLEXT Orchestrator" "$$project/Makefile" 2>/dev/null; then \
			$(call log_info,Updating $$project); \
			if $(MAKE) orchestrate-project PROJECT=$$project; then \
				updated_count=$$((updated_count + 1)); \
			fi; \
		fi; \
	done; \
	$(call log_success,Updated $$updated_count orchestrated Makefiles)

clean-backups: ## Clean old Makefile backups
	$(call log_section,Cleaning Makefile Backups)
	@backup_count=0; \
	find . -name "Makefile.backup.*" -type f | while read backup; do \
		$(call log_info,Removing $$backup); \
		rm -f "$$backup"; \
		backup_count=$$((backup_count + 1)); \
	done; \
	$(call log_success,Removed backup files)

# ═══════════════════════════════════════════════════════════════════════════
