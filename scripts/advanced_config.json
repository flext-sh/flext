{
  "wms": {
    "base_path": "/home/marlonsc/pyauto/dc-oracle-wms",
    "timeout": 600,
    "max_retries": 3,
    "batch_size_days": 1,
    "default_format": "json"
  },
  "oracle": {
    "base_path": "/home/marlonsc/pyauto/dc-oracle-db",
    "timeout": 900,
    "batch_size": 1000,
    "merge_batch_size": 100,
    "auto_commit": true
  },
  "pipeline": {
    "temp_dir": "/tmp/wms_oracle_advanced",
    "cleanup_temp": true,
    "validate_data": true,
    "use_merge": true,
    "track_changes": true,
    "log_level": "INFO"
  },
  "schemas": {
    "order_hdr": {
      "table": "ORDER_HDR",
      "primary_keys": ["order_id"],
      "date_field": "order_date",
      "track_fields": ["status", "customer_id", "total_amount", "order_type", "priority"],
      "timestamp_field": "tk_insert_dt",
      "default_fields": "order_id,order_date,status,customer_id,total_amount,order_type,priority,created_date,modified_date"
    },
    "order_dtl": {
      "table": "ORDER_DTL",
      "primary_keys": ["order_id", "line_number"],
      "date_field": "order_date",
      "track_fields": ["item_id", "quantity", "unit_price", "status"],
      "timestamp_field": "tk_insert_dt"
    }
  },
  "test_scenarios": {
    "order_hdr_incremental": {
      "resource": "order_hdr",
      "days_back": 3,
      "limit": 100,
      "description": "Teste incremental ORDER_HDR últimos 3 dias"
    },
    "order_hdr_full": {
      "resource": "order_hdr",
      "days_back": 7,
      "limit": 500,
      "description": "Teste completo ORDER_HDR última semana"
    }
  }
} 
