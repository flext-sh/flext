# Quality Scripts (migrated to flext-quality)
scripts-quality: ## Execute quality checks using flext-quality operations
	@python - <<'PY'
from flext_quality.tools import FlextQualityOperations
ops = FlextQualityOperations()
ops.gateway.run_all_checks(".")
ops.linting.run_lint(".")
ops.duplicates.detect_duplicates(".")
PY

script-audit-false-positives: ## Audita falsos positivos com flext-quality
	@python - <<'PY'
from flext_quality.tools import FlextQualityOperations
ops = FlextQualityOperations()
result = ops.audit.audit_false_positives([{"id": 1, "false_positive": False}])
print(result.value if result.is_success else result.error)
PY

script-linting-report: ## Relatório de lint usando flext-quality
	@python - <<'PY'
from flext_quality.tools import FlextQualityOperations
ops = FlextQualityOperations()
result = ops.linting.run_lint(".")
print(result.value if result.is_success else result.error)
PY

script-quality-gateway: ## Gateway de qualidade enterprise com flext-quality
	@python -m flext_quality.cli analyze .

script-quality-gateway-old: ## Alias para o novo gateway
	@python -m flext_quality.cli analyze .

script-code-duplicates: ## Detectar duplicações com flext-quality
	@python - <<'PY'
from flext_quality.tools import FlextQualityOperations
ops = FlextQualityOperations()
result = ops.duplicates.detect_duplicates(".", threshold=10)
print(result.value if result.is_success else result.error)
PY

