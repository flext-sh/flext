#!/bin/bash
# FLEXT Constants Environment Variables
# Source this file to get standard FLEXT constants as environment variables
# IMPORTANT: This file is auto-generated from FlextConstants to ensure single source of truth
# Usage: source scripts/constants.env
# To regenerate: python scripts/generate_constants_env.py

# FLEXT Platform Constants (from FlextConstants.Platform)
FLEXT_API_PORT="8000  # FlextConstants.Platform.FLEXT_API_PORT"
export FLEXT_DEFAULT_HOST="localhost"  # FlextConstants.Platform.DEFAULT_HOST

# Database Constants (from FlextConstants.Platform)
export FLEXT_REDIS_PORT=6379  # FlextConstants.Platform.REDIS_DEFAULT_PORT
export FLEXT_POSTGRES_PORT=5432  # FlextConstants.Platform.POSTGRES_DEFAULT_PORT
export FLEXT_MYSQL_PORT=3306  # FlextConstants.Platform.MYSQL_DEFAULT_PORT
export FLEXT_MONGODB_PORT=27017  # FlextConstants.Platform.MONGODB_DEFAULT_PORT

# LDAP Constants (from FlextConstants.Platform)
export FLEXT_LDAP_PORT=389  # FlextConstants.Platform.LDAP_DEFAULT_PORT
export FLEXT_LDAPS_PORT=636  # FlextConstants.Platform.LDAPS_DEFAULT_PORT
export FLEXT_LDAP_TEST_PORT=3390  # Custom test port (no FlextConstants equivalent)

# Network Constants (from FlextConstants.Network)
export FLEXT_DEFAULT_TIMEOUT=30  # FlextConstants.Network.DEFAULT_TIMEOUT
export FLEXT_MIN_PORT=1  # FlextConstants.Network.MIN_PORT
export FLEXT_MAX_PORT=65535  # FlextConstants.Network.MAX_PORT

# Monitoring & Observability (custom values for monitoring tools)
export FLEXT_PROMETHEUS_PORT=9090  # Standard Prometheus port
export FLEXT_GRAFANA_PORT=3000  # Standard Grafana port

# Docker Testing Ports (test-specific configurations)
export FLEXT_TEST_API_PORT=8081  # Test API port (offset from main API port)
export FLEXT_TEST_WEB_PORT=8080  # FlextConstants.Platform.DEFAULT_HTTP_PORT

# Performance Testing Constants (from FlextConstants)
export FLEXT_PERFORMANCE_CRITICAL_MS=5000  # FlextConstants.Performance.CRITICAL_DURATION_MS
export FLEXT_CRITICAL_USAGE_PERCENT=90  # FlextConstants.Performance.CRITICAL_USAGE_PERCENT
export FLEXT_MIN_SUCCESS_RATE=95  # Business requirement - 95% minimum success rate
export FLEXT_MAX_MEMORY_MB=500  # Test environment limit - 500MB max memory

# URLs for testing scripts (composed from FlextConstants values)
export FLEXT_TEST_SERVER_URL="http://${FLEXT_DEFAULT_HOST}:${FLEXT_TEST_API_PORT}"
FLEXT_DEFAULT_HTTP_PORT="8080  # FlextConstants.Platform.DEFAULT_HTTP_PORT"
FLEXT_WEB_PORT="8080  # FlextConstants.Platform.DEFAULT_HTTP_PORT"
export FLEXT_REDIS_ADDRESS="${FLEXT_DEFAULT_HOST}:${FLEXT_REDIS_PORT}" # Unordered because FLEXT_REDIS_ADDRESS uses FLEXT_DEFAULT_HOST

ECHO__FLEXT_CONSTANTS_ENVIRONMENT_VARIABLES_LOADED__SYNCHRONIZED_WITH_FLEXTCONSTANTS__=
