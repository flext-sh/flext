{
  "wms": {
    "base_path": "/home/marlonsc/pyauto/dc-oracle-wms",
    "timeout": 300,
    "max_retries": 3,
    "default_format": "json",
    "default_limit": 1000
  },
  "oracle": {
    "base_path": "/home/marlonsc/pyauto/dc-oracle-db",
    "timeout": 600,
    "batch_size": 500,
    "auto_commit": true,
    "create_table_if_not_exists": false
  },
  "pipeline": {
    "temp_dir": "/tmp/wms_oracle_pipeline",
    "cleanup_temp": true,
    "validate_data": true,
    "log_level": "INFO",
    "max_parallel_jobs": 1
  },
  "mappings": {
    "orders": {
      "table": "WMS_ORDERS",
      "fields": "order_id,order_date,status,customer_id,total_amount",
      "filters": ["status:ne:CANCELLED"]
    },
    "items": {
      "table": "WMS_ITEMS",
      "fields": "item_id,item_name,category,price,quantity",
      "filters": ["status:eq:ACTIVE"]
    },
    "locations": {
      "table": "WMS_LOCATIONS",
      "fields": "location_id,location_name,warehouse_id,zone,capacity",
      "filters": []
    },
    "inventory": {
      "table": "WMS_INVENTORY",
      "fields": "item_id,location_id,quantity,reserved_quantity,available_quantity",
      "filters": ["quantity:gt:0"]
    }
  },
  "schedules": {
    "daily_orders": {
      "resource": "orders",
      "cron": "0 2 * * *",
      "enabled": false,
      "filters": ["order_date:gte:today-1"]
    },
    "hourly_inventory": {
      "resource": "inventory",
      "cron": "0 * * * *",
      "enabled": false,
      "filters": []
    }
  }
}
