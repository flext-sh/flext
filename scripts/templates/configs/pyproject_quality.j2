# Quality configuration template for pyproject.toml

[tool.ruff]
extend = "../.ruff-shared.toml"
lint.isort.known-first-party = ["{{ pyproject }}"]

[tool.mypy]
python_version = "{{ python_version_for_mypy | default('3.11') }}"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = {{ strict_typing | default(true) | lower }}
disallow_incomplete_defs = {{ strict_typing | default(true) | lower }}
check_untyped_defs = true
disallow_untyped_decorators = {{ strict_typing | default(true) | lower }}
no_implicit_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true
warn_unreachable = true
strict_equality = true
{% if mypy_plugins %}

plugins = [{{ mypy_plugins | map('quote') | join(', ') }}]
{% endif %}

[tool.pytest.ini_options]
minversion = "6.0"
addopts = [
    "--strict-markers",
    "--strict-config",
    "--disable-warnings",
    {% if coverage_enabled | default(true) %}
    "--cov={{ package_name }}",
    "--cov-report=term-missing",
    "--cov-report=html:htmlcov",
    "--cov-fail-under={{ coverage_threshold | default(80) }}",
    {% endif %}
]
testpaths = ["tests"]
{% if test_markers %}

markers = [
    {% for marker, description in test_markers.items() %}
    "{{ marker }}: {{ description }}",
    {% endfor %}
]
{% endif %}

[tool.bandit]
exclude_dirs = ["tests"]
{% if bandit_skips %}
skips = [{{ bandit_skips | map('quote') | join(', ') }}]
{% endif %}
