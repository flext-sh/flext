{
  // ===== PYTHON INTERPRETER & ENVIRONMENT =====
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,

  // ===== PYTHON ANALYSIS CONFIGURATION =====
  "python.analysis.extraPaths": [
    "./src",
    "./tests",
    "./scripts"
  ],
  "python.analysis.exclude": [
    "**/.git/**",
    "**/.pytest_cache/**",
    "**/.venv/**",
    "**/.ruff_cache/**",
    "**/.mypy_cache/**",
    "**/build/**",
    "**/dist/**",
    "**/__pycache__/**",
    "**/node_modules/**",
    "**/.coverage",
    "**/coverage.xml",
    "**/htmlcov/**"
  ],
  "python.analysis.ignore": [],
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.autoSearchPaths": true,
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.indexing": true,
  "python.analysis.packageIndexDepths": [{ "name": "", "depth": 10 }],

  // ===== PYTHON ANALYSIS SEVERITY OVERRIDES =====
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "error",
    "reportMissingModuleSource": "error",
    "reportUndefinedVariable": "error",
    "reportUnusedImports": "warning",
    "reportUnusedVariable": "warning",
    "reportDuplicateImport": "warning",
    "reportUnusedFunction": "information",
    "reportUnusedClass": "information",
    "reportGeneralTypeIssues": "error",
    "reportOptionalMemberAccess": "error",
    "reportOptionalSubscript": "error",
    "reportOptionalOperand": "error",
    "reportTypedDictNotRequiredAccess": "warning",
    "reportPrivateImportUsage": "information",
    "reportConstantRedefinition": "error",
    "reportIncompatibleMethodOverride": "error",
    "reportIncompatibleVariableOverride": "error",
    "reportInconsistentConstructor": "error"
  },

  // ===== PYTHON LANGUAGE SERVER =====
  "python.languageServer": "Pylance",

  // ===== LINTING CONFIGURATION =====
  "python.linting.enabled": true,
  "python.linting.lintOnSave": true,

  // ===== MYPY CONFIGURATION =====
  "python.linting.mypyEnabled": true,
  "python.linting.mypyPath": "${workspaceFolder}/.venv/bin/mypy",
  "python.linting.mypyArgs": [
    "--config-file=pyproject.toml",
    "--strict",
    "--show-error-codes",
    "--show-column-numbers",
    "--show-error-context",
    "--pretty"
  ],

  // ===== RUFF CONFIGURATION (PRIMARY LINTER) =====
  "ruff.enable": true,
  "ruff.nativeServer": true,
  "ruff.path": ["${workspaceFolder}/.venv/bin/ruff"],
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.configuration": "${workspaceFolder}/pyproject.toml",
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  "ruff.showNotifications": "always",
  "ruff.trace.server": "off",

  // ===== BLACK FORMATTER =====
  "black-formatter.enable": true,
  "black-formatter.path": ["${workspaceFolder}/.venv/bin/black"],
  "black-formatter.args": ["--config", "${workspaceFolder}/pyproject.toml"],

  // ===== ISORT CONFIGURATION =====
  "isort.check": true,
  "isort.path": ["${workspaceFolder}/.venv/bin/isort"],
  "isort.args": ["--settings-path=${workspaceFolder}/pyproject.toml"],

  // ===== FORMATTING ON SAVE =====
  "[python]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": false,
    "editor.formatOnPaste": false,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },

  // ===== TESTING CONFIGURATION =====
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestPath": "${workspaceFolder}/.venv/bin/pytest",
  "python.testing.pytestArgs": [
    "tests",
    "-v",
    "--tb=short"
  ],
  "python.testing.autoTestDiscoverOnSaveEnabled": true,

  // ===== EDITOR CONFIGURATION =====
  "editor.renderValidationDecorations": "on",
  "editor.showUnused": true,
  "editor.showDeprecated": true,
  "editor.rulers": [88],
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "editor.detectIndentation": false,

  // ===== PROBLEMS PANEL =====
  "problems.showCurrentInStatus": true,
  "problems.sortOrder": "severity",
  "problems.defaultViewMode": "list",

  // ===== FILE EXCLUSIONS =====
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.coverage": true,
    "**/coverage.xml": true,
    "**/htmlcov": true,
    "**/junit": true,
    "**/build": true,
    "**/dist": true,
    "**/*.egg-info": true
  },

  // ===== SEARCH EXCLUSIONS =====
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "**/build": true,
    "**/dist": true,
    "**/*.egg-info": true,
    "**/coverage.xml": true,
    "**/htmlcov": true
  },

  // ===== TERMINAL CONFIGURATION =====
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/usr/bin/bash",
      "args": []
    }
  },
  "terminal.integrated.env.linux": {
    "SHELL": "/usr/bin/bash",
    "PYTHONPATH": "${workspaceFolder}/src"
  },

  // ===== TOML CONFIGURATION =====
  "evenBetterToml.schema.associations": {
    "**/pyproject.toml": "https://json.schemastore.org/pyproject.json"
  },
  "evenBetterToml.schema.enabled": true,
  "evenBetterToml.formatter.allowedBlankLines": 2,
  "evenBetterToml.formatter.indentTables": true,

  // ===== FILE ASSOCIATIONS =====
  "files.associations": {
    "pyproject.toml": "toml",
    "*.toml": "toml",
    ".pre-commit-config.yaml": "yaml",
    "poetry.lock": "toml"
  },

  // ===== TOML FORMATTING =====
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },

  // ===== YAML CONFIGURATION =====
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // ===== JSON CONFIGURATION =====
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // ===== MARKDOWN CONFIGURATION =====
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on"
  },

  // ===== GIT CONFIGURATION =====
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.rebaseWhenSync": true,

  // ===== AUTO-SAVE =====
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 1000,

  // ===== EXTENSION-SPECIFIC SETTINGS =====

  // SonarLint (if available)
  "sonarlint.connectedMode.project": {
    "connectionId": "{{SONAR_CONNECTION_ID}}",
    "projectKey": "{{SONAR_PROJECT_KEY}}"
  },

  // GitLens
  "gitlens.codeLens.enabled": true,
  "gitlens.blame.compact": false,
  "gitlens.blame.heatmap.enabled": true,

  // Error Lens
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning",
    "info"
  ],

  // ===== WORKSPACE SPECIFIC ENVIRONMENT =====
  "python.envFile": "${workspaceFolder}/.env",

  // ===== INTELLISENSE & AUTOCOMPLETE =====
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },

  // ===== PYTHON-SPECIFIC KEYBINDINGS HINTS =====
  "python.linting.flake8Enabled": false,
  "python.linting.pylintEnabled": false,
  "python.formatting.provider": "none",

  // ===== WORKSPACE TRUST =====
  "security.workspace.trust.untrustedFiles": "prompt"
}
