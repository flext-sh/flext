name: CI/CD Pipeline - {{PROJECT_NAME}}

# Trigger on all important events
on:
  push:
    branches: [main, master, develop, "release/*", "hotfix/*"]
    tags: ["v*"]
  pull_request:
    branches: [main, master, develop]
  workflow_dispatch: # Manual trigger
  schedule:
    - cron: "0 6 * * 1" # Weekly on Monday at 6 AM UTC

# Cancel previous runs for the same PR/branch
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

# Global environment variables
env:
  PYTHON_VERSION: "3.12"
  POETRY_VERSION: "1.8.4"
  POETRY_CACHE_DIR: ~/.cache/pypoetry
  PIP_CACHE_DIR: ~/.cache/pip
  PRE_COMMIT_CACHE: ~/.cache/pre-commit

jobs:
  # ===== SECURITY & DEPENDENCY CHECKS =====
  security-scan:
    name: 🔒 Security & Dependencies
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0 # Full history for better analysis

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          version: ${{ env.POETRY_VERSION }}
          virtualenvs-create: true
          virtualenvs-in-project: true

      - name: Cache Poetry dependencies
        uses: actions/cache@v4
        with:
          path: |
            ${{ env.POETRY_CACHE_DIR }}
            .venv
          key: poetry-${{ runner.os }}-${{ env.PYTHON_VERSION }}-${{ hashFiles('**/poetry.lock') }}
          restore-keys: |
            poetry-${{ runner.os }}-${{ env.PYTHON_VERSION }}-

      - name: Install dependencies
        run: poetry install --with security

      - name: Run Bandit security scan
        run: |
          poetry run bandit -r src/ -f json -o reports/security.json || true
          poetry run bandit -r src/ -f txt

      - name: Run Safety dependency check
        run: poetry run safety check --json || true

      - name: Upload security reports
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: security-reports
          path: reports/

  # ===== CODE QUALITY GATE =====
  quality-gate:
    name: 🚨 Quality Gate (Zero Tolerance)
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          version: ${{ env.POETRY_VERSION }}
          virtualenvs-create: true
          virtualenvs-in-project: true

      - name: Cache Poetry dependencies
        uses: actions/cache@v4
        with:
          path: |
            ${{ env.POETRY_CACHE_DIR }}
            .venv
          key: poetry-${{ runner.os }}-${{ env.PYTHON_VERSION }}-${{ hashFiles('**/poetry.lock') }}

      - name: Install dependencies
        run: poetry install --all-extras

      - name: Verify Poetry lock file
        run: poetry check --lock

      - name: Run Ruff linting (strict)
        run: poetry run ruff check . --output-format=github --no-fix

      - name: Check code formatting
        run: |
          poetry run black --check --diff .
          poetry run ruff format --check .

      - name: Run MyPy type checking (strict)
        run: poetry run mypy src/{{PACKAGE_NAME}} --strict

      - name: Validate imports with isort
        run: poetry run isort --check-only --diff .

  # ===== MULTI-VERSION TESTING =====
  test-matrix:
    name: 🧪 Test Matrix
    runs-on: ${{ matrix.os }}
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
        python-version: ["3.12", "3.13"]
        include:
          - os: ubuntu-latest
            python-version: "3.12"
            coverage: true

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          version: ${{ env.POETRY_VERSION }}
          virtualenvs-create: true
          virtualenvs-in-project: true

      - name: Cache Poetry dependencies
        uses: actions/cache@v4
        with:
          path: |
            ${{ env.POETRY_CACHE_DIR }}
            .venv
          key: poetry-${{ runner.os }}-${{ matrix.python-version }}-${{ hashFiles('**/poetry.lock') }}

      - name: Install dependencies
        run: poetry install --all-extras

      - name: Run tests without coverage
        if: ${{ !matrix.coverage }}
        run: poetry run pytest tests/ -v --tb=short

      - name: Run tests with coverage
        if: ${{ matrix.coverage }}
        run: |
          poetry run pytest tests/ --cov=src --cov-report=xml --cov-report=html --cov-fail-under=80

      - name: Upload coverage to Codecov
        if: ${{ matrix.coverage }}
        uses: codecov/codecov-action@v4
        with:
          file: ./coverage.xml
          fail_ci_if_error: true
          verbose: true

      - name: Upload coverage reports
        if: ${{ matrix.coverage }}
        uses: actions/upload-artifact@v4
        with:
          name: coverage-reports
          path: |
            coverage.xml
            htmlcov/

  # ===== PRE-COMMIT VALIDATION =====
  pre-commit:
    name: 🎣 Pre-commit Hooks
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Cache pre-commit
        uses: actions/cache@v4
        with:
          path: ${{ env.PRE_COMMIT_CACHE }}
          key: pre-commit-${{ runner.os }}-${{ hashFiles('.pre-commit-config.yaml') }}

      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          version: ${{ env.POETRY_VERSION }}

      - name: Install dependencies
        run: poetry install --with dev

      - name: Run pre-commit hooks
        run: poetry run pre-commit run --all-files --show-diff-on-failure

  # ===== BUILD & PACKAGE =====
  build:
    name: 🔨 Build Package
    runs-on: ubuntu-latest
    needs: [security-scan, quality-gate, test-matrix]
    timeout-minutes: 10
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          version: ${{ env.POETRY_VERSION }}

      - name: Build package
        run: poetry build

      - name: Check package integrity
        run: poetry run twine check dist/*

      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: dist-packages
          path: dist/

  # ===== DEPLOYMENT (only on tags) =====
  deploy:
    name: 🚀 Deploy Package
    runs-on: ubuntu-latest
    needs: [build]
    if: startsWith(github.ref, 'refs/tags/v')
    environment: production
    timeout-minutes: 10
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Download build artifacts
        uses: actions/download-artifact@v4
        with:
          name: dist-packages
          path: dist/

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - name: Install Poetry
        uses: snok/install-poetry@v1
        with:
          version: ${{ env.POETRY_VERSION }}

      - name: Configure Poetry for PyPI
        run: poetry config pypi-token.pypi ${{ secrets.PYPI_TOKEN }}

      - name: Publish to PyPI
        run: poetry publish

  # ===== NOTIFICATIONS =====
  notify:
    name: 📢 Notifications
    runs-on: ubuntu-latest
    needs: [security-scan, quality-gate, test-matrix, pre-commit, build]
    if: always()
    steps:
      - name: Determine status
        id: status
        run: |
          if [[ "${{ needs.security-scan.result }}" == "failure" ||
                "${{ needs.quality-gate.result }}" == "failure" ||
                "${{ needs.test-matrix.result }}" == "failure" ||
                "${{ needs.pre-commit.result }}" == "failure" ||
                "${{ needs.build.result }}" == "failure" ]]; then
            echo "status=failure" >> $GITHUB_OUTPUT
          else
            echo "status=success" >> $GITHUB_OUTPUT
          fi

      - name: Notify success
        if: steps.status.outputs.status == 'success'
        run: |
          echo "✅ All quality gates passed for {{PROJECT_NAME}}!"
          echo "Build: ${{ github.sha }}"
          echo "Branch: ${{ github.ref_name }}"

      - name: Notify failure
        if: steps.status.outputs.status == 'failure'
        run: |
          echo "❌ Quality gate failure for {{PROJECT_NAME}}"
          echo "Build: ${{ github.sha }}"
          echo "Branch: ${{ github.ref_name }}"
          exit 1
