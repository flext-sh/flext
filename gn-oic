#!/usr/bin/env python3
"""client-b OIC WMS CLI wrapper - gn-oic."""

import sys
import os
from pathlib import Path

# Add the source directory to Python path
sys.path.insert(0, str(Path(__file__).parent / "project-client-b-oic-wms" / "src"))

# Change to source directory for proper execution
os.chdir(str(Path(__file__).parent / "project-client-b-oic-wms" / "src"))

try:
    from gn_oic_wms_db.cli import main
    main(sys.argv[1:])
except ImportError as e:
    print(f"❌ Error importing client-b OIC CLI: {e}")
    print("Make sure dependencies are installed and FLX framework is available")
    sys.exit(1)
except Exception as e:
    print(f"❌ Error running client-b OIC CLI: {e}")
    sys.exit(1)