{
  "max_age_days": 30,
  "min_words_per_file": 100,
  "link_timeout": 10,
  "concurrent_requests": 5,
  "output_dir": "docs/reports",
  "ignore_patterns": [
    "**/__pycache__/**",
    "**/.git/**",
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/*.pyc",
    "**/*.pyo",
    "**/.pytest_cache/**",
    "**/.coverage/**",
    "**/htmlcov/**"
  ],
  "style_rules": {
    "max_line_length": 120,
    "heading_hierarchy": true,
    "consistent_lists": true,
    "code_block_lang": true,
    "alt_text_required": true,
    "trailing_spaces": false,
    "multiple_blank_lines": false
  },
  "quality_thresholds": {
    "completeness": 0.8,
    "freshness": 0.7,
    "accessibility": 0.9,
    "consistency": 0.85,
    "link_health": 0.95
  },
  "content_rules": {
    "required_sections": ["Overview", "Installation", "Usage", "Configuration"],
    "max_todos_per_file": 5,
    "min_headings_per_file": 3,
    "max_consecutive_blank_lines": 2
  },
  "validation_rules": {
    "external_link_check": true,
    "internal_link_check": true,
    "image_validation": true,
    "spell_check": false,
    "grammar_check": false
  },
  "reporting": {
    "generate_html_report": true,
    "generate_json_summary": true,
    "include_file_details": true,
    "severity_levels": {
      "critical": ["broken_link", "missing_image", "syntax_error"],
      "high": ["outdated_content", "inconsistent_style"],
      "medium": ["missing_alt_text", "long_lines"],
      "low": ["minor_formatting", "whitespace_issues"]
    }
  },
  "automation": {
    "auto_fix_safe_issues": true,
    "create_backup_before_changes": true,
    "git_commit_changes": false,
    "schedule_frequency": "weekly"
  },
  "notifications": {
    "enable_email_alerts": false,
    "alert_thresholds": {
      "broken_links": 10,
      "outdated_files": 20,
      "style_issues": 50
    }
  },
  "integrations": {
    "github_issues": false,
    "slack_notifications": false,
    "project_management": false
  }
}
