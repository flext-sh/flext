{
  "name": "customer",
  "version": "1.0",
  "description": "Customer entity with comprehensive tracking and business logic",
  "fields": [
    {
      "name": "ID",
      "type": "INTEGER",
      "nullable": false,
      "description": "Primary key identifier"
    },
    {
      "name": "CUSTOMER_CODE",
      "type": "STRING",
      "length": 50,
      "nullable": false,
      "description": "Unique business customer code"
    },
    {
      "name": "COMPANY_NAME",
      "type": "STRING",
      "length": 255,
      "nullable": false,
      "description": "Customer company name"
    },
    {
      "name": "CONTACT_NAME",
      "type": "STRING",
      "length": 100,
      "nullable": true,
      "description": "Primary contact person name"
    },
    {
      "name": "EMAIL",
      "type": "STRING",
      "length": 255,
      "nullable": true,
      "description": "Customer email address"
    },
    {
      "name": "PHONE",
      "type": "STRING",
      "length": 50,
      "nullable": true,
      "description": "Customer phone number"
    },
    {
      "name": "ADDRESS",
      "type": "TEXT",
      "nullable": true,
      "description": "Customer address details"
    },
    {
      "name": "COUNTRY_CODE",
      "type": "STRING",
      "length": 3,
      "nullable": true,
      "description": "ISO country code"
    },
    {
      "name": "STATUS",
      "type": "STRING",
      "length": 20,
      "nullable": false,
      "default": "'ACTIVE'",
      "description": "Customer status (ACTIVE, INACTIVE, SUSPENDED)"
    },
    {
      "name": "CREDIT_LIMIT",
      "type": "DECIMAL",
      "precision": 15,
      "scale": 2,
      "nullable": true,
      "description": "Customer credit limit"
    },
    {
      "name": "REGISTRATION_DATE",
      "type": "DATE",
      "nullable": false,
      "default": "SYSDATE",
      "description": "Customer registration date"
    },
    {
      "name": "IS_VIP",
      "type": "BOOLEAN",
      "nullable": false,
      "default": "0",
      "description": "VIP customer flag"
    }
  ],
  "indexes": [
    {
      "name": "UK_CUSTOMER_CODE",
      "columns": ["CUSTOMER_CODE"],
      "unique": true
    },
    {
      "name": "IDX_COMPANY_NAME",
      "columns": ["COMPANY_NAME"],
      "unique": false
    },
    {
      "name": "IDX_STATUS",
      "columns": ["STATUS"],
      "unique": false
    },
    {
      "name": "IDX_COUNTRY_CODE",
      "columns": ["COUNTRY_CODE"],
      "unique": false
    }
  ],
  "foreign_keys": []
} 
