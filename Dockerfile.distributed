# Multi-stage build for FLEXT Distributed
FROM golang:1.21-alpine AS builder

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o flext ./cmd/flext

# Final stage
FROM alpine:latest

# Install runtime dependencies
RUN apk --no-cache add ca-certificates curl

# Set working directory
WORKDIR /app

# Copy binary from builder stage
COPY --from=builder /app/flext .

# Copy configuration files
COPY --from=builder /app/config ./config

# Create non-root user
RUN adduser -D -s /bin/sh flext

# Change ownership
RUN chown -R flext:flext /app

# Switch to non-root user
USER flext

# Expose port
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

# Run the application
ENTRYPOINT ["/app/flext"]
CMD ["-distributed"]