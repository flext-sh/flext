attributeTypes: ( 2.16.840.1.113894.746875.1.1.3 NAME 'orclcommonname' DESC 'Oracle Common Name' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
