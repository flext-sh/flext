{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flext.sh/schemas/enforcement-catalog.json",
  "title": "FLEXT Enforcement Catalog",
  "description": "Declarative rule catalog mapping each enforcement rule to an existing detection source (flext-infra detector, flext-tests validator, runtime warning, or ruff rule). SSOT consumed by flext_tests._fixtures.enforcement pytest plugin.",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Catalog schema version."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the catalog."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    "rule": {
      "type": "object",
      "required": ["id", "description", "severity", "source"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ENFORCE-[0-9]{3}$",
          "description": "Canonical rule identifier (ENFORCE-001..ENFORCE-999)."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {"$ref": "#/$defs/severity"},
        "agents_md": {
          "type": "string",
          "description": "AGENTS.md section anchor (e.g. '§3.2 Type Contracts')."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Name of a skill directory under .agents/skills/."
          },
          "uniqueItems": true
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "promote_to_error_when_strict": {
          "type": "boolean",
          "default": true,
          "description": "When --flext-enforce-strict is active, promote this rule's violations from warnings to errors."
        },
        "notes": {
          "type": "string"
        },
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "source": {
      "oneOf": [
        {"$ref": "#/$defs/source_flext_infra_detector"},
        {"$ref": "#/$defs/source_flext_tests_validator"},
        {"$ref": "#/$defs/source_runtime_warning"},
        {"$ref": "#/$defs/source_ruff"},
        {"$ref": "#/$defs/source_skill_pointer"}
      ]
    },
    "source_flext_infra_detector": {
      "type": "object",
      "required": ["kind", "violation_field"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "flext_infra_detector"},
        "violation_field": {
          "type": "string",
          "description": "Attribute name on m.Infra.ProjectEnforcementReport that holds this rule's violations (e.g. 'loose_objects'). Facade-missing uses 'facade_statuses' with match_missing=true.",
          "enum": [
            "loose_objects",
            "import_violations",
            "namespace_source_violations",
            "internal_import_violations",
            "manual_protocol_violations",
            "cyclic_imports",
            "runtime_alias_violations",
            "future_violations",
            "manual_typing_violations",
            "compatibility_alias_violations",
            "class_placement_violations",
            "mro_completeness_violations",
            "parse_failures",
            "facade_statuses"
          ]
        },
        "match_missing": {
          "type": "boolean",
          "default": false,
          "description": "Only for facade_statuses: include entries where exists=false."
        }
      }
    },
    "source_flext_tests_validator": {
      "type": "object",
      "required": ["kind", "method", "rule_ids"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "flext_tests_validator"},
        "method": {
          "type": "string",
          "enum": ["imports", "types", "tests", "bypass", "layer", "markdown", "validate_config"],
          "description": "FlextTestsValidator classmethod to invoke (tv.<method>)."
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true,
          "description": "Internal rule IDs from the validator's result (e.g. TYPE-002) to include for this ENFORCE rule."
        }
      }
    },
    "source_runtime_warning": {
      "type": "object",
      "required": ["kind", "category"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "runtime_warning"},
        "category": {
          "type": "string",
          "description": "Fully-qualified warning category path (e.g. flext_core._constants.enforcement.FlextMroViolation)."
        }
      }
    },
    "source_ruff": {
      "type": "object",
      "required": ["kind", "rule_code"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "ruff"},
        "rule_code": {
          "type": "string",
          "description": "Ruff rule code (e.g. ANN401). Documented here; execution delegated to 'make lint'."
        }
      }
    },
    "source_skill_pointer": {
      "type": "object",
      "required": ["kind", "skill"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "skill_pointer"},
        "skill": {
          "type": "string",
          "description": "Skill directory name under .agents/skills/ that documents the rule. No automated detection."
        }
      }
    }
  }
}
