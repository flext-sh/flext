# FLX Enterprise Platform Environment Configuration
# Copy this file to .env and configure your environment

# Environment
FLX_ENV=development
FLX_DEBUG=true

# Core Daemon
FLX_GRPC_PORT=50051
FLX_GRPC_MAX_WORKERS=10
FLX_METRICS_PORT=8000

# Database
FLX_DATABASE_URL=postgresql://flx:flx@localhost:5432/flx

# Redis
FLX_REDIS_URL=redis://localhost:6379/0

# RabbitMQ
FLX_AMQP_URL=amqp://guest:guest@localhost:5672/

# Meltano
MELTANO_PROJECT_ROOT=/home/marlonsc/pyauto/flx-meltano-enterprise/meltano_projects
MELTANO_ENVIRONMENT=dev

# Security
FLX_JWT_SECRET=your-secret-key-here-change-in-production
FLX_JWT_ALGORITHM=HS256
FLX_JWT_EXPIRATION=3600

# Django
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# FastAPI
FLX_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Monitoring
FLX_TRACING_ENABLED=true
FLX_TRACING_ENDPOINT=http://localhost:4317

# Feature Flags
FLX_MULTI_TENANCY_ENABLED=false
FLX_CIRCUIT_BREAKER_ENABLED=true

# Object Storage (MinIO/S3)
FLX_S3_ENDPOINT=http://localhost:9000
FLX_S3_ACCESS_KEY=minioadmin
FLX_S3_SECRET_KEY=minioadmin
FLX_S3_BUCKET=flx-data

# Email (for alerts)
FLX_EMAIL_HOST=smtp.gmail.com
FLX_EMAIL_PORT=587
FLX_EMAIL_USER=
FLX_EMAIL_PASSWORD=
FLX_EMAIL_USE_TLS=true

# Slack (for alerts)
FLX_SLACK_WEBHOOK_URL=

# Log Level
FLX_LOG_LEVEL=INFO
