# Multi-stage build for FLX API (FastAPI)
# Build stage
FROM python:3.13-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /build

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Install poetry and dependencies
RUN pip install --no-cache-dir poetry==1.8.2 \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root --only main,api

# Copy source code
COPY src/flx ./src/flx
COPY src/flx_api ./src/flx_api

# Build gRPC protobuf files
RUN python -m grpc_tools.protoc \
    -I./src/flx/grpc/proto \
    --python_out=./src/flx/grpc/proto \
    --grpc_python_out=./src/flx/grpc/proto \
    ./src/flx/grpc/proto/flx.proto

# Runtime stage
FROM python:3.13-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r flx && useradd -r -g flx flx

# Set work directory
WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY --from=builder /build/src/flx ./src/flx
COPY --from=builder /build/src/flx_api ./src/flx_api

# Create necessary directories
RUN mkdir -p /app/logs /app/tmp \
    && chown -R flx:flx /app

# Environment variables
ENV PYTHONPATH=/app/src:$PYTHONPATH \
    FLX_ENVIRONMENT=production \
    FLX_API_HOST=0.0.0.0 \
    FLX_API_PORT=8000 \
    FLX_API_WORKERS=4

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Switch to non-root user
USER flx

# Expose ports
EXPOSE 8000

# Run with uvicorn
CMD ["uvicorn", "flx_api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--loop", "uvloop", \
     "--access-log", \
     "--log-config", "/app/src/flx_api/logging.yaml"]
