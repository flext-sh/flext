# Multi-stage build for FLX Core Daemon
# Build stage
FROM python:3.13-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /build

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Install poetry and dependencies
RUN pip install --no-cache-dir poetry==1.8.2 \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root --only main

# Copy source code
COPY src/flx ./src/flx

# Build gRPC protobuf files
RUN python -m grpc_tools.protoc \
    -I./src/flx/grpc/proto \
    --python_out=./src/flx/grpc/proto \
    --grpc_python_out=./src/flx/grpc/proto \
    ./src/flx/grpc/proto/flx.proto

# Runtime stage
FROM python:3.13-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r flx && useradd -r -g flx flx

# Set work directory
WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY --from=builder /build/src/flx ./src/flx

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/tmp \
    && chown -R flx:flx /app

# Environment variables
ENV PYTHONPATH=/app/src:$PYTHONPATH \
    FLX_ENVIRONMENT=production \
    FLX_LOG_LEVEL=INFO \
    FLX_GRPC_PORT=50051 \
    FLX_METRICS_PORT=9090

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${FLX_METRICS_PORT}/health || exit 1

# Switch to non-root user
USER flx

# Expose ports
EXPOSE 50051 9090

# Run the daemon
CMD ["python", "-m", "flx.daemon"]
