# Multi-stage build for FLX Web (Django)
# Build stage
FROM python:3.13-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /build

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Install poetry and dependencies
RUN pip install --no-cache-dir poetry==1.8.2 \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root --only main,web

# Copy source code
COPY src/flx ./src/flx
COPY src/flx_web ./src/flx_web

# Collect static files
ENV DJANGO_SETTINGS_MODULE=flx_web.settings.production
RUN cd src && python -m flx_web.manage collectstatic --noinput

# Runtime stage
FROM python:3.13-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    postgresql-client \
    nginx \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r flx && useradd -r -g flx flx

# Set work directory
WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY --from=builder /build/src/flx ./src/flx
COPY --from=builder /build/src/flx_web ./src/flx_web

# Copy static files
COPY --from=builder /build/src/staticfiles ./staticfiles

# Copy configuration files
COPY deploy/nginx/flx-web.conf /etc/nginx/sites-available/default
COPY deploy/supervisor/flx-web.conf /etc/supervisor/conf.d/

# Create necessary directories
RUN mkdir -p /app/logs /app/media /app/tmp \
    /var/log/nginx /var/log/supervisor \
    && chown -R flx:flx /app \
    && chown -R www-data:www-data /var/log/nginx

# Environment variables
ENV PYTHONPATH=/app/src:$PYTHONPATH \
    DJANGO_SETTINGS_MODULE=flx_web.settings.production \
    FLX_ENVIRONMENT=production

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost/health/ || exit 1

# Expose ports
EXPOSE 80

# Run supervisord
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
