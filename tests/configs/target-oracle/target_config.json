{
  "host": "oracle-db",
  "port": 1521,
  "service_name": "XEPDB1",
  "username": "flext_target",
  "password": "flext_target_password",
  "protocol": "tcp",
  "ssl_server_dn_match": false,
  "default_target_schema": "FLEXT_TARGET",
  "batch_size": 1000,
  "max_parallelism": 4,
  "connection_pool_size": 5,
  "query_timeout": 300,
  "auto_create_tables": true,
  "auto_evolve_schema": true,
  "drop_tables_on_reset": false,
  "load_method": "append-only",
  "table_prefix": "",
  "table_suffix": "",
  "enable_circuit_breaker": true,
  "circuit_breaker_failures": 5,
  "circuit_breaker_timeout": 60,
  "enable_metrics": true,
  "enable_sql_logging": true,
  "log_level": "DEBUG"
}
