{
  "host": "oracle-db",
  "port": 1521,
  "service_name": "XEPDB1",
  "username": "flext_source",
  "password": "flext_source_password",
  "protocol": "tcp",
  "ssl_server_dn_match": false,
  "schema": "FLEXT_SOURCE",
  "batch_size": 1000,
  "query_timeout": 300,
  "connection_pool_size": 3,
  "enable_schema_flattening": true,
  "schema_flattening_max_depth": 3,
  "schema_flattening_separator": "__",
  "tables": [
    {
      "table_name": "customers",
      "replication_method": "FULL_TABLE",
      "replication_key": "updated_at"
    },
    {
      "table_name": "orders",
      "replication_method": "INCREMENTAL",
      "replication_key": "order_date"
    },
    {
      "table_name": "products",
      "replication_method": "FULL_TABLE",
      "replication_key": "created_at"
    },
    {
      "table_name": "order_items",
      "replication_method": "FULL_TABLE"
    },
    {
      "table_name": "customer_order_summary",
      "replication_method": "FULL_TABLE"
    }
  ],
  "enable_performance_monitoring": true,
  "enable_metrics": true,
  "log_level": "DEBUG"
}
