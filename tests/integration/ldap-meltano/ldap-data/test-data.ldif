# Test LDAP data for integration testing
# This file will be loaded into the source LDAP server

# Create organizational units
dn: ou=users,dc=flext-test,dc=local
objectClass: organizationalUnit
objectClass: top
ou: users
description: Users organizational unit

dn: ou=groups,dc=flext-test,dc=local
objectClass: organizationalUnit
objectClass: top
ou: groups
description: Groups organizational unit

# Test users
dn: uid=test.user1,ou=users,dc=flext-test,dc=local
objectClass: inetOrgPerson
objectClass: person
objectClass: top
uid: test.user1
cn: Test User One
sn: User One
givenName: Test
mail: test.user1@internal.invalid
telephoneNumber: +1-555-0001
description: First test user for FLEXT LDAP integration

dn: uid=test.user2,ou=users,dc=flext-test,dc=local
objectClass: inetOrgPerson
objectClass: person
objectClass: top
uid: test.user2
cn: Test User Two
sn: User Two
givenName: Test
mail: test.user2@internal.invalid
telephoneNumber: +1-555-0002
description: Second test user for FLEXT LDAP integration

dn: uid=test.user3,ou=users,dc=flext-test,dc=local
objectClass: inetOrgPerson
objectClass: person
objectClass: top
uid: test.user3
cn: Test User Three
sn: User Three
givenName: Test
mail: test.user3@internal.invalid
telephoneNumber: +1-555-0003
description: Third test user for FLEXT LDAP integration

# Test groups
dn: cn=REDACTED_LDAP_BIND_PASSWORD-group,ou=groups,dc=flext-test,dc=local
objectClass: groupOfNames
objectClass: top
cn: REDACTED_LDAP_BIND_PASSWORD-group
description: Administrator group
member: uid=test.user1,ou=users,dc=flext-test,dc=local

dn: cn=user-group,ou=groups,dc=flext-test,dc=local
objectClass: groupOfNames
objectClass: top
cn: user-group
description: Regular user group
member: uid=test.user2,ou=users,dc=flext-test,dc=local
member: uid=test.user3,ou=users,dc=flext-test,dc=local

# Test service accounts
dn: uid=service.account,ou=users,dc=flext-test,dc=local
objectClass: inetOrgPerson
objectClass: person
objectClass: top
uid: service.account
cn: Service Account
sn: Account
mail: service.account@internal.invalid
description: Service account for testing