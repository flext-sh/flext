# ALGAR OUD MIGRATION CONFIGURATION
# OBRIGATÓRIO: Todos os valores devem ser configurados - NENHUM DEFAULT PERMITIDO

# MANDATORY: PyAuto workspace configuration (CLAUDE.md compliance)
WORKSPACE_ROOT=/home/marlonsc/pyauto
PYTHON_VENV=/home/marlonsc/pyauto/.venv
DEBUG_MODE=true

# === DIRETÓRIOS E ARQUIVOS ===
SOURCE_LDIF_PATH=/home/marlonsc/pyauto/algar-oud-mig/data/input
OUTPUT_PATH=/home/marlonsc/pyauto/algar-oud-mig/data/output
RULES_FILE_PATH=rules.json
BASE_DN=dc=ctbc
SOURCE_SCHEMA_FILE=5_schema.ldif
SOURCE_DATA_FILE=1_basedn.ldif

# === CONEXÃO OUD (DESTINO) ===
# ⚠️  CRÍTICO: CONFIGURAÇÕES REAIS DO OUD - NÃO ALTERAR SEM AUTORIZAÇÃO ⚠️
# Essas configurações conectam no OUD real para carregar o schema atual
TARGET_OUD_HOST=localhost
TARGET_OUD_PORT=3389
TARGET_OUD_BIND_DN="cn=Directory Manager"
TARGET_OUD_BIND_PASSWORD=Welcome123#
TARGET_OUD_USE_SSL=false
OUD_SSL_VERIFY=false

# === CONFIGURAÇÕES SSH TUNNEL (AUTOMÁTICO) ===
# ⚠️  SSH TUNNEL É ATIVADO AUTOMATICAMENTE SE OUD_HOST ≠ localhost ⚠️
# O sistema detecta automaticamente se precisa de SSH tunnel
SSH_OUD_ENABLED=true
SSH_OUD_HOST=10.1.106.37
SSH_OUD_PORT=22
SSH_OUD_USER=datacosmos
SSH_OUD_KEY_FILE=~/.ssh/id_rsa.algar
SSH_OUD_LOCAL_PORT=3389

# === CONFIGURAÇÕES DE MIGRAÇÃO ===
MIGRATION_BATCH_SIZE=1000
MIGRATION_MAX_WORKERS=4
MIGRATION_LOG_LEVEL=DEBUG
MIGRATION_CONTINUE_ON_ERRORS=false
MIGRATION_GENERATE_SUMMARY=true

# === MIGRATION BEHAVIOR ===
ENABLE_TRANSFORMATIONS=true
DOMAIN_EXTRACTION_METHOD=from_config

# === LDAP OPERATIONS ===
LDAP_SEARCH_TIMEOUT=30
LDAP_BIND_TIMEOUT=10
LDAP_PAGE_SIZE=1000

# === VALIDATION ===
ENABLE_STRICT_VALIDATION=true
VALIDATION_STOP_ON_ERROR=true

# === OUTPUT FORMATTING ===
LDIF_OUTPUT_ENCODING=utf-8
INCLUDE_MIGRATION_HEADERS=true

# === CONFIGURAÇÕES DE AMBIENTE ===
# ⚠️  ATENÇÃO: NÃO ALTERE ESSAS CONFIGURAÇÕES CRÍTICAS NUNCA ⚠️ 
# SCHEMA_COMPARISON_MODE controla como o schema do OUD é carregado:
# - ldap_connection: CONECTA DIRETO NO OUD VIA LDAP (OBRIGATÓRIO PARA PRODUÇÃO)
# - file_based: usa arquivo local (apenas para testes)
# - rules_based: usa conhecimento fake (REMOVIDO - NÃO USAR)
SCHEMA_COMPARISON_MODE=file_based
SCHEMA_SOURCE_TYPE=ldap

# === OID CONNECTION (LEGACY SOURCE) ===
OID_HOST=localhost
OID_PORT=389
OID_BIND_DN=cn=orcladmin
OID_BIND_PASSWORD=
OID_USE_SSL=false
OID_TIMEOUT=30

# === SSH TUNNEL FOR OID (IF NEEDED) ===
SSH_OID_ENABLED=false
SSH_OID_HOST=
SSH_OID_PORT=22
SSH_OID_USER=
SSH_OID_KEY_FILE=
SSH_OID_LOCAL_PORT=13389

# === OUD CONNECTION TIMEOUT ===
TARGET_OUD_TIMEOUT=30
SSH_OUD_TIMEOUT=30

# === LDAP SCOPE ===
LDAP_SCOPE=SUBTREE

# === VALIDATION ERRORS ===
MAX_VALIDATION_ERRORS=100

# === LDIF LINE WRAP ===
LDIF_LINE_WRAP_LENGTH=76
