# FLEXT Docker Management Makefile
# Simplified commands for FLEXT platform Docker operations

.PHONY: help build up down logs clean dev prod status health reset

# Default target
help:
	@echo "🚀 FLEXT Docker Management Commands:"
	@echo ""
	@echo "📦 Basic Operations:"
	@echo "  build     - Build all FLEXT Docker images"
	@echo "  up        - Start all FLEXT services"
	@echo "  down      - Stop all FLEXT services"
	@echo "  logs      - Show logs from all services"
	@echo "  status    - Show status of all services"
	@echo "  health    - Check health of all services"
	@echo ""
	@echo "🛠️  Development:"
	@echo "  dev       - Start in development mode with hot reload"
	@echo "  dev-logs  - Show development logs"
	@echo "  dev-down  - Stop development environment"
	@echo ""
	@echo "🏭 Production:"
	@echo "  prod      - Start in production mode with monitoring"
	@echo "  prod-logs - Show production logs"
	@echo "  prod-down - Stop production environment"
	@echo ""
	@echo "🧹 Maintenance:"
	@echo "  clean     - Clean unused Docker resources"
	@echo "  reset     - Reset all data and containers"
	@echo "  backup    - Backup database and volumes"
	@echo "  restore   - Restore from backup"

# Build all FLEXT images
build:
	@echo "🔨 Building FLEXT Docker images..."
	docker-compose build --parallel

# Start all services (production)
up:
	@echo "🚀 Starting FLEXT platform..."
	docker-compose up -d
	@echo "✅ FLEXT platform started!"
	@echo "🌐 Web Interface: http://localhost"
	@echo "📡 API Service: http://localhost:8080"
	@echo "📊 Monitoring: http://localhost:3000 (Grafana)"

# Stop all services
down:
	@echo "⏹️  Stopping FLEXT platform..."
	docker-compose down
	@echo "✅ FLEXT platform stopped"

# Show logs
logs:
	docker-compose logs -f

# Development mode (with hot reload and debugging)
dev:
	@echo "🛠️  Starting FLEXT in development mode..."
	docker-compose -f docker-compose.yml -f docker-compose.override.yml up -d
	@echo "✅ Development environment started!"
	@echo "🌐 Web Interface: http://localhost:5000"
	@echo "📡 API Service: http://localhost:8080"
	@echo "💾 Database Admin: http://localhost:8081"
	@echo "📊 Prometheus: http://localhost:9090"
	@echo "📈 Grafana: http://localhost:3000 (admin/admin)"

dev-logs:
	docker-compose -f docker-compose.yml -f docker-compose.override.yml logs -f

dev-down:
	@echo "⏹️  Stopping development environment..."
	docker-compose -f docker-compose.yml -f docker-compose.override.yml down

# Production mode (with monitoring)
prod:
	@echo "🏭 Starting FLEXT in production mode..."
	docker-compose --profile monitoring up -d
	@echo "✅ Production environment started!"
	@echo "🌐 Web Interface: http://localhost"
	@echo "📡 API Service: http://localhost/api"
	@echo "📊 Grafana: http://localhost:3000"
	@echo "📈 Prometheus: http://localhost:9090"

prod-logs:
	docker-compose --profile monitoring logs -f

prod-down:
	@echo "⏹️  Stopping production environment..."
	docker-compose --profile monitoring down

# Check service status
status:
	@echo "📊 FLEXT Service Status:"
	@docker-compose ps

# Health checks
health:
	@echo "🏥 FLEXT Health Check:"
	@echo ""
	@echo "📡 FLEXT Service:"
	@curl -s http://localhost:8080/health | python -m json.tool 2>/dev/null || echo "❌ Service not responding"
	@echo ""
	@echo "🌐 Web Interface:"
	@curl -s http://localhost:5000/health | python -m json.tool 2>/dev/null || echo "❌ Web interface not responding"
	@echo ""
	@echo "💾 PostgreSQL:"
	@docker-compose exec -T postgres pg_isready -U flext 2>/dev/null && echo "✅ Database healthy" || echo "❌ Database not responding"
	@echo ""
	@echo "⚡ Redis:"
	@docker-compose exec -T redis redis-cli ping 2>/dev/null && echo "✅ Cache healthy" || echo "❌ Cache not responding"

# Clean unused Docker resources
clean:
	@echo "🧹 Cleaning Docker resources..."
	docker system prune -f
	docker volume prune -f
	@echo "✅ Cleanup completed"

# Reset everything (DANGEROUS - will delete all data)
reset:
	@echo "⚠️  WARNING: This will delete all FLEXT data!"
	@read -p "Are you sure? Type 'yes' to continue: " confirm && [ "$$confirm" = "yes" ] || exit 1
	docker-compose down -v
	docker-compose rm -f
	docker volume rm -f flext_postgres-data flext_redis-data flext_flext-plugins flext_flext-pipelines 2>/dev/null || true
	@echo "🗑️  All data has been deleted"

# Backup database and volumes
backup:
	@echo "💾 Creating FLEXT backup..."
	@mkdir -p backups
	@timestamp=$$(date +%Y%m%d_%H%M%S) && \
	docker-compose exec -T postgres pg_dump -U flext flext > "backups/flext_db_$$timestamp.sql" && \
	docker run --rm -v flext_flext-plugins:/data -v $(PWD)/backups:/backup alpine tar czf "/backup/flext_plugins_$$timestamp.tar.gz" -C /data . && \
	docker run --rm -v flext_flext-pipelines:/data -v $(PWD)/backups:/backup alpine tar czf "/backup/flext_pipelines_$$timestamp.tar.gz" -C /data . && \
	echo "✅ Backup completed: backups/flext_*_$$timestamp.*"

# Restore from backup (specify BACKUP_DATE=YYYYMMDD_HHMMSS)
restore:
	@if [ -z "$(BACKUP_DATE)" ]; then echo "❌ Please specify BACKUP_DATE=YYYYMMDD_HHMMSS"; exit 1; fi
	@echo "♻️  Restoring FLEXT from backup $(BACKUP_DATE)..."
	@if [ ! -f "backups/flext_db_$(BACKUP_DATE).sql" ]; then echo "❌ Backup file not found"; exit 1; fi
	docker-compose exec -T postgres psql -U flext -d flext < "backups/flext_db_$(BACKUP_DATE).sql"
	@if [ -f "backups/flext_plugins_$(BACKUP_DATE).tar.gz" ]; then \
		docker run --rm -v flext_flext-plugins:/data -v $(PWD)/backups:/backup alpine sh -c "rm -rf /data/* && tar xzf /backup/flext_plugins_$(BACKUP_DATE).tar.gz -C /data"; \
	fi
	@if [ -f "backups/flext_pipelines_$(BACKUP_DATE).tar.gz" ]; then \
		docker run --rm -v flext_flext-pipelines:/data -v $(PWD)/backups:/backup alpine sh -c "rm -rf /data/* && tar xzf /backup/flext_pipelines_$(BACKUP_DATE).tar.gz -C /data"; \
	fi
	@echo "✅ Restore completed"

# Quick development setup
setup-dev: build dev
	@echo "⏳ Waiting for services to be ready..."
	@sleep 10
	@make health
	@echo ""
	@echo "🎉 FLEXT development environment is ready!"
	@echo "📚 Check logs with: make dev-logs"

# Quick production setup
setup-prod: build prod
	@echo "⏳ Waiting for services to be ready..."
	@sleep 15
	@make health
	@echo ""
	@echo "🎉 FLEXT production environment is ready!"
	@echo "📚 Check logs with: make prod-logs"

# Show service URLs
urls:
	@echo "🔗 FLEXT Service URLs:"
	@echo ""
	@echo "🌐 Web Interface:"
	@echo "  Development: http://localhost:5000"
	@echo "  Production:  http://localhost"
	@echo ""
	@echo "📡 API Service:"
	@echo "  Direct:      http://localhost:8080"
	@echo "  Via Proxy:   http://localhost/api"
	@echo ""
	@echo "💾 Database:"
	@echo "  PostgreSQL:  localhost:5432"
	@echo "  Admin UI:    http://localhost:8081 (dev only)"
	@echo ""
	@echo "📊 Monitoring:"
	@echo "  Prometheus:  http://localhost:9090"
	@echo "  Grafana:     http://localhost:3000"