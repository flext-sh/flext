# Makefile para automação de testes - Aplicação FLX
# 
# Este Makefile automatiza a execução de testes, geração de relatórios
# de cobertura e outras tarefas relacionadas à qualidade do código.
#
# Usage:
#   make test-all          # Executar todos os testes
#   make coverage-full     # Gerar relatório completo de cobertura
#   make test-unit         # Executar apenas testes unitários
#   make test-integration  # Executar testes de integração
#   make test-e2e          # Executar testes end-to-end

.PHONY: help test-all coverage-full test-unit test-integration test-e2e clean-coverage install-test-deps

# Default target
help:
	@echo "🧪 FLX Testing Automation"
	@echo ""
	@echo "Available targets:"
	@echo "  test-all          - Executar todos os testes"
	@echo "  coverage-full     - Gerar relatório completo de cobertura"
	@echo "  test-unit         - Executar testes unitários"
	@echo "  test-integration  - Executar testes de integração"
	@echo "  test-e2e          - Executar testes end-to-end"
	@echo "  install-test-deps - Instalar dependências de teste"
	@echo "  clean-coverage    - Limpar arquivos de cobertura"
	@echo "  fix-tests         - Corrigir testes existentes"

# Install test dependencies
install-test-deps:
	@echo "📦 Instalando dependências de teste..."
	pip install pytest pytest-cov pytest-mock pytest-asyncio
	pip install httpx responses
	pip install testcontainers
	pip install click

# Clean coverage files
clean-coverage:
	@echo "🧹 Limpando arquivos de cobertura..."
	find . -name "coverage.xml" -delete
	find . -name ".coverage" -delete
	find . -name "htmlcov" -type d -exec rm -rf {} + 2>/dev/null || true
	rm -rf reports/coverage/*

# Generate full coverage report
coverage-full: clean-coverage install-test-deps
	@echo "📊 Gerando relatório completo de cobertura..."
	python scripts/generate_full_coverage_report.py --workspace . --output reports/coverage

# Test all modules
test-all: install-test-deps
	@echo "🧪 Executando todos os testes..."
	@echo "FLX Core..."
	cd flx && python -m pytest tests/ -v --tb=short || true
	@echo "FLX Database Oracle..."
	cd flx-database-oracle && python -m pytest tests/ -v --tb=short || true
	@echo "FLX HTTP Oracle OIC..."
	cd flx-http-oracle-oic && python -m pytest tests/ -v --tb=short || true
	@echo "FLX HTTP Oracle WMS..."
	cd flx-http-oracle-wms && python -m pytest tests/ -v --tb=short || true
	@echo "FLX LDAP..."
	cd flx-ldap && python -m pytest tests/ -v --tb=short || true
	@echo "FLX OIC WMS..."
	cd flx-oic-wms && python -m pytest tests/ -v --tb=short || true
	@echo "FLX Oracle WMS..."
	cd flx-oracle-wms && python -m pytest tests/ -v --tb=short || true

# Test unit tests only
test-unit: install-test-deps
	@echo "🔬 Executando testes unitários..."
	find . -path "*/tests/unit/*" -name "test_*.py" -exec pytest {} -v \; || true
	find . -path "*/tests/test_*.py" -not -path "*/integration/*" -not -path "*/e2e/*" -exec pytest {} -v \; || true

# Test integration tests
test-integration: install-test-deps
	@echo "🔗 Executando testes de integração..."
	find . -path "*/tests/integration/*" -name "test_*.py" -exec pytest {} -v \; || true

# Test end-to-end tests
test-e2e: install-test-deps
	@echo "🌐 Executando testes end-to-end..."
	find . -path "*/tests/e2e/*" -name "test_*.py" -exec pytest {} -v \; || true

# Fix existing tests
fix-tests:
	@echo "🔧 Corrigindo testes existentes..."
	@echo "Verificando estrutura real dos módulos..."
	cd flx-database-oracle && python -c "from src.flx_database_oracle.models import *; print('Modelos:', [cls for cls in dir() if cls.startswith('Flx')])"
	cd flx-database-oracle && python -c "from src.flx_database_oracle.config import *; print('Config:', [cls for cls in dir() if cls.startswith('Flx')])"

# Generate test templates for all modules
generate-test-templates:
	@echo "🎯 Gerando templates de teste..."
	python scripts/generate_test_templates.py

# Run specific module tests with coverage
test-module-%: install-test-deps
	@echo "🧪 Testando módulo: $*"
	cd $* && python -m pytest tests/ --cov=src --cov-report=html --cov-report=term-missing -v

# Database integration tests (requires Oracle container)
test-db-integration:
	@echo "🗄️ Executando testes de integração com banco..."
	docker run --rm -d --name oracle-test-db -p 1521:1521 -e ORACLE_PASSWORD=test123 gvenzl/oracle-xe:21-slim || true
	sleep 30
	cd flx-database-oracle && python -m pytest tests/integration/ -v || true
	docker stop oracle-test-db || true

# Performance tests
test-performance:
	@echo "⚡ Executando testes de performance..."
	pytest --benchmark-only -v || true

# Security tests
test-security:
	@echo "🔒 Executando testes de segurança..."
	bandit -r . -x "*/tests/*,*/venv/*,*/.venv/*" || true
	safety check || true

# Quality checks
quality-check:
	@echo "✨ Executando verificações de qualidade..."
	ruff check . || true
	mypy . || true
	
# Full test pipeline
test-pipeline: clean-coverage install-test-deps test-all coverage-full quality-check
	@echo "🚀 Pipeline de testes completo executado!"

# Quick test (basic tests only)
test-quick:
	@echo "⚡ Testes rápidos..."
	pytest -x --tb=short -q || true

# Watch mode for development
test-watch:
	@echo "👀 Modo watch para desenvolvimento..."
	ptw --runner "pytest -x --tb=short" 
