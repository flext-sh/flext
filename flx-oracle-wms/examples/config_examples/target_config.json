{
  "base_url": "https://your-instance.oracle.com/fscmRestApi/resources/11.13.18.05",
  "username": "wms_user",
  "password": "${WMS_PASSWORD}",
  "timeout": 300,
  "enable_kpi_calculation": true,
  "enable_alerts": true,
  "expiry_alert_days": 30,
  "output_path": "./output",
  "output_format": "json",
  "database_url": "postgresql://user:pass@localhost:5432/wms_analytics",
  "enable_wms_updates": false,
  "alert_webhook_url": "https://your-webhook.com/alerts",
  "kpi_config": {
    "inventory": {
      "low_stock_threshold": 0.2,
      "high_value_threshold": 10000,
      "slow_moving_days": 90
    },
    "orders": {
      "sla_hours": 24,
      "rush_order_hours": 4,
      "backorder_alert_threshold": 5
    },
    "warehouse": {
      "productivity_target": 100,
      "utilization_target": 0.85,
      "overtime_threshold_hours": 2
    }
  }
}
