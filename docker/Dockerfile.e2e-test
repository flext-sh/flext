# FLEXT LDIF Pipeline E2E Test Runner
# Comprehensive end-to-end testing container for complete LDIF ecosystem

FROM python:3.13-slim

LABEL maintainer="FLEXT Team"
LABEL description="FLEXT LDIF E2E Test Runner"
LABEL version="0.9.0"

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTEST_DISABLE_PLUGIN_AUTOLOAD=1

# Install system dependencies for E2E testing
RUN apt-get update && apt-get install -y \
    curl \
    ldap-utils \
    postgresql-client \
    redis-tools \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy workspace pyproject.toml for dependency management
COPY pyproject.toml poetry.lock* ./

# Install Python dependencies including test tools
RUN pip install poetry==1.8.3 \
    && poetry config virtualenvs.create false \
    && poetry install --with=test,dev

# Copy test configurations and data
COPY tests/ /app/tests/
COPY test-configs/ /app/configs/
COPY test-data/ /app/test-data/

# Copy FLEXT projects for testing
COPY flext-core/ /app/flext-core/
COPY flext-ldif/ /app/flext-ldif/
COPY flext-tap-ldif/ /app/flext-tap-ldif/
COPY flext-target-ldif/ /app/flext-target-ldif/
COPY flext-dbt-ldif/ /app/flext-dbt-ldif/

# Install FLEXT packages in development mode
RUN cd /app/flext-core && pip install -e . \
    && cd /app/flext-ldif && pip install -e . \
    && cd /app/flext-tap-ldif && pip install -e . \
    && cd /app/flext-target-ldif && pip install -e . \
    && cd /app/flext-dbt-ldif && pip install -e .

# Create directories for test results
RUN mkdir -p /app/results /app/data

# Create pytest configuration
RUN echo '[tool.pytest.ini_options]\n\
testpaths = ["tests"]\n\
markers = [\n\
    "unit: Unit tests",\n\
    "integration: Integration tests",\n\
    "e2e: End-to-end tests",\n\
    "docker: Tests requiring Docker services"\n\
]\n\
addopts = "-v --tb=short --strict-markers"\n\
timeout = 300\n\
log_level = "INFO"' >/app/pytest.ini

# Health check script
RUN echo '#!/bin/bash\n\
echo "Running E2E test suite health check..."\n\
pytest --version\n\
python -c "import flext_core, flext_ldif, flext_tap_ldif, flext_target_ldif, flext_dbt_ldif; print(\\"All FLEXT packages imported successfully\\")"' > /app/healthcheck.sh \
    && chmod +x /app/healthcheck.sh

# Health check
HEALTHCHECK --interval=60s --timeout=30s --start-period=60s --retries=3 \
    CMD /app/healthcheck.sh

# Default command runs comprehensive E2E test suite
CMD ["pytest", "/app/tests/e2e", "-v", "--cov", "--cov-report=html:/app/results/coverage", "--cov-fail-under=95", "--timeout=600"]