# FLEXT Go Service - Production Docker Image
FROM golang:1.24-alpine AS builder

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy all source code (full project structure)
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.version=${VERSION:-2.0.0} -X main.build=${BUILD:-docker}" \
    -o flext ./cmd/flext/

# Runtime stage
FROM alpine:3.18

# Install runtime dependencies
RUN apk --no-cache add ca-certificates curl

# Create non-root user
RUN addgroup -g 1001 -S flext && \
    adduser -u 1001 -S flext -G flext

# Set working directory
WORKDIR /home/flext

# Copy binary from builder stage
COPY --from=builder /app/flext .

# Create config directory (no config file required)
RUN mkdir -p /etc/flext

# Create necessary directories
RUN mkdir -p /var/lib/flext /var/log/flext && \
    chown -R flext:flext /home/flext /var/lib/flext /var/log/flext

# Switch to non-root user
USER flext

# Expose port
EXPOSE 8080

# Health check (disable for now)
# HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
#     CMD curl -f http://localhost:8080/health || exit 1

# Set environment variables
ENV FLEXT_MODE=server \
    FLEXT_LOG_LEVEL=info \
    FLEXT_ENVIRONMENT=production

# Start the FLEXT service
CMD ["./flext"]