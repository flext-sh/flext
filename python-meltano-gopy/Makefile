# Makefile for python interface for package gopy.
# File is generated by gopy. Do not edit.
# gopy build -output=. -vm=python3 ../internal/gopy

GOCMD=go
GOBUILD=$(GOCMD) build -mod=mod
GOIMPORTS=goimports
PYTHON=/home/marlonsc/flext/.venv/bin/python3
LIBEXT=.so

# get the CC and flags used to build python:
GCC = $(shell $(GOCMD) env CC)
CFLAGS = "-I/usr/include/python3.13"
LDFLAGS = "-L/usr/lib" "-lpython3.13" -ldl -lm

all: gen build

gen:
	gopy gen -no-make -vm=python3 ../internal/gopy

build:
	# build target builds the generated files -- this is what gopy build does..
	# this will otherwise be built during go build and may be out of date
	- rm gopy.c
	# goimports is needed to ensure that the imports list is valid
	$(GOIMPORTS) -w gopy.go
	# generate gopy_go$(LIBEXT) from gopy.go -- the cgo wrappers to go functions
	$(GOBUILD) -buildmode=c-shared -o gopy_go$(LIBEXT) gopy.go
	# use pybindgen to build the gopy.c file which are the CPython wrappers to cgo wrappers..
	# note: pip install pybindgen to get pybindgen if this fails
	$(PYTHON) build.py
	# build the _gopy$(LIBEXT) library that contains the cgo and CPython wrappers
	# generated gopy.py python wrapper imports this c-code package
	
	$(GCC) gopy.c  gopy_go$(LIBEXT) -o _gopy$(LIBEXT) $(CFLAGS) $(LDFLAGS) -fPIC --shared -w
	


