#!/usr/bin/env python3
"""Oracle WMS CLI wrapper - flx-wms."""

import sys
import os
from pathlib import Path

# Add the source directory to Python path
sys.path.insert(0, str(Path(__file__).parent / "dc-oracle-wms" / "src"))

# Change to source directory for proper execution
os.chdir(str(Path(__file__).parent / "dc-oracle-wms" / "src"))

try:
    from flx_http_oracle_wms.cli import main
    main(sys.argv[1:])
except ImportError as e:
    print(f"❌ Error importing Oracle WMS CLI: {e}")
    print("Make sure dependencies are installed and FLX framework is available")
    sys.exit(1)
except Exception as e:
    print(f"❌ Error running Oracle WMS CLI: {e}")
    sys.exit(1)