# Oracle WMS Configuration
WMS_BASE_URL=https://test-instance.oracle.com/fscmRestApi/resources/11.13.18.05
WMS_USERNAME=wms_test_user
WMS_PASSWORD=wms_test_password
WMS_API_VERSION=v2

# Test Environment
WMS_TEST_MODE=true
WMS_PAGE_SIZE=100
WMS_TIMEOUT=30
WMS_RETRY_COUNT=3
WMS_RETRY_DELAY=5

# Output Configuration
WMS_OUTPUT_PATH=./output
WMS_OUTPUT_FORMAT=json
WMS_DATABASE_URL=postgresql://test:test@localhost:5432/wms_test

# Monitoring
WMS_METRICS_PORT=9090
WMS_LOG_LEVEL=INFO
WMS_ALERT_WEBHOOK_URL=https://test-webhook.example.com/alerts
