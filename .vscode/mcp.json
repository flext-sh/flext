{
  "servers": {
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": ["start-mcp-server", "--context=vscode", "--project-from-cwd"]
    },
    "code-review-graph": {
      "command": "code-review-graph",
      "args": ["serve", "--repo", "~/flext"],
      "cwd": "~/flext",
      "type": "stdio"
    }
  }
}
