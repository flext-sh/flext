{
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  "files.watcherExclude": {
    "__pycache__": true,
    ".DS_Store": true,
    ".flext-deps": true,
    ".git": true,
    ".hg": true,
    ".meltano": true,
    ".mypy_cache": true,
    ".pylance_cache": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    ".svn": true,
    ".venv": true,
    ".vscode/test-results": true,
    "*.backup": true,
    "*.bak": true,
    "*.egg-info": true,
    "*.log": true,
    "*.pb2_grpc.py": true,
    "*.pb2.py": true,
    "*.pyc": true,
    "*.pyd": true,
    "*.pyo": true,
    "*.swo": true,
    "*.swp": true,
    "*.temp": true,
    "*.tmp": true,
    "*~": true,
    "build": true,
    "CVS": true,
    "dist": true,
    "external-docs": true,
    "logs": true,
    "node_modules": true,
    "scripts": true,
    "temp": true,
    "Thumbs.db": true,
    "tmp": true,
    "vectorbt.pro": true,
    "vendor": true,
    "venv": true
  },
  "pyrefly.lspPath": ".venv/bin/pyrefly",
  "python-envs.defaultEnvManager": "ms-python.python:poetry",
  "python-envs.defaultPackageManager": "ms-python.python:poetry",
  "shellcheck.useWorkspaceRootAsCwd": true,
  "python.analysis.autoImportCompletions": true
}