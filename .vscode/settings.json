{
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl",
    "editor.formatOnSave": false
  },
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false
  },
  "better-yaml.documentOptions.version": "",
  "editor.mouseWheelZoom": true,
  "explorer.excludeGitIgnore": true,
  "files.autoSave": "afterDelay",
  "files.exclude": {
    "**/*.bak": true,
    "**/*.egg-info": true,
    "**/*.orig": true,
    "**/*.rej": true,
    "**/*.swp": true,
    "**/.archive": true,
    "**/.beads": true,
    "**/.benchmarks": true,
    "**/.bkp": true,
    "**/.cache": true,
    "**/.dolt": true,
    "**/.dolt_dropped_databases": true,
    "**/.doltcfg": true,
    "**/.git": true,
    "**/.hypothesis": true,
    "**/.mimosa": true,
    "**/.omo": true,
    "**/.pylance_cache": true,
    "**/.pyrefly_cache": true,
    "**/.pytest_cache": true,
    "**/.reports": true,
    "**/.ropeproject": true,
    "**/.ruff_cache": true,
    "**/.scope": true,
    "**/.serena": true,
    "**/.sisyphus": true,
    "**/.state": true,
    "**/.superpowers": true,
    "**/.tox": true,
    "**/.trash": true,
    "**/.turbo": true,
    "**/.venv": true,
    "**/.venv.*": true,
    "**/__pycache__": true,
    "**/__pyrefly_virtual__": true,
    "**/_tmp_*": true,
    "**/build": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/protos": true,
    "**/site": true,
    "**/target": true,
    "**/typings": true,
    "**/venv": true
  },
  "files.watcherExclude": {
    "**/*.bak": true,
    "**/*.egg-info/**": true,
    "**/*.orig": true,
    "**/*.rej": true,
    "**/*.swp": true,
    "**/.archive/**": true,
    "**/.beads/**": true,
    "**/.benchmarks/**": true,
    "**/.bkp/**": true,
    "**/.cache/**": true,
    "**/.dolt/**": true,
    "**/.dolt_dropped_databases/**": true,
    "**/.doltcfg/**": true,
    "**/.git/**": true,
    "**/.hypothesis/**": true,
    "**/.mimosa/**": true,
    "**/.omo/**": true,
    "**/.pylance_cache/**": true,
    "**/.pyrefly_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.reports/**": true,
    "**/.ropeproject/**": true,
    "**/.ruff_cache/**": true,
    "**/.scope/**": true,
    "**/.serena/**": true,
    "**/.sisyphus/**": true,
    "**/.state/**": true,
    "**/.superpowers/**": true,
    "**/.tox/**": true,
    "**/.trash/**": true,
    "**/.turbo/**": true,
    "**/.venv.*/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/__pyrefly_virtual__/**": true,
    "**/_tmp_*/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/protos/**": true,
    "**/site/**": true,
    "**/target/**": true,
    "**/typings/**": true,
    "**/venv/**": true
  },
  "git.autoRepositoryDetection": "subFolders",
  "git.detectSubmodules": true,
  "git.detectSubmodulesLimit": 100,
  "git.openRepositoryInParentFolders": "always",
  "git.repositoryScanMaxDepth": 2,
  "githubPullRequests.autoRepositoryDetection": true,
  "githubPullRequests.ignoreSubmodules": false,
  "markdownlint.appliesTo": "noFiles",
  "markdownlint.configFile": ".markdownlint.json",
  "python.pyrefly.diagnosticMode": "workspace",
  "python.pyrefly.disableLanguageServices": true,
  "python.pyrefly.disableTypeErrors": false,
  "python.pyrefly.syncNotebooks": false,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.activateEnvironment": true,
  "python.terminal.useEnvFile": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,
  "python.useEnvironmentsExtension": true,
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.format.preview": true,
  "ruff.importStrategy": "fromEnvironment",
  "ruff.interpreter": [
    "${workspaceFolder}/.venv/bin/python"
  ],
  "ruff.lint.preview": true,
  "ruff.path": [
    "${workspaceFolder}/.venv/bin/ruff"
  ],
"search.exclude": {
    "**/*.bak": true,
    "**/*.egg-info": true,
    "**/*.orig": true,
    "**/*.rej": true,
    "**/*.swp": true,
    "**/.archive": true,
    "**/.beads": true,
    "**/.benchmarks": true,
    "**/.bkp": true,
    "**/.cache": true,
    "**/.dolt": true,
    "**/.dolt_dropped_databases": true,
    "**/.doltcfg": true,
    "**/.git": true,
    "**/.hypothesis": true,
    "**/.mimosa": true,
    "**/.omo": true,
    "**/.pylance_cache": true,
    "**/.pyrefly_cache": true,
    "**/.pytest_cache": true,
    "**/.reports": true,
    "**/.ropeproject": true,
    "**/.ruff_cache": true,
    "**/.scope": true,
    "**/.serena": true,
    "**/.sisyphus": true,
    "**/.state": true,
    "**/.superpowers": true,
    "**/.tox": true,
    "**/.trash": true,
    "**/.turbo": true,
    "**/.venv": true,
    "**/.venv.*": true,
    "**/__pycache__": true,
    "**/__pyrefly_virtual__": true,
    "**/_tmp_*": true,
    "**/build": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/protos": true,
    "**/site": true,
    "**/target": true,
    "**/typings": true,
    "**/venv": true
  },
  "search.useGlobalIgnoreFiles": false,
  "search.useIgnoreFiles": true,
  "search.useParentIgnoreFiles": false,
  "shellcheck.useRepositoryRootAsCwd": true,
  "shellcheck.useWorkspaceRootAsCwd": true,
  "telemetry.feedback.enabled": false,
  "terminal.integrated.env.linux": {
    "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
    "VIRTUAL_ENV": "${workspaceFolder}/.venv"
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ]
}
