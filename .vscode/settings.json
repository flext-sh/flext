{
    "markdownlint.configFile": ".markdownlint.json",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.languageServer": "None",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvironmentPath": "${workspaceFolder}/.venv/bin/activate",
    "basedpyright.enabled": true,
    "basedpyright.typeCheckingMode": "basic",
    "basedpyright.autoSearchPaths": false,
    "basedpyright.extraPaths": [
        "./src",
        "./flext-core/src"
    ],
    "basedpyright.includeFileSpecs": [
        "**/src/**/*.py",
        "**/tests/**/*.py"
    ],
    "basedpyright.excludeFileSpecs": [
        "**/__pycache__/**",
        "**/.venv/**",
        "**/node_modules/**",
        "**/build/**",
        "**/dist/**",
        "**/*.pb2.py",
        "**/*.pb2_grpc.py",
        "**/flext-cli/**",
        "**/flext-dbt-*/**",
        "**/flext-tap-*/**",
        "**/flext-target-*/**"
    ],
    "basedpyright.reportMissingImports": "warning",
    "basedpyright.reportMissingTypeStubs": "warning",
    "basedpyright.reportImportCycles": "error",
    "basedpyright.reportUnusedImport": "warning",
    "basedpyright.reportUnusedClass": "warning",
    "basedpyright.reportUnusedFunction": "warning",
    "basedpyright.reportUnusedVariable": "warning",
    "basedpyright.reportDuplicateImport": "warning",
    "basedpyright.reportConstantRedefinition": "error",
    "basedpyright.reportIncompatibleMethodOverride": "error",
    "basedpyright.reportIncompatibleVariableOverride": "error",
    "basedpyright.reportInconsistentConstructor": "error",
    "basedpyright.reportOverlappingOverloads": "error",
    "basedpyright.reportMissingSuperCall": "warning",
    "basedpyright.reportUninitializedInstanceVariable": "warning",
    "basedpyright.reportInvalidStringEscapeSequence": "error",
    "basedpyright.reportUnknownParameterType": "warning",
    "basedpyright.reportUnknownArgumentType": "warning",
    "basedpyright.reportUnknownLambdaType": "warning",
    "basedpyright.reportUnknownVariableType": "warning",
    "basedpyright.reportUnknownMemberType": "warning",
    "basedpyright.reportMissingParameterType": "warning",
    "basedpyright.reportMissingTypeArgument": "warning",
    "basedpyright.reportInvalidTypeVarUse": "error",
    "basedpyright.reportCallInDefaultInitializer": "warning",
    "basedpyright.reportUnnecessaryIsInstance": "warning",
    "basedpyright.reportUnnecessaryCast": "warning",
    "basedpyright.reportUnnecessaryComparison": "warning",
    "basedpyright.reportAssertAlwaysTrue": "warning",
    "basedpyright.reportSelfClsParameterName": "warning",
    "basedpyright.reportImplicitStringConcatenation": "warning",
    "basedpyright.reportUndefinedVariable": "error",
    "basedpyright.reportUnboundVariable": "error",
    "basedpyright.reportInvalidStubStatement": "error",
    "basedpyright.reportIncompleteStub": "warning",
    "basedpyright.reportUnsupportedDunderAll": "warning",
    "basedpyright.reportUnusedCoroutine": "warning",
    "files.associations": {
        "*.py": "python",
        "*.pyi": "python",
        "*.toml": "toml",
        "*.yaml": "yaml",
        "*.yml": "yaml"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/node_modules": true,
        "**/build": true,
        "**/dist": true,
        "**/*.pyc": true,
        "**/*.pyo": true
    },
    "python.analysis.autoImportCompletions": false,
    "python.analysis.autoSearchPaths": false,
    "python.analysis.includeFileSpecs": [
        "**/src/**/*.py",
        "**/tests/**/*.py"
    ],
    "python.analysis.excludeFileSpecs": [
        "**/__pycache__/**",
        "**/.venv/**",
        "**/node_modules/**",
        "**/build/**",
        "**/dist/**",
        "**/examples/**",
        "**/scripts/**",
        "**/*.pb2.py",
        "**/*.pb2_grpc.py"
    ],
    "python.analysis.memory.keepLibraryAst": false,
    "python.analysis.memory.keepLibrarySymbols": false,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.userFileIndexingLimit": 2000,
    "python.analysis.packageIndexDepths": [
        {
            "name": "flext-core",
            "depth": 2,
            "includeFileSpecs": ["**/src/**/*.py"]
        },
        {
            "name": "flext-cli",
            "depth": 1,
            "includeFileSpecs": ["**/src/**/*.py"]
        },
        {
            "name": "flext-api",
            "depth": 1,
            "includeFileSpecs": ["**/src/**/*.py"]
        },
        {
            "name": "flext-auth",
            "depth": 1,
            "includeFileSpecs": ["**/src/**/*.py"]
        },
        {
            "name": "flext-meltano",
            "depth": 1,
            "includeFileSpecs": ["**/src/**/*.py"]
        }
    ]
}
