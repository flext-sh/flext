  "chat.tools.terminal.autoApprove": {
    "/^cd /home/marlonsc/flext && python3 - << 'PY'\nfrom pathlib import Path\nimport re\n\nbase = Path\\('\\.'\\)\nmodules = \\['constants\\.py','models\\.py','protocols\\.py','typings\\.py','utilities\\.py'\\]\nissues=\\[\\]\nfor tests_dir in sorted\\(base\\.glob\\('\\*/tests'\\)\\):\n    for name in modules:\n        fp=tests_dir/name\n        if not fp\\.exists\\(\\):\n            continue\n        text=fp\\.read_text\\(encoding='utf-8'\\)\n        top_classes=re\\.findall\\(r'\\^class\\\\s\\+\\\\w\\+', text, flags=re\\.M\\)\n        # only non-indented due \\^class\n        if len\\(top_classes\\)!=1:\n            issues\\.append\\(\\(str\\(fp\\), f'top_class_count=\\{len\\(top_classes\\)\\}'\\)\\)\n        alias=\\{'constants\\.py':'c','models\\.py':'m','protocols\\.py':'p','typings\\.py':'t','utilities\\.py':'u'\\}\\[name\\]\n        if not re\\.search\\(rf'\\^\\{alias\\}\\\\s\\*=\\\\s\\*\\\\w\\+', text, flags=re\\.M\\):\n            issues\\.append\\(\\(str\\(fp\\), f'missing_alias=\\{alias\\}'\\)\\)\n\nprint\\(f'issues=\\{len\\(issues\\)\\}'\\)\nfor p,i in issues:\n    print\\(p, i\\)\nPY$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^cd /home/marlonsc/flext && python3 - << 'PY'\nfrom pathlib import Path\nimport re\n\nROOT=Path\\('\\.'\\)\n\n# conservative alias replacements inside imports only\nalias_map=\\{\n    'FlextTestsDomains':'td',\n    'FlextTestsFiles':'tf',\n    'FlextTestsFactories':'tt',\n    'FlextTestsValidator':'tv',\n    'FlextTestsBuilders':'tb',\n    'FlextTestsDocker':'tk',\n    'FlextTestsMatchers':'tm',\n    'FlextTestsConstants':'c',\n    'FlextTestsModels':'m',\n    'FlextTestsProtocols':'p',\n    'FlextTestsTypes':'t',\n    'FlextTestsUtilities':'u',\n    'FlextTestsServiceBase':'s',\n\\}\n\n# normalize from tests\\.<module> import alias -> from tests import alias\nmod_alias = \\{\n    'models':'m',\n    'constants':'c',\n    'typings':'t',\n    'protocols':'p',\n    'utilities':'u',\n\\}\n\nchanged=\\[\\]\nfor fp in ROOT\\.rglob\\('\\*\\.py'\\):\n    if '/tests/' not in fp\\.as_posix\\(\\) and not fp\\.as_posix\\(\\)\\.endswith\\('/tests\\.py'\\):\n        continue\n    if '\\.venv/' in fp\\.as_posix\\(\\):\n        continue\n    text=fp\\.read_text\\(encoding='utf-8'\\)\n    orig=text\n\n    # 1\\) replace src imports in tests only\n    text=re\\.sub\\(r'\\^\\(from\\\\s\\+\\)src\\\\\\.\\(flext_\\[\\\\w\\\\\\.\\]\\+\\\\s\\+import\\\\s\\+\\)', r'\\\\1\\\\2', text, flags=re\\.M\\)\n\n    # 2\\) rewrite flext_tests symbol names to aliases within from-import line\n    def repl_flext_tests\\(m: re\\.Match\\[str\\]\\) -> str:\n        items=\\[x\\.strip\\(\\) for x in m\\.group\\(1\\)\\.split\\(','\\)\\]\n        new_items=\\[\\]\n        for it in items:\n            new_items\\.append\\(alias_map\\.get\\(it,it\\)\\)\n        # remove dups preserve order\n        seen=set\\(\\); out=\\[\\]\n        for it in new_items:\n            if it not in seen:\n                seen\\.add\\(it\\); out\\.append\\(it\\)\n        return f\"from flext_tests import \\{', '\\.join\\(out\\)\\}\"\n\n    text=re\\.sub\\(r'\\^from\\\\s\\+flext_tests\\\\s\\+import\\\\s\\+\\(\\[\\^\\\\n\\]\\+\\)\\$', repl_flext_tests, text, flags=re\\.M\\)\n\n    # 3\\) normalize local tests imports for canonical aliases\n    for mod,alias in mod_alias\\.items\\(\\):\n        text=re\\.sub\\(\n            rf'\\^from\\\\s\\+tests\\\\\\.\\{mod\\}\\\\s\\+import\\\\s\\+\\{alias\\}\\$',\n            f'from tests import \\{alias\\}',\n            text,\n            flags=re\\.M,\n        \\)\n\n    # 4\\) merge duplicate identical import lines\n    lines=text\\.splitlines\\(\\)\n    dedup=\\[\\]\n    prev=None\n    for ln in lines:\n        if ln==prev and ln\\.startswith\\('from '\\):\n            continue\n        dedup\\.append\\(ln\\)\n        prev=ln\n    text='\\\\n'\\.join\\(dedup\\)\\+\\('\\\\n' if text\\.endswith\\('\\\\n'\\) else ''\\)\n\n    if text!=orig:\n        fp\\.write_text\\(text,encoding='utf-8'\\)\n        changed\\.append\\(fp\\.as_posix\\(\\)\\)\n\nprint\\(f'changed_files=\\{len\\(changed\\)\\}'\\)\nfor p in changed\\[:200\\]:\n    print\\(p\\)\nPY$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}