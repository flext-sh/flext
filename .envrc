# =============================================================================
# FLEXT Workspace — direnv environment
# =============================================================================
# Loaded automatically by:
#   - shell (direnv hook)
#   - opencode (@simonwjackson/opencode-direnv plugin)
#
# After editing: direnv allow
# =============================================================================

# --- Strict mode (direnv-safe) ---
strict_env

# --- Python virtual environment ---
# Reuse the workspace .venv created by uv / python3.13 -m venv.
# We do NOT call layout_python — that would create a second venv.
VENV_DIR="${PWD}/.venv"

if [[ -d "${VENV_DIR}" ]]; then
  export VIRTUAL_ENV="${VENV_DIR}"
  PATH_add "${VENV_DIR}/bin"

  # Resolve the real Python version from the venv.
  PYTHON_VERSION="$(${VENV_DIR}/bin/python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null || echo '3.13')"
  export PYTHON_VERSION
else
  log_error ".venv not found – run: uv venv && uv sync"
fi

# --- Poetry / uv: workspace-mode flags ---
# Match Makefile conventions (POETRY_ENV in root Makefile).
export POETRY_VIRTUALENVS_CREATE=false
export POETRY_VIRTUALENVS_IN_PROJECT=false
export POETRY_VIRTUALENVS_PATH="${PWD}"
export PYTHON_KEYRING_BACKEND="keyring.backends.null.Keyring"

# --- uv integration ---
export UV_PROJECT_ENVIRONMENT="${VENV_DIR}"

# --- Python runtime knobs ---
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="${PWD}/src${PYTHONPATH:+:${PYTHONPATH}}"

# --- Go workspace (flexcore / cmd) ---
if [[ -f "${PWD}/go.mod" ]]; then
  export GOFLAGS="-mod=mod"
  PATH_add "${PWD}/bin"
fi

# --- Project workspace bin ---
PATH_add bin

# --- Informational (logged once per allow) ---
log_status "flext workspace activated (python ${PYTHON_VERSION:-?}, venv ${VENV_DIR})"
