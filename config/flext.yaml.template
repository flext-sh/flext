# FLEXT Service Configuration Template
# This configuration is used in Docker containers and can be overridden via environment variables

app:
  mode: "${FLEXT_MODE:-server}"
  environment: "${FLEXT_ENVIRONMENT:-production}"
  debug: "${FLEXT_DEBUG:-false}"

server:
  host: "${FLEXT_HOST:-0.0.0.0}"
  port: "${FLEXT_PORT:-8080}"
  timeout: "${FLEXT_TIMEOUT:-30s}"
  read_timeout: "${FLEXT_READ_TIMEOUT:-30s}"
  write_timeout: "${FLEXT_WRITE_TIMEOUT:-30s}"

database:
  url: "${FLEXT_DATABASE_URL:-postgresql://postgres:password@postgres:5432/flext?sslmode=disable}"
  pool_size: "${FLEXT_DB_POOL_SIZE:-20}"
  max_idle_conns: "${FLEXT_DB_MAX_IDLE:-10}"
  max_open_conns: "${FLEXT_DB_MAX_OPEN:-20}"
  conn_max_lifetime: "${FLEXT_DB_CONN_LIFETIME:-1h}"

redis:
  url: "${FLEXT_REDIS_URL:-redis://redis:6379/0}"
  pool_size: "${FLEXT_REDIS_POOL_SIZE:-10}"
  max_retries: "${FLEXT_REDIS_MAX_RETRIES:-3}"

logging:
  level: "${FLEXT_LOG_LEVEL:-info}"
  format: "${FLEXT_LOG_FORMAT:-json}"
  structured: "${FLEXT_LOG_STRUCTURED:-true}"
  output: "${FLEXT_LOG_OUTPUT:-stdout}"

plugins:
  directory: "${FLEXT_PLUGINS_DIR:-/var/lib/flext/plugins}"
  auto_discover: "${FLEXT_PLUGINS_AUTO_DISCOVER:-true}"
  timeout: "${FLEXT_PLUGINS_TIMEOUT:-60s}"

pipelines:
  workspace: "${FLEXT_WORKSPACE:-/var/lib/flext/pipelines}"
  max_concurrent: "${FLEXT_MAX_CONCURRENT_PIPELINES:-10}"
  execution_timeout: "${FLEXT_PIPELINE_TIMEOUT:-1h}"

security:
  enable_auth: "${FLEXT_ENABLE_AUTH:-false}"
  jwt_secret: "${FLEXT_JWT_SECRET:-change-me-in-production}"
  rate_limit: "${FLEXT_RATE_LIMIT:-100}"
  cors_enabled: "${FLEXT_CORS_ENABLED:-true}"
  cors_origins: "${FLEXT_CORS_ORIGINS:-*}"

metrics:
  enabled: "${FLEXT_METRICS_ENABLED:-true}"
  endpoint: "${FLEXT_METRICS_ENDPOINT:-/metrics}"
  namespace: "${FLEXT_METRICS_NAMESPACE:-flext}"

tracing:
  enabled: "${FLEXT_TRACING_ENABLED:-false}"
  jaeger_endpoint: "${FLEXT_JAEGER_ENDPOINT:-http://jaeger:14268/api/traces}"
  sample_rate: "${FLEXT_TRACE_SAMPLE_RATE:-0.1}"