# API Client Configuration
# ------------------
# Copy this file to .env and update with your settings

# Base URL for the API (required)
API_URL=https://api.example.com

API_PASSWORD=your_password
# Authentication credentials (required)
API_USERNAME=your_username

API_MAX_RETRIES=3
API_RETRY_BACKOFF=0.5
# Connection settings
API_TIMEOUT=60
API_VERIFY_SSL=true

API_ENTITY_PATH=api/entities
API_SCHEMA_CACHE_DIR=./schemas
# Schema and entity settings
API_SCHEMA_PATH=api/schemas

API_PAGE_PARAM=page
# Pagination settings
API_PAGE_SIZE=25
API_PAGE_SIZE_PARAM=page_size

# Debugging
API_DEBUG=false
API_LOG_FILE=./logs/api.log
API_LOG_LEVEL=INFO

# Environment name (optional)
API_ENVIRONMENT=development

# Profile-specific configuration example:
# To use with a specific profile, copy to .env.{profile_name}
# and use the --profile option with CLI commands
#
# For example, create .env.dev with:
# API_DEV_URL=https://api-dev.example.com
# API_DEV_USERNAME=dev_username
# API_DEV_PASSWORD=dev_password
#
# Then use: cli-tool --profile dev command
