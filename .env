# FLEXT Workspace Environment Configuration
# ==========================================

DEBUG_MODE=true
PYTHON_VERSION=3.13
PYTHON_VENV=/home/marlonsc/flext/.venv


# WORKSPACE CONFIGURATION (Required for all projects)
WORKSPACE_ROOT=/home/marlonsc/flext
FLEXT_STRICT_MODE=true

FLEXT_HOST=localhost
FLEXT_LOG_FORMAT=json
FLEXT_LOG_LEVEL=info
# GO API SERVER CONFIGURATION
FLEXT_PORT=8081

# DATABASE CONFIGURATION
FLEXT_DB_TYPE=memory
FLEXT_DB_URL=postgres://flext:flext@localhost:5432/flext_db

JWT_ALGORITHM=RS256
JWT_EXPIRATION_HOURS=24
# AUTHENTICATION CONFIGURATION (flext-auth)
JWT_SECRET_KEY=your-secret-key-change-in-production
REDIS_URL=redis://localhost:6379/0
TOKEN_STORAGE_TYPE=redis

MELTANO_ENVIRONMENT=dev
# MELTANO CONFIGURATION (flext-meltano)
SINGER_SDK_LOG_LEVEL=DEBUG

# ORACLE DATABASE CONFIGURATION (flext-db-oracle)
ORACLE_HOST=localhost
ORACLE_PASSWORD=flext_password
ORACLE_POOL_SIZE=10
ORACLE_POOL_TIMEOUT=30
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
ORACLE_USERNAME=flext_user

LDAP_BASE_DN=dc=ctbc
LDAP_BIND_DN=cn=orclREDACTED_LDAP_BIND_PASSWORD
LDAP_BIND_PASSWORD=iDm55OID
# LDAP CONFIGURATION (flext-ldap)
LDAP_HOST=localhost
LDAP_PORT=3389
LDAP_USE_SSL=false

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_METRICS_EXPORTER=prometheus
OTEL_SERVICE_NAME=flext
OTEL_TRACES_EXPORTER=otlp
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
# OBSERVABILITY CONFIGURATION (flext-observability)
PROMETHEUS_PORT=9090

GRPC_HEALTH_CHECK=true
# GRPC CONFIGURATION (flext-grpc)
GRPC_PORT=50051
GRPC_REFLECTION=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DATABASE_URL=postgres://flext:flext@localhost:5432/flext_web
DJANGO_DEBUG=true
# WEB CONFIGURATION (flext-web)
DJANGO_SECRET_KEY=your-django-secret-key

PLUGIN_AUTO_RELOAD=true
# PLUGIN CONFIGURATION (flext-plugin)
PLUGIN_DIRECTORY=/opt/flext/plugins
PLUGIN_WATCH_ENABLED=true

# ENTERPRISE INTEGRATION CONFIGURATION
client-a_OUD_MIGRATION_ENABLED=false
client-b_OIC_WMS_ENABLED=false

BLACK_FORMAT=true
# DEVELOPMENT CONFIGURATION
COVERAGE_REPORT=true
MYPY_STRICT=true
PYTEST_VERBOSE=true
RUFF_FIX=true

# SECURITY CONFIGURATION
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

LOG_FILE_PATH=/var/log/flext/flext.log
LOG_FORMAT=structured
# LOGGING CONFIGURATION
LOG_LEVEL=INFO
LOG_OUTPUT=file
LOG_RETENTION_DAYS=30
LOG_ROTATION_SIZE=100MB
