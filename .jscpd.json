{
  "//": "jscpd configuration for FLEXT workspace. Detects code duplication across Python source trees.",
  "absolute": true,
  "noTips": true,
  "noColors": true,
  "mode": "strict",
  "ignore": [
    "**/__pycache__/**",
    "**/target/**",
    "**/*.pyc",
    "**/*.bak",
    "**/*.tmp",
    "**/*.orig",
    "**/.venv/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.eggs/**",
    "**/__snapshots__/**",
    "**/__init__.py",
    "**/.github/**",
    "**/.claude/**",
    "**/.agents/**",
    "**/.cursor/**",
    "**/.codex/**",
    "**/skills/**",
    "Makefile",
    "LICENSE.md"
  ],
  "reporters": ["console"],
  "minLines": 8
}
