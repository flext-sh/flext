{
  "//": "jscpd configuration for FLEXT workspace. Detects code duplication across Python source trees.",
  "absolute": true,
  "noTips": true,
  "noColors": true,
  "mode": "strict",
  "ignore": [
    "**/__pycache__/**",
    "**/target/**",
    "**/*.pyc",
    "**/*.bak",
    "**/*.tmp",
    "**/*.orig",
    "**/.venv/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.eggs/**",
    "**/__snapshots__/**",
    "**/__init__.py",
    "**/.github/**",
    "**/generated/**",
    "**/.claude/**",
    "**/.opencode/**",
    "**/.agents/**",
    "**/.cursor/**",
    "**/.codex/**",
    "**/skills/**",
    "**/bin/mise",
    "**/_base/**",
    "**/_container/**",
    "**/_exception_params/**",
    "**/_parts/**",
    "**/*_parts/**",
    "mkdocs.yml",
    "pyproject.toml",
    ".pre-commit-config.yaml",
    "**/.vscode/**",
    "**/.gemini/**",
    "**/.kilo/**",
    "**/.claude/worktrees/**",
    "**/*.worktree",
    "docs/plans/**",
    "beads-reval*.json",
    "beads-reval*.csv",
    "Makefile",
    "LICENSE.md"
  ],
  "reporters": ["console"],
  "minLines": 8
}
