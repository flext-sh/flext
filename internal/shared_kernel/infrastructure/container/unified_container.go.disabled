package container

import (
	"context"
	"fmt"
	"sync"

	// Shared kernel imports
	sharedConfig "github.com/flext-sh/flext/internal/shared_kernel/config"
	"github.com/flext-sh/flext/internal/shared_kernel/infrastructure/auth"
	"github.com/flext-sh/flext/internal/shared_kernel/infrastructure/persistence"
	sharedHttp "github.com/flext-sh/flext/internal/shared_kernel/infrastructure/http"
	"github.com/flext-sh/flext/internal/shared_kernel/infrastructure/config"

	// Bounded context imports
	pipelineApp "github.com/flext-sh/flext/internal/bounded_contexts/pipeline/application"
	pipelinePorts "github.com/flext-sh/flext/internal/bounded_contexts/pipeline/application/ports"
	pipelineServices "github.com/flext-sh/flext/internal/bounded_contexts/pipeline/domain/services"

	pluginApp "github.com/flext-sh/flext/internal/bounded_contexts/plugin/application"
	pluginPorts "github.com/flext-sh/flext/internal/bounded_contexts/plugin/application/ports"

	// Infrastructure imports
	"github.com/flext-sh/flext/internal/infrastructure/database"
	"github.com/flext-sh/flext/internal/infrastructure/events"
	"github.com/flext-sh/flext/internal/infrastructure/logging"

	"github.com/pkg/errors"
)

// UnifiedContainer provides dependency injection using unified configuration
type UnifiedContainer struct {
	mu sync.RWMutex

	// Configuration
	configAdapter *config.ConfigAdapter
	
	// Shared Infrastructure
	authService    *auth.UnifiedAuthService
	eventPublisher events.EventPublisher
	logger         logging.Logger
	dbConnection   *database.Connection

	// Unified repositories
	unifiedPipelineRepo *persistence.UnifiedRepository[pipelinePorts.Pipeline]
	unifiedPluginRepo   *persistence.UnifiedRepository[pluginPorts.Plugin]

	// Legacy repositories for compatibility
	pipelineRepo pipelinePorts.PipelineRepository
	pluginRepo   pluginPorts.PluginRepository

	// Domain Services
	pipelineExecutor *pipelineServices.PipelineExecutor

	// Application Services
	pipelineService *pipelineApp.PipelineService
	pluginService   *pluginApp.PluginService

	// HTTP Infrastructure
	unifiedHandler *sharedHttp.UnifiedHandler
}

// NewUnifiedContainer creates a new container with unified configuration
func NewUnifiedContainer() (*UnifiedContainer, error) {
	// Load unified configuration
	configAdapter, err := config.NewConfigAdapter()
	if err != nil {
		return nil, fmt.Errorf("failed to create config adapter: %w", err)
	}

	container := &UnifiedContainer{
		configAdapter: configAdapter,
	}

	if err := container.initializeInfrastructure(); err != nil {
		return nil, fmt.Errorf("failed to initialize infrastructure: %w", err)
	}

	if err := container.initializeRepositories(); err != nil {
		return nil, fmt.Errorf("failed to initialize repositories: %w", err)
	}

	if err := container.initializeServices(); err != nil {
		return nil, fmt.Errorf("failed to initialize services: %w", err)
	}

	if err := container.initializeHandlers(); err != nil {
		return nil, fmt.Errorf("failed to initialize handlers: %w", err)
	}

	return container, nil
}

// initializeInfrastructure sets up shared infrastructure components
func (c *UnifiedContainer) initializeInfrastructure() error {
	// Logger
	c.logger = logging.GetLogger()

	// Event Publisher
	c.eventPublisher = events.NewInMemoryEventPublisher()

	// Database connection
	if c.configAdapter.GetFeatureFlags().DatabaseEnabled {
		dbConfig := c.configAdapter.GetLegacyConfig().Database
		dbConn, err := database.NewConnection(&dbConfig, c.logger)
		if err != nil {
			c.logger.Warn("Failed to create database connection, using memory mode",
				logging.F("error", err.Error()))
		} else {
			c.dbConnection = dbConn
		}
	}

	// Unified Auth Service
	authConfig := c.configAdapter.GetAuthConfig()
	authSvc, err := auth.NewUnifiedAuthService(
		[]byte(authConfig.JWTSecret),
		authConfig.JWTExpiry,
		authConfig.RefreshExpiry,
		c.logger,
	)
	if err != nil {
		return fmt.Errorf("failed to create auth service: %w", err)
	}
	c.authService = authSvc

	// Register auth providers based on configuration
	if authConfig.EnableBasicAuth {
		provider := auth.NewBasicAuthProvider()
		c.authService.RegisterProvider("basic", provider)
		c.logger.Info("Basic auth provider registered")
	}

	if authConfig.EnableAPIKeys {
		provider := auth.NewAPIKeyProvider()
		c.authService.RegisterProvider("apikey", provider)
		c.logger.Info("API key provider registered")
	}

	if authConfig.EnableOAuth2 {
		provider := auth.NewOAuth2Provider(authConfig.OAuth2Config)
		c.authService.RegisterProvider("oauth2", provider)
		c.logger.Info("OAuth2 provider registered")
	}

	c.logger.Info("Infrastructure initialized successfully")
	return nil
}

// initializeRepositories sets up repository layer
func (c *UnifiedContainer) initializeRepositories() error {
	// Create unified repositories with caching and auditing
	cacheConfig := c.configAdapter.GetCacheConfig()
	
	// Pipeline repository
	if c.dbConnection != nil {
		// TODO: Create GORM-based unified repository when interfaces are aligned
		c.logger.Info("Using in-memory pipeline repository (GORM integration pending)")
	}
	
	// Use in-memory repositories with unified interface
	memPipelineRepo := persistence.NewInMemoryPipelineRepository()
	memPluginRepo := persistence.NewInMemoryPluginRepository()

	// Wrap in unified repository for enhanced features
	c.unifiedPipelineRepo = persistence.NewUnifiedRepository[pipelinePorts.Pipeline](
		memPipelineRepo,
		cacheConfig.TTL,
		c.configAdapter.GetPipelineConfig().EnableAudit,
		c.logger,
	)

	c.unifiedPluginRepo = persistence.NewUnifiedRepository[pluginPorts.Plugin](
		memPluginRepo,
		cacheConfig.TTL,
		true, // Enable audit for plugins
		c.logger,
	)

	// Set legacy repository references for backward compatibility
	c.pipelineRepo = memPipelineRepo
	c.pluginRepo = memPluginRepo

	c.logger.Info("Repositories initialized with unified interface")
	return nil
}

// initializeServices sets up application and domain services
func (c *UnifiedContainer) initializeServices() error {
	// Domain Services
	c.pipelineExecutor = pipelineServices.NewPipelineExecutor(
		c.pluginRepo.(pipelineServices.PluginRepository),
	)

	// Application Services
	c.pipelineService = pipelineApp.NewPipelineService(c.pipelineRepo, c.pipelineExecutor)

	// Create event publisher adapter for plugin service
	eventAdapter := NewEventPublisherAdapter(c.eventPublisher)
	c.pluginService = pluginApp.NewPluginService(c.pluginRepo, eventAdapter)

	c.logger.Info("Application services initialized")
	return nil
}

// initializeHandlers sets up HTTP handlers
func (c *UnifiedContainer) initializeHandlers() error {
	// Create unified handler base
	c.unifiedHandler = sharedHttp.NewUnifiedHandler("unified-container", c.logger)

	c.logger.Info("HTTP handlers initialized with unified base")
	return nil
}

// GetConfigAdapter returns the configuration adapter
func (c *UnifiedContainer) GetConfigAdapter() *config.ConfigAdapter {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.configAdapter
}

// GetAuthService returns the unified auth service
func (c *UnifiedContainer) GetAuthService() *auth.UnifiedAuthService {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.authService
}

// GetUnifiedHandler returns the unified HTTP handler base
func (c *UnifiedContainer) GetUnifiedHandler() *sharedHttp.UnifiedHandler {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.unifiedHandler
}

// GetPipelineService returns the pipeline application service
func (c *UnifiedContainer) GetPipelineService() *pipelineApp.PipelineService {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.pipelineService
}

// GetPluginService returns the plugin application service
func (c *UnifiedContainer) GetPluginService() *pluginApp.PluginService {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.pluginService
}

// GetUnifiedPipelineRepo returns the unified pipeline repository
func (c *UnifiedContainer) GetUnifiedPipelineRepo() *persistence.UnifiedRepository[pipelinePorts.Pipeline] {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.unifiedPipelineRepo
}

// GetUnifiedPluginRepo returns the unified plugin repository
func (c *UnifiedContainer) GetUnifiedPluginRepo() *persistence.UnifiedRepository[pluginPorts.Plugin] {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.unifiedPluginRepo
}

// Legacy compatibility methods

// GetPipelineRepo returns the legacy pipeline repository interface
func (c *UnifiedContainer) GetPipelineRepo() pipelinePorts.PipelineRepository {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.pipelineRepo
}

// GetPluginRepo returns the legacy plugin repository interface
func (c *UnifiedContainer) GetPluginRepo() pluginPorts.PluginRepository {
	c.mu.RLock()
	defer c.mu.RUnlock()
	return c.pluginRepo
}

// HealthCheck performs health checks on all components
func (c *UnifiedContainer) HealthCheck(ctx context.Context) error {
	// Check database connection
	if c.dbConnection != nil {
		if err := c.dbConnection.HealthCheck(ctx); err != nil {
			return fmt.Errorf("database health check failed: %w", err)
		}
	}

	// Check auth service
	if c.authService == nil {
		return fmt.Errorf("auth service not initialized")
	}

	// Check repositories
	if c.unifiedPipelineRepo == nil || c.unifiedPluginRepo == nil {
		return fmt.Errorf("repositories not initialized")
	}

	// Check services
	if c.pipelineService == nil || c.pluginService == nil {
		return fmt.Errorf("application services not initialized")
	}

	c.logger.Info("Health check completed successfully")
	return nil
}

// Shutdown gracefully shuts down the container
func (c *UnifiedContainer) Shutdown() error {
	c.logger.Info("Shutting down unified container")

	// Close database connection
	if c.dbConnection != nil {
		if err := c.dbConnection.Close(); err != nil {
			c.logger.Error("Failed to close database connection",
				logging.F("error", err.Error()))
			return err
		}
	}

	// TODO: Add shutdown for other components as needed

	c.logger.Info("Unified container shutdown completed")
	return nil
}

// EventPublisherAdapter adapts the legacy event publisher to new interface
type EventPublisherAdapter struct {
	publisher events.EventPublisher
}

// NewEventPublisherAdapter creates a new event publisher adapter
func NewEventPublisherAdapter(publisher events.EventPublisher) *EventPublisherAdapter {
	return &EventPublisherAdapter{publisher: publisher}
}

// Publish publishes an event
func (a *EventPublisherAdapter) Publish(ctx context.Context, event interface{}) error {
	return a.publisher.Publish(ctx, event)
}

// Subscribe subscribes to events
func (a *EventPublisherAdapter) Subscribe(eventType string, handler func(interface{}) error) error {
	return a.publisher.Subscribe(eventType, handler)
}