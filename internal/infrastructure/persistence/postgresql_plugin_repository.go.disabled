package persistence

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"fmt"
	"time"

	"github.com/google/uuid"
	"github.com/lib/pq"

	"github.com/flext-sh/flext/internal/bounded_contexts/plugin/application/ports"
	"github.com/flext-sh/flext/internal/bounded_contexts/plugin/domain/entities"
	"github.com/flext-sh/flext/internal/infrastructure/database"
	"github.com/flext-sh/flext/internal/infrastructure/logging"
)

// pluginModel representa o modelo de dados do plugin no banco
type pluginModel struct {
	ID           string         `json:"id"`
	Name         string         `json:"name"`
	Type         string         `json:"type"`
	Version      string         `json:"version"`
	Description  *string        `json:"description"`
	Author       *string        `json:"author"`
	Status       string         `json:"status"`
	EntryPoint   string         `json:"entry_point"`
	Dependencies []string       `json:"dependencies"`
	Config       map[string]any `json:"configuration"`
	Metadata     map[string]any `json:"metadata"`
	CreatedAt    time.Time      `json:"created_at"`
	UpdatedAt    time.Time      `json:"updated_at"`
}

// pluginPortModel representa as portas do plugin
type pluginPortModel struct {
	ID          string         `json:"id"`
	PluginID    string         `json:"plugin_id"`
	Name        string         `json:"name"`
	Type        string         `json:"type"`
	Required    bool           `json:"required"`
	Description *string        `json:"description"`
	Schema      map[string]any `json:"schema"`
	CreatedAt   time.Time      `json:"created_at"`
}

// PostgreSQLPluginRepository implementa PluginRepository usando PostgreSQL
type PostgreSQLPluginRepository struct {
	db     database.DB
	logger logging.Logger
}

// NewPostgreSQLPluginRepository cria um novo repository PostgreSQL
func NewPostgreSQLPluginRepository(db database.DB, logger logging.Logger) *PostgreSQLPluginRepository {
	return &PostgreSQLPluginRepository{
		db:     db,
		logger: logger,
	}
}

// Save salva um plugin no banco de dados
func (r *PostgreSQLPluginRepository) Save(ctx context.Context, plugin *entities.Plugin) error {
	exists, err := r.exists(ctx, plugin.ID)
	if err != nil {
		return fmt.Errorf("failed to check plugin existence: %w", err)
	}

	if exists {
		return r.update(ctx, plugin)
	}

	return r.insert(ctx, plugin)
}

// GetByID encontra um plugin pelo ID
func (r *PostgreSQLPluginRepository) GetByID(ctx context.Context, id uuid.UUID) (*entities.Plugin, error) {
	query := `
		SELECT id, name, type, version, description, author, status, entry_point, 
		       dependencies, configuration, metadata, created_at, updated_at
		FROM plugins 
		WHERE id = $1
	`

	var model pluginModel
	var description, author sql.NullString
	var configJSON, metadataJSON []byte

	err := r.db.QueryRowContext(ctx, query, id.String()).Scan(
		&model.ID,
		&model.Name,
		&model.Type,
		&model.Version,
		&description,
		&author,
		&model.Status,
		&model.EntryPoint,
		pq.Array(&model.Dependencies),
		&configJSON,
		&metadataJSON,
		&model.CreatedAt,
		&model.UpdatedAt,
	)

	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, nil
		}
		return nil, fmt.Errorf("failed to query plugin: %w", err)
	}

	if description.Valid {
		model.Description = &description.String
	}
	if author.Valid {
		model.Author = &author.String
	}

	// Parse JSON fields
	if err := json.Unmarshal(configJSON, &model.Config); err != nil {
		return nil, fmt.Errorf("failed to parse configuration JSON: %w", err)
	}

	if err := json.Unmarshal(metadataJSON, &model.Metadata); err != nil {
		return nil, fmt.Errorf("failed to parse metadata JSON: %w", err)
	}

	// Carregar portas do plugin
	ports, err := r.findPortsByPluginID(ctx, id)
	if err != nil {
		return nil, fmt.Errorf("failed to load plugin ports: %w", err)
	}

	return r.modelToDomain(&model, ports)
}

// GetByName encontra um plugin pelo nome
func (r *PostgreSQLPluginRepository) GetByName(ctx context.Context, name string) (*entities.Plugin, error) {
	query := `
		SELECT id, name, type, version, description, author, status, entry_point, 
		       dependencies, configuration, metadata, created_at, updated_at
		FROM plugins 
		WHERE name = $1
	`

	var model pluginModel
	var description, author sql.NullString
	var configJSON, metadataJSON []byte

	err := r.db.QueryRowContext(ctx, query, name).Scan(
		&model.ID,
		&model.Name,
		&model.Type,
		&model.Version,
		&description,
		&author,
		&model.Status,
		&model.EntryPoint,
		pq.Array(&model.Dependencies),
		&configJSON,
		&metadataJSON,
		&model.CreatedAt,
		&model.UpdatedAt,
	)

	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, nil
		}
		return nil, fmt.Errorf("failed to query plugin by name: %w", err)
	}

	if description.Valid {
		model.Description = &description.String
	}
	if author.Valid {
		model.Author = &author.String
	}

	// Parse JSON fields
	if err := json.Unmarshal(configJSON, &model.Config); err != nil {
		return nil, fmt.Errorf("failed to parse configuration JSON: %w", err)
	}

	if err := json.Unmarshal(metadataJSON, &model.Metadata); err != nil {
		return nil, fmt.Errorf("failed to parse metadata JSON: %w", err)
	}

	// Carregar portas
	pluginID, _ := uuid.Parse(model.ID)
	ports, err := r.findPortsByPluginID(ctx, pluginID)
	if err != nil {
		return nil, fmt.Errorf("failed to load plugin ports: %w", err)
	}

	return r.modelToDomain(&model, ports)
}

// List retorna plugins com filtros
func (r *PostgreSQLPluginRepository) List(ctx context.Context, filter ports.ListPluginsFilter) ([]*entities.Plugin, int, error) {
	queryBuilder := r.buildListQuery(filter)
	
	total, err := r.countPlugins(ctx, queryBuilder)
	if err != nil {
		return nil, 0, err
	}
	
	plugins, err := r.queryPlugins(ctx, queryBuilder)
	if err != nil {
		return nil, 0, err
	}
	
	return plugins, total, nil
}

// QueryBuilder holds SQL query building context
type QueryBuilder struct {
	WhereClause string
	Args        []interface{}
	ArgIndex    int
	Limit       int
	Offset      int
}

// buildListQuery constructs the query parameters for listing plugins
func (r *PostgreSQLPluginRepository) buildListQuery(filter ports.ListPluginsFilter) *QueryBuilder {
	builder := &QueryBuilder{
		WhereClause: "WHERE 1=1",
		Args:        []interface{}{},
		ArgIndex:    1,
	}
	
	r.applyFilters(builder, filter)
	r.setPagination(builder, filter)
	
	return builder
}

// applyFilters adds WHERE conditions based on the filter
func (r *PostgreSQLPluginRepository) applyFilters(builder *QueryBuilder, filter ports.ListPluginsFilter) {
	if filter.Type != nil {
		builder.WhereClause += fmt.Sprintf(" AND type = $%d", builder.ArgIndex)
		builder.Args = append(builder.Args, string(*filter.Type))
		builder.ArgIndex++
	}

	if filter.Status != nil {
		builder.WhereClause += fmt.Sprintf(" AND status = $%d", builder.ArgIndex)
		builder.Args = append(builder.Args, string(*filter.Status))
		builder.ArgIndex++
	}

	if filter.Author != "" {
		builder.WhereClause += fmt.Sprintf(" AND author = $%d", builder.ArgIndex)
		builder.Args = append(builder.Args, filter.Author)
		builder.ArgIndex++
	}
}

// setPagination sets limit and offset with defaults
func (r *PostgreSQLPluginRepository) setPagination(builder *QueryBuilder, filter ports.ListPluginsFilter) {
	builder.Limit = filter.Limit
	if builder.Limit <= 0 {
		builder.Limit = 50 // default limit
	}
	
	builder.Offset = filter.Offset
	if builder.Offset < 0 {
		builder.Offset = 0
	}
}

// countPlugins executes the count query
func (r *PostgreSQLPluginRepository) countPlugins(ctx context.Context, builder *QueryBuilder) (int, error) {
	countQuery := fmt.Sprintf("SELECT COUNT(*) FROM plugins %s", builder.WhereClause)
	
	var total int
	err := r.db.QueryRowContext(ctx, countQuery, builder.Args...).Scan(&total)
	if err != nil {
		return 0, fmt.Errorf("failed to count plugins: %w", err)
	}
	
	return total, nil
}

// queryPlugins executes the main query and processes results
func (r *PostgreSQLPluginRepository) queryPlugins(ctx context.Context, builder *QueryBuilder) ([]*entities.Plugin, error) {
	query := r.buildMainQuery(builder)
	args := r.buildQueryArgs(builder)
	
	rows, err := r.db.QueryContext(ctx, query, args...)
	if err != nil {
		return nil, fmt.Errorf("failed to query plugins: %w", err)
	}
	defer rows.Close()
	
	return r.processPluginRows(rows)
}

// buildMainQuery constructs the main SELECT query
func (r *PostgreSQLPluginRepository) buildMainQuery(builder *QueryBuilder) string {
	return fmt.Sprintf(`
		SELECT id, name, type, version, description, author, status, entry_point, 
		       dependencies, configuration, metadata, created_at, updated_at
		FROM plugins 
		%s
		ORDER BY created_at DESC
		LIMIT $%d OFFSET $%d
	`, builder.WhereClause, builder.ArgIndex, builder.ArgIndex+1)
}

// buildQueryArgs prepares the final argument list for the query
func (r *PostgreSQLPluginRepository) buildQueryArgs(builder *QueryBuilder) []interface{} {
	return append(builder.Args, builder.Limit, builder.Offset)
}

// processPluginRows processes the SQL rows and converts to plugin entities
func (r *PostgreSQLPluginRepository) processPluginRows(rows *sql.Rows) ([]*entities.Plugin, error) {
	var plugins []*entities.Plugin
	
	for rows.Next() {
		plugin, err := r.scanPluginRow(rows)
		if err != nil {
			return nil, err
		}
		
		plugins = append(plugins, plugin)
	}
	
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("row iteration error: %w", err)
	}
	
	return plugins, nil
}

// scanPluginRow scans a single row into a plugin entity
func (r *PostgreSQLPluginRepository) scanPluginRow(rows *sql.Rows) (*entities.Plugin, error) {
	var model pluginModel
	var description, author sql.NullString
	var configJSON, metadataJSON []byte

	err := rows.Scan(
		&model.ID,
		&model.Name,
		&model.Type,
		&model.Version,
		&description,
		&author,
		&model.Status,
		&model.EntryPoint,
		pq.Array(&model.Dependencies),
		&configJSON,
		&metadataJSON,
		&model.CreatedAt,
		&model.UpdatedAt,
	)
	if err != nil {
		return nil, fmt.Errorf("failed to scan plugin row: %w", err)
	}
	
	if err := r.populateNullableFields(&model, description, author); err != nil {
		return nil, err
	}
	
	if err := r.parseJSONFields(&model, configJSON, metadataJSON); err != nil {
		return nil, err
	}

	return r.modelToDomain(&model, nil)
}

// populateNullableFields fills nullable fields from SQL nullable types
func (r *PostgreSQLPluginRepository) populateNullableFields(model *pluginModel, description, author sql.NullString) error {
	if description.Valid {
		model.Description = &description.String
	}
	if author.Valid {
		model.Author = &author.String
	}
	return nil
}

// parseJSONFields parses JSON data into the model
func (r *PostgreSQLPluginRepository) parseJSONFields(model *pluginModel, configJSON, metadataJSON []byte) error {
	if len(configJSON) > 0 {
		if err := json.Unmarshal(configJSON, &model.Config); err != nil {
			return fmt.Errorf("failed to parse configuration JSON: %w", err)
		}
	}
	
	if len(metadataJSON) > 0 {
		if err := json.Unmarshal(metadataJSON, &model.Metadata); err != nil {
			return fmt.Errorf("failed to parse metadata JSON: %w", err)
		}
	}
	
	return nil
}
