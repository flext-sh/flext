// CleanContainer contains all Clean Architecture components
type CleanContainer struct {
	config *config.Config
	db     *sql.DB

	// Event publisher
	eventPublisher EventPublisherInterface

	// Repositories
	pipelineRepo pipelineUC.PipelineRepository
	pluginRepo   pluginUC.PluginRepository
	dbtRepo      dbtUC.ProjectRepository
	meltanoRepo  meltanoUC.ProjectRepository

	// Use cases - Pipeline
	createPipelineUC  *pipelineUC.CreatePipelineUseCase
	executePipelineUC *pipelineUC.ExecutePipelineUseCase
	getPipelineUC     *pipelineUC.GetPipelineUseCase
	listPipelinesUC   *pipelineUC.ListPipelinesUseCase
	deletePipelineUC  *pipelineUC.DeletePipelineUseCase

	// Use cases - Plugin
	registerPluginUC *pluginUC.RegisterPluginUseCase
	getPluginUC      *pluginUC.GetPluginUseCase
	listPluginsUC    *pluginUC.ListPluginsUseCase
	deletePluginUC   *pluginUC.DeletePluginUseCase

	// Use cases - DBT
	createDbtProjectUC  *dbtUC.CreateProjectUseCase
	executeDbtProjectUC *dbtUC.ExecuteProjectUseCase
	getDbtProjectUC     *dbtUC.GetProjectUseCase
	listDbtProjectsUC   *dbtUC.ListProjectsUseCase
	deleteDbtProjectUC  *dbtUC.DeleteProjectUseCase

	// Use cases - Meltano
	createMeltanoProjectUC *meltanoUC.CreateProjectUseCase
	addMeltanoPluginUC     *meltanoUC.AddPluginUseCase
	runMeltanoPipelineUC   *meltanoUC.RunPipelineUseCase
	addMeltanoScheduleUC   *meltanoUC.AddScheduleUseCase
	getMeltanoProjectUC    *meltanoUC.GetProjectUseCase
	listMeltanoProjectsUC  *meltanoUC.ListProjectsUseCase
	deleteMeltanoProjectUC *meltanoUC.DeleteProjectUseCase

	// HTTP Handlers
	// cleanPipelineHandler *http.CleanPipelineHandler // DISABLED temporarily
	cleanPluginHandler   *http.CleanPluginHandler
	cleanDbtHandler      *http.CleanDbtHandler
	cleanMeltanoHandler  *http.CleanMeltanoHandler
}

// EventPublisherInterface unified interface for event publishing
type EventPublisherInterface interface {
	Publish(ctx context.Context, event interface{}) error
}

// NewCleanContainer creates a new Clean Architecture container
func NewCleanContainer(cfg *config.Config, db *sql.DB) (*CleanContainer, error) {
	container := &CleanContainer{
		config: cfg,
		db:     db,
	}

	if err := container.initializeComponents(); err != nil {
		return nil, errors.Wrap(err, "failed to initialize Clean Architecture components")
	}

	return container, nil
}

// initializeComponents initializes all Clean Architecture components
func (c *CleanContainer) initializeComponents() error {
	// Initialize event publisher
	eventPub := events.NewInMemoryEventPublisher()
	c.eventPublisher = &EventAdapter{publisher: eventPub}

	// Initialize repositories
	if err := c.initializeRepositories(); err != nil {
		return errors.Wrap(err, "failed to initialize repositories")
	}

	// Initialize validators
	validator := validation.NewValidator()

	// Initialize use cases
	if err := c.initializeUseCases(validator); err != nil {
		return errors.Wrap(err, "failed to initialize use cases")
	}

	// Initialize HTTP handlers
	c.initializeHandlers()

	return nil
}

// initializeRepositories creates repository implementations
func (c *CleanContainer) initializeRepositories() error {
	if c.db == nil {
		// Use in-memory repositories when database is not available
		c.pipelineRepo = &InMemoryPipelineRepository{}
		c.pluginRepo = &InMemoryPluginRepository{}
		c.dbtRepo = &InMemoryDbtRepository{}
		c.meltanoRepo = &InMemoryMeltanoRepository{}
		return nil
	}

	// Initialize PostgreSQL repositories
	c.pipelineRepo = postgresql.NewCleanPipelineRepository(c.db)
	c.pluginRepo = postgresql.NewCleanPluginRepository(c.db)

	// TODO: Initialize DBT and Meltano repositories when PostgreSQL implementations are ready
	c.dbtRepo = &InMemoryDbtRepository{}
	c.meltanoRepo = &InMemoryMeltanoRepository{}

	return nil
}

// initializeUseCases creates use case implementations
func (c *CleanContainer) initializeUseCases(validator *validation.Validator) error {
	// Pipeline use cases
	c.createPipelineUC = pipelineUC.NewCreatePipelineUseCase(
		c.pipelineRepo,
		&PipelineValidator{validator: validator},
		c.eventPublisher,
	)

	c.executePipelineUC = pipelineUC.NewExecutePipelineUseCase(
		c.pipelineRepo,
		&PipelineExecutor{},
		&PipelineValidator{validator: validator},
		c.eventPublisher,
	)

	c.getPipelineUC = pipelineUC.NewGetPipelineUseCase(
		c.pipelineRepo,
		&PipelineValidator{validator: validator},
	)

	c.listPipelinesUC = pipelineUC.NewListPipelinesUseCase(
		c.pipelineRepo,
		&PipelineValidator{validator: validator},
	)

	c.deletePipelineUC = pipelineUC.NewDeletePipelineUseCase(
		c.pipelineRepo,
		&PipelineValidator{validator: validator},
		c.eventPublisher,
	)

	// Plugin use cases (using stub validators for now)
	c.registerPluginUC = pluginUC.NewRegisterPluginUseCase(
		c.pluginRepo,
		&PluginValidator{validator: validator},
		c.eventPublisher,
	)

	c.getPluginUC = pluginUC.NewGetPluginUseCase(
		c.pluginRepo,
		&PluginValidator{validator: validator},
	)

	c.listPluginsUC = pluginUC.NewListPluginsUseCase(
		c.pluginRepo,
		&PluginValidator{validator: validator},
	)

	c.deletePluginUC = pluginUC.NewDeletePluginUseCase(
		c.pluginRepo,
		&PluginValidator{validator: validator},
		c.eventPublisher,
	)

	// DBT use cases (using stub implementations for now)
	c.createDbtProjectUC = dbtUC.NewCreateProjectUseCase(
		c.dbtRepo,
		&DbtValidator{validator: validator},
		c.eventPublisher,
	)

	c.executeDbtProjectUC = dbtUC.NewExecuteProjectUseCase(
		c.dbtRepo,
		&DbtExecutor{},
		&DbtValidator{validator: validator},
		c.eventPublisher,
	)

	c.getDbtProjectUC = dbtUC.NewGetProjectUseCase(
		c.dbtRepo,
	)

	c.listDbtProjectsUC = dbtUC.NewListProjectsUseCase(
		c.dbtRepo,
	)

	c.deleteDbtProjectUC = dbtUC.NewDeleteProjectUseCase(
		c.dbtRepo,
		&DbtValidator{validator: validator},
		c.eventPublisher,
	)

	// Meltano use cases (using corrected signatures)
	c.createMeltanoProjectUC = meltanoUC.NewCreateProjectUseCase(
		c.meltanoRepo,
		&MeltanoValidator{validator: validator},
		c.eventPublisher,
	)

	c.addMeltanoPluginUC = meltanoUC.NewAddPluginUseCase(
		c.meltanoRepo,
		&MeltanoValidator{validator: validator},
		c.eventPublisher,
	)

	// Create RunPipelineUseCase with in-memory run repository and executor
	c.runMeltanoPipelineUC = meltanoUC.NewRunPipelineUseCase(
		c.meltanoRepo,
		&InMemoryMeltanoRunRepository{},
		&MeltanoExecutor{},
		&MeltanoValidator{validator: validator},
		c.eventPublisher,
	)

	c.addMeltanoScheduleUC = meltanoUC.NewAddScheduleUseCase(
		c.meltanoRepo,
		&MeltanoValidator{validator: validator},
		c.eventPublisher,
	)

	c.getMeltanoProjectUC = meltanoUC.NewGetProjectUseCase(
		c.meltanoRepo,
		&MeltanoValidator{validator: validator},
	)

	c.listMeltanoProjectsUC = meltanoUC.NewListProjectsUseCase(
		c.meltanoRepo,
		&MeltanoValidator{validator: validator},
	)

	c.deleteMeltanoProjectUC = meltanoUC.NewDeleteProjectUseCase(
		c.meltanoRepo,
		&MeltanoValidator{validator: validator},
		c.eventPublisher,
	)

	return nil
}

// initializeHandlers creates HTTP handlers
func (c *CleanContainer) initializeHandlers() {
	// Enable Clean Architecture HTTP handlers
	// c.cleanPipelineHandler = http.NewCleanPipelineHandler( // DISABLED temporarily
	//	c.createPipelineUC,
	//	c.executePipelineUC,
	//	c.getPipelineUC,
	//	c.listPipelinesUC,
	//	c.deletePipelineUC,
	// )

	c.cleanPluginHandler = http.NewCleanPluginHandler(
		c.registerPluginUC,
		c.getPluginUC,
		c.listPluginsUC,
		c.deletePluginUC,
	)

	c.cleanDbtHandler = http.NewCleanDbtHandler(
		c.createDbtProjectUC,
		c.executeDbtProjectUC,
		c.getDbtProjectUC,
		c.listDbtProjectsUC,
		c.deleteDbtProjectUC,
	)

	c.cleanMeltanoHandler = http.NewCleanMeltanoHandler(
		c.createMeltanoProjectUC,
		c.addMeltanoPluginUC,
		c.runMeltanoPipelineUC,
		c.addMeltanoScheduleUC,
		c.getMeltanoProjectUC,
		c.listMeltanoProjectsUC,
		c.deleteMeltanoProjectUC,
	)
}

// GetHandlers returns all Clean Architecture HTTP handlers
func (c *CleanContainer) GetHandlers() (interface{}, *http.CleanPluginHandler, *http.CleanDbtHandler, *http.CleanMeltanoHandler) {
	return nil, c.cleanPluginHandler, c.cleanDbtHandler, c.cleanMeltanoHandler // cleanPipelineHandler disabled temporarily
}

// HealthCheck performs health checks on all Clean Architecture components
func (c *CleanContainer) HealthCheck(ctx context.Context) error {
	if c.db != nil {
		if err := c.db.PingContext(ctx); err != nil {
			return errors.Wrap(err, "database health check failed")
		}
	}
	return nil
}

// Shutdown gracefully shuts down all Clean Architecture components
func (c *CleanContainer) Shutdown(ctx context.Context) error {
	return nil
}

// EventAdapter adapts events.EventPublisher to unified interface
type EventAdapter struct {
	publisher events.EventPublisher
}

func (a *EventAdapter) Publish(ctx context.Context, event interface{}) error {
	return a.publisher.Publish(ctx, event)
}

