type DbtExecutor struct{}

func (e *DbtExecutor) Run(ctx context.Context, project *dbtEntities.DbtProject, execCtx *dbtUC.ExecutionContext) (*dbtUC.ExecutionResult, error) {
	return &dbtUC.ExecutionResult{
		ID:        uuid.New(),
		ProjectID: project.ID,
		Command:   "run",
		Status:    "success",
	}, nil
}

