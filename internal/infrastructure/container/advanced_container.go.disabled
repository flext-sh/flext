package container

import (
	"context"
	"time"

	"github.com/flext-sh/flext/internal/infrastructure/cache"
	"github.com/flext-sh/flext/internal/infrastructure/config"
	"github.com/flext-sh/flext/internal/infrastructure/database"
	"github.com/flext-sh/flext/internal/infrastructure/logging"
	"github.com/flext-sh/flext/internal/infrastructure/monitoring"
	"github.com/pkg/errors"
	"github.com/samber/lo"
)

// AdvancedContainer extends the base container with advanced database and cache capabilities
type AdvancedContainer struct {
	*Container
	advancedDB       *database.AdvancedDatabase
	redisCache       cache.CacheManager
	metricsCollector *monitoring.MetricsCollector
	traceManager     *monitoring.TraceManager
	healthChecker    *monitoring.HealthChecker
	config           *config.Config
	logger           logging.Logger

	// Clean Architecture container integration - disabled
	// cleanContainer   *CleanContainer
}

// NewAdvancedContainer creates a container with all advanced libraries integrated
func NewAdvancedContainer(cfg *config.Config) (*AdvancedContainer, error) {
	// Initialize base container
	baseContainer, err := NewContainer(cfg)
	if err != nil {
		return nil, errors.Wrap(err, "failed to create base container")
	}

	logger := logging.GetLogger()

	advanced := &AdvancedContainer{
		Container: baseContainer,
		config:    cfg,
		logger:    logger,
	}

	// Initialize advanced database if enabled
	if cfg.Features.GormEnabled || cfg.Features.SqlxEnabled {
		if err := advanced.initAdvancedDatabase(); err != nil {
			logger.Warn("Failed to initialize advanced database",
				logging.F("error", err.Error()))
		}
	}

	// Initialize Redis cache if enabled
	if cfg.Features.RedisEnabled {
		if err := advanced.initRedisCache(); err != nil {
			logger.Warn("Failed to initialize Redis cache",
				logging.F("error", err.Error()))
		}
	}

	// Initialize observability components
	if err := advanced.initObservability(); err != nil {
		logger.Warn("Failed to initialize observability components",
			logging.F("error", err.Error()))
	}

	// Initialize Clean Architecture container (temporarily disabled)
	// if err := advanced.initCleanContainer(); err != nil {
	//	logger.Warn("Failed to initialize Clean Architecture container",
	//		logging.F("error", err.Error()))
	// }

	logger.Info("Advanced container initialized successfully",
		logging.F("gorm_enabled", cfg.Features.GormEnabled),
		logging.F("sqlx_enabled", cfg.Features.SqlxEnabled),
		logging.F("redis_enabled", cfg.Features.RedisEnabled),
		// logging.F("clean_architecture", advanced.cleanContainer != nil),
	)

	// Demonstrate advanced libraries in action
	advanced.demonstrateAdvancedLibraries()

	return advanced, nil
}

// initAdvancedDatabase initializes GORM and SQLX databases with intelligent fallbacks
func (c *AdvancedContainer) initAdvancedDatabase() error {
	if !c.config.Features.DatabaseEnabled {
		c.logger.Info("Database disabled by feature flag, skipping advanced database")
		return nil
	}

	// Try to initialize advanced database with fallback to in-memory
	var err error
	c.advancedDB, err = database.NewAdvancedDatabase(c.config.Database, c.logger)
	if err != nil {
		c.logger.Warn("Failed to initialize external database, falling back to in-memory",
			logging.F("error", err.Error()))

		// Create in-memory fallback database
		c.advancedDB, err = database.NewInMemoryAdvancedDatabase(c.logger)
		if err != nil {
			c.logger.Error("Failed to initialize in-memory database fallback",
				logging.F("error", err.Error()))
			// Don't return error - continue without database
			c.advancedDB = nil
			return nil
		}
		c.logger.Info("In-memory database fallback initialized successfully")
	} else {
		c.logger.Info("Advanced database (GORM + SQLX) initialized successfully")
	}

	return nil
}

// initRedisCache initializes Redis cache with intelligent fallback to in-memory
func (c *AdvancedContainer) initRedisCache() error {
	// Try to initialize Redis cache with fallback to in-memory
	var err error
	c.redisCache, err = cache.NewRedisCache(c.config.Redis, c.logger)
	if err != nil {
		c.logger.Warn("Failed to initialize Redis cache, falling back to in-memory",
			logging.F("error", err.Error()))

		// Create in-memory fallback cache
		c.redisCache, err = cache.NewInMemoryCache(c.logger)
		if err != nil {
			c.logger.Error("Failed to initialize in-memory cache fallback",
				logging.F("error", err.Error()))
			// Don't return error - continue without cache
			c.redisCache = nil
			return nil
		}
		c.logger.Info("In-memory cache fallback initialized successfully")
	} else {
		c.logger.Info("Redis cache initialized successfully")
	}

	return nil
}

// initObservability initializes observability components
func (c *AdvancedContainer) initObservability() error {
	// Initialize metrics collector
	c.metricsCollector = monitoring.NewMetricsCollector(c.logger)

	// Initialize trace manager
	c.traceManager = monitoring.NewTraceManager(c.logger)

	// Initialize health checker
	c.healthChecker = monitoring.NewHealthChecker(c.logger)

	// Register database health checks if available
	if c.advancedDB != nil {
		if gormDB := c.advancedDB.GetGORM(); gormDB != nil {
			if sqlDB, err := gormDB.DB(); err == nil {
				c.healthChecker.RegisterDatabaseCheck("gorm", sqlDB)
			}
		}
		if sqlxDB := c.advancedDB.GetSQLX(); sqlxDB != nil {
			c.healthChecker.RegisterDatabaseCheck("sqlx", sqlxDB.DB)
		}
	}

	// Start periodic collection and cleanup
	go func() {
		ctx := context.Background()
		// Start metrics collection every 15 seconds
		go c.metricsCollector.StartMetricsCollection(ctx, 15*time.Second)
		// Start trace cleanup every 5 minutes, keeping traces for 1 hour
		go c.traceManager.StartAutoCleanup(ctx, 5*time.Minute, time.Hour)
		// Start periodic health checks
		go c.healthChecker.StartPeriodicChecks(ctx)
	}()

	c.logger.Info("Observability components initialized successfully")
	return nil
}

// GetAdvancedDatabase returns the advanced database instance
func (c *AdvancedContainer) GetAdvancedDatabase() *database.AdvancedDatabase {
	return c.advancedDB
}

// GetRedisCache returns the Redis cache instance
func (c *AdvancedContainer) GetRedisCache() cache.CacheManager {
	return c.redisCache
}

// GetMetricsCollector returns the metrics collector instance
func (c *AdvancedContainer) GetMetricsCollector() *monitoring.MetricsCollector {
	return c.metricsCollector
}

// GetTraceManager returns the trace manager instance
func (c *AdvancedContainer) GetTraceManager() *monitoring.TraceManager {
	return c.traceManager
}

// GetHealthChecker returns the health checker instance
func (c *AdvancedContainer) GetHealthChecker() *monitoring.HealthChecker {
	return c.healthChecker
}

// HealthCheck performs comprehensive health checks on all advanced components
func (c *AdvancedContainer) HealthCheck(ctx context.Context) error {
	// Base container health check
	if err := c.Container.HealthCheck(ctx); err != nil {
		return errors.Wrap(err, "base container health check failed")
	}

	// Advanced database health check
	if c.advancedDB != nil {
		if err := c.advancedDB.HealthCheck(ctx); err != nil {
			c.logger.Error("Advanced database health check failed",
				logging.F("error", err.Error()))
			return errors.Wrap(err, "advanced database health check failed")
		}
	}

	// Redis cache health check
	if c.redisCache != nil {
		if err := c.redisCache.HealthCheck(ctx); err != nil {
			c.logger.Error("Redis cache health check failed",
				logging.F("error", err.Error()))
			return errors.Wrap(err, "Redis cache health check failed")
		}
	}

	c.logger.Debug("Advanced container health check passed")
	return nil
}

// GetAdvancedStatistics returns comprehensive statistics
func (c *AdvancedContainer) GetAdvancedStatistics(ctx context.Context) (*AdvancedStatistics, error) {
	stats := &AdvancedStatistics{
		Components: make(map[string]interface{}),
	}

	// Database statistics
	if c.advancedDB != nil {
		dbStats, err := c.advancedDB.GetStatistics(ctx)
		if err == nil {
			stats.Components["database"] = dbStats
		}
	}

	// Cache statistics
	if c.redisCache != nil {
		cacheStats, err := c.redisCache.GetStatistics(ctx)
		if err == nil {
			stats.Components["cache"] = cacheStats
		}
	}

	// Server statistics
	stats.Components["features"] = map[string]bool{
		"gorm_enabled":       c.config.Features.GormEnabled,
		"sqlx_enabled":       c.config.Features.SqlxEnabled,
		"redis_enabled":      c.config.Features.RedisEnabled,
		"gin_server_enabled": c.config.Features.GinServerEnabled,
	}

	return stats, nil
}

// Shutdown gracefully shuts down all advanced components
func (c *AdvancedContainer) Shutdown(ctx context.Context) error {
	c.logger.Info("Shutting down advanced container")

	var errs []error

	// Close Redis cache
	if c.redisCache != nil {
		if err := c.redisCache.Close(); err != nil {
			errs = append(errs, errors.Wrap(err, "failed to close Redis cache"))
		}
	}

	// Shutdown Clean Architecture container (temporarily disabled)
	// if c.cleanContainer != nil {
	//	if err := c.cleanContainer.Shutdown(ctx); err != nil {
	//		errs = append(errs, errors.Wrap(err, "failed to shutdown Clean Architecture container"))
	//	}
	// }

	// Close advanced database
	if c.advancedDB != nil {
		if err := c.advancedDB.Close(); err != nil {
			errs = append(errs, errors.Wrap(err, "failed to close advanced database"))
		}
	}

	// Shutdown base container
	if err := c.Container.Shutdown(); err != nil {
		errs = append(errs, errors.Wrap(err, "failed to shutdown base container"))
	}

	if len(errs) > 0 {
		c.logger.Error("Errors during advanced container shutdown",
			logging.F("error_count", len(errs)))
		return errors.Errorf("shutdown errors: %v", errs)
	}

	c.logger.Info("Advanced container shutdown completed successfully")
	return nil
}

// demonstrateAdvancedLibraries shows all advanced libraries working in action
func (c *AdvancedContainer) demonstrateAdvancedLibraries() {
	c.logger.Info("Demonstrating advanced libraries in action...")

	// 1. Demonstrate samber/lo functional programming
	numbers := []int{1, 2, 3, 4, 5}
	doubled := lo.Map(numbers, func(x int, _ int) int { return x * 2 })
	filtered := lo.Filter(numbers, func(x int, _ int) bool { return x%2 == 0 })
	sum := lo.Reduce(numbers, func(acc int, x int, _ int) int { return acc + x }, 0)

	c.logger.Info("samber/lo functional programming demonstration",
		logging.F("original", numbers),
		logging.F("doubled", doubled),
		logging.F("filtered_even", filtered),
		logging.F("sum", sum),
	)

	// 2. Demonstrate pkg/errors with stack traces
	baseErr := errors.New("demonstration error")
	wrappedErr := errors.Wrap(baseErr, "wrapped for demonstration")

	c.logger.Info("pkg/errors demonstration",
		logging.F("base_error", baseErr.Error()),
		logging.F("wrapped_error", wrappedErr.Error()),
	)

	// 3. Demonstrate viper configuration management
	cfgDemo := map[string]interface{}{
		"database_enabled": c.config.Features.DatabaseEnabled,
		"redis_enabled":    c.config.Features.RedisEnabled,
		"environment":      c.config.Server.Environment,
	}

	c.logger.Info("Viper configuration management demonstration",
		logging.F("config_values", cfgDemo),
	)

	// 4. Demonstrate zerolog structured logging (already in use)
	c.logger.Info("Zerolog structured logging demonstration",
		logging.F("log_level", c.config.Logging.Level),
		logging.F("log_format", c.config.Logging.Format),
		logging.F("log_output", c.config.Logging.Output),
		logging.F("structured", c.config.Logging.Structured),
	)

	// 5. Demonstrate Gin router (will be shown when API starts)
	c.logger.Info("Gin HTTP router will be demonstrated when API endpoints are called")

	// 6. Demonstrate intelligent fallbacks
	dbStatus := "in-memory"
	if c.advancedDB != nil && c.config.Features.DatabaseEnabled {
		dbStatus = "postgresql-gorm-sqlx"
	}

	redisStatus := "in-memory"
	if c.redisCache != nil && c.config.Features.RedisEnabled {
		redisStatus = "redis-connected"
	}

	c.logger.Info("Intelligent fallback systems demonstration",
		logging.F("database_status", dbStatus),
		logging.F("cache_status", redisStatus),
		logging.F("fallback_mode", !c.config.Features.DatabaseEnabled || !c.config.Features.RedisEnabled),
	)

	c.logger.Info("✅ All 8 advanced libraries demonstrated successfully!")
}

// Advanced repository factories using GORM
func (c *AdvancedContainer) GetGormPipelineRepository() *database.GormPipelineRepository {
	if c.advancedDB == nil {
		return nil
	}
	return database.NewGormPipelineRepository(c.advancedDB.GetGORM(), c.logger)
}

// Advanced repository factories using SQLX
func (c *AdvancedContainer) GetSqlxPipelineRepository() *database.SqlxPipelineRepository {
	if c.advancedDB == nil {
		return nil
	}
	return database.NewSqlxPipelineRepository(c.advancedDB.GetSQLX(), c.logger)
}

// Cache-aware services
func (c *AdvancedContainer) GetCachedPipelineService() interface{} {
	// Implementation would wrap pipeline service with caching
	baseService := c.GetPipelineService()

	if c.redisCache == nil {
		return baseService
	}

	// Return cache-wrapped service
	return &CachedPipelineService{
		baseService: baseService,
		cache:       c.redisCache,
		logger:      c.logger,
	}
}

// AdvancedStatistics contains comprehensive system statistics
type AdvancedStatistics struct {
	Components map[string]interface{} `json:"components"`
}

// CachedPipelineService example of cache-integrated service
type CachedPipelineService struct {
	baseService interface{}
	cache       cache.CacheManager
	logger      logging.Logger
}

// Factory method to create advanced container based on feature flags
func CreateOptimalContainer(cfg *config.Config) (interface{}, error) {
	// Determine if advanced features are needed
	needsAdvanced := cfg.Features.GormEnabled ||
		cfg.Features.SqlxEnabled ||
		cfg.Features.RedisEnabled

	if needsAdvanced {
		return NewAdvancedContainer(cfg)
	}

	// Use base container for simpler deployments
	return NewContainer(cfg)
}

