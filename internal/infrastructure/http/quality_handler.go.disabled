package http

import (
	"net/http"
	"strconv"

	"github.com/flext-sh/flext/internal/infrastructure/quality"
	"github.com/google/uuid"
	"github.com/labstack/echo/v4"
)

// QualityHandler handles quality-related HTTP requests
type QualityHandler struct {
	qualityManager *quality.QualityManager
}

// NewQualityHandler creates a new quality handler
func NewQualityHandler(qualityManager *quality.QualityManager) *QualityHandler {
	return &QualityHandler{
		qualityManager: qualityManager,
	}
}

// RunQualityCheck handles POST /api/v1/quality/check
func (h *QualityHandler) RunQualityCheck(c echo.Context) error {
	var request struct {
		ResourceID   string      `json:"resource_id" validate:"required"`
		ResourceType string      `json:"resource_type" validate:"required"`
		Data         interface{} `json:"data"`
	}

	if err := c.Bind(&request); err != nil {
		return c.JSON(http.StatusBadRequest, ErrorResponse{
			Error:   "Bad Request",
			Message: "Invalid request body format",
			Code:    http.StatusBadRequest,
		})
	}

	if err := c.Validate(&request); err != nil {
		return c.JSON(http.StatusBadRequest, ValidationErrorResponse(err))
	}

	// Run quality checks
	report, err := h.qualityManager.RunQualityChecks(
		c.Request().Context(),
		request.ResourceID,
		request.ResourceType,
		request.Data,
	)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, ErrorResponse{
			Error:   "Internal Server Error",
			Message: "Failed to run quality checks",
			Code:    http.StatusInternalServerError,
		})
	}

	return c.JSON(http.StatusCreated, map[string]interface{}{
		"success": true,
		"data":    report,
	})
}

// GetQualityReport handles GET /api/v1/quality/reports/:id
func (h *QualityHandler) GetQualityReport(c echo.Context) error {
	reportID := c.Param("id")

	// Validate report ID
	if _, err := uuid.Parse(reportID); err != nil {
		return c.JSON(http.StatusBadRequest, ErrorResponse{
			Error:   "Bad Request",
			Message: "Invalid report ID format",
			Code:    http.StatusBadRequest,
		})
	}

	report, exists := h.qualityManager.GetQualityReport(reportID)
	if !exists {
		return c.JSON(http.StatusNotFound, ErrorResponse{
			Error:   "Not Found",
			Message: "Quality report not found",
			Code:    http.StatusNotFound,
		})
	}

	return c.JSON(http.StatusOK, map[string]interface{}{
		"success": true,
		"data":    report,
	})
}

// ListQualityReports handles GET /api/v1/quality/reports
func (h *QualityHandler) ListQualityReports(c echo.Context) error {
	resourceID := c.QueryParam("resource_id")
	limitStr := c.QueryParam("limit")
	offsetStr := c.QueryParam("offset")

	// Parse pagination parameters
	limit := 50
	offset := 0

	if limitStr != "" {
		if l, err := strconv.Atoi(limitStr); err == nil && l > 0 && l <= 100 {
			limit = l
		}
	}

	if offsetStr != "" {
		if o, err := strconv.Atoi(offsetStr); err == nil && o >= 0 {
			offset = o
		}
	}

	var reports []*quality.QualityReport

	if resourceID != "" {
		// Get reports for specific resource
		reports = h.qualityManager.ListQualityReports(resourceID)
	} else {
		// Get all reports (in a real implementation, this would be paginated)
		reports = h.getAllReports()
	}

	// Apply pagination
	total := len(reports)
	end := offset + limit
	if end > total {
		end = total
	}

	if offset >= total {
		reports = []*quality.QualityReport{}
	} else {
		reports = reports[offset:end]
	}

	return c.JSON(http.StatusOK, map[string]interface{}{
		"success": true,
		"data": map[string]interface{}{
			"reports": reports,
			"total":   total,
			"limit":   limit,
			"offset":  offset,
		},
	})
}

// GetQualityMetrics handles GET /api/v1/quality/metrics
func (h *QualityHandler) GetQualityMetrics(c echo.Context) error {
	metrics := h.qualityManager.GetQualityMetrics()

	return c.JSON(http.StatusOK, map[string]interface{}{
		"success": true,
		"data":    metrics,
	})
}

// GetQualityTrends handles GET /api/v1/quality/trends
func (h *QualityHandler) GetQualityTrends(c echo.Context) error {
	resourceID := c.QueryParam("resource_id")
	daysStr := c.QueryParam("days")

	// Parse days parameter
	days := 30 // default
	if daysStr != "" {
		if d, err := strconv.Atoi(daysStr); err == nil && d > 0 && d <= 365 {
			days = d
		}
	}

	// Generate trend data (simplified implementation)
	trends := h.generateQualityTrends(resourceID, days)

	return c.JSON(http.StatusOK, map[string]interface{}{
		"success": true,
		"data":    trends,
	})
}

// GetQualityDashboard handles GET /api/v1/quality/dashboard
func (h *QualityHandler) GetQualityDashboard(c echo.Context) error {
	// Get overall metrics
	metrics := h.qualityManager.GetQualityMetrics()

	// Get recent reports
	recentReports := h.getRecentReports(10)

	// Calculate dashboard statistics
	dashboardData := map[string]interface{}{
		"overview": metrics,
		"recent_reports": recentReports,
		"quality_distribution": h.calculateQualityDistribution(),
		"top_issues": h.getTopIssues(),
		"improvement_suggestions": h.getImprovementSuggestions(),
	}

	return c.JSON(http.StatusOK, map[string]interface{}{
		"success": true,
		"data":    dashboardData,
	})
}

// ValidateQualityRules handles POST /api/v1/quality/validate
func (h *QualityHandler) ValidateQualityRules(c echo.Context) error {
	var request struct {
		Rules []map[string]interface{} `json:"rules" validate:"required"`
		Data  interface{}             `json:"data" validate:"required"`
	}

	if err := c.Bind(&request); err != nil {
		return c.JSON(http.StatusBadRequest, ErrorResponse{
			Error:   "Bad Request",
			Message: "Invalid request body format",
			Code:    http.StatusBadRequest,
		})
	}

	// Validate quality rules against data
	validationResults := h.validateRules(request.Rules, request.Data)

	return c.JSON(http.StatusOK, map[string]interface{}{
		"success": true,
		"data":    validationResults,
	})
}

