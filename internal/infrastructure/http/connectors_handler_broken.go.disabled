// LDAPTestConnection tests LDAP connection
func (h *ConnectorsHandler) LDAPTestConnection(c echo.Context) error {
	var req LDAPConnectRequest
	if err := c.Bind(&req); err != nil {
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": "Invalid request body",
		})
	}

	config := &connectors.LDAPConfig{
		Host:          req.Host,
		Port:          req.Port,
		UseSSL:        req.UseSSL,
		UseTLS:        req.UseTLS,
		SkipTLSVerify: req.SkipTLSVerify,
		BindDN:        req.BindDN,
		BindPassword:  req.BindPassword,
		BaseDN:        req.BaseDN,
	}

	connector, err := connectors.NewLDAPConnector(config, h.logger)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]string{
			"error": err.Error(),
		})
	}
	defer func() {
		if closer, ok := connector.(interface{ Close() error }); ok {
			closer.Close()
		}
	}()

	err = connector.TestConnection(c.Request().Context())
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]interface{}{
			"success": false,
			"error":   err.Error(),
		})
	}

	return c.JSON(http.StatusOK, map[string]interface{}{
		"success": true,
		"message": "LDAP connection test successful",
	})
}

