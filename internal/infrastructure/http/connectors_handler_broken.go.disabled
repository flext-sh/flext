package http

import (
	"net/http"
	"strconv"

	"github.com/flext-sh/flext/internal/infrastructure/connectors"
	"github.com/flext-sh/flext/internal/infrastructure/logging"
	"github.com/labstack/echo/v4"
)

// ConnectorsHandler handles connector-related HTTP requests
type ConnectorsHandler struct {
	logger logging.Logger
}

// NewConnectorsHandler creates a new connectors handler
func NewConnectorsHandler(logger logging.Logger) *ConnectorsHandler {
	return &ConnectorsHandler{
		logger: logger,
	}
}

// LDAP Request/Response types
type LDAPConnectRequest struct {
	Host             string   `json:"host" validate:"required"`
	Port             int      `json:"port"`
	UseSSL           bool     `json:"use_ssl"`
	UseTLS           bool     `json:"use_tls"`
	SkipTLSVerify   bool     `json:"skip_tls_verify"`
	BindDN          string   `json:"bind_dn"`
	BindPassword    string   `json:"bind_password"`
	BaseDN          string   `json:"base_dn"`
	SearchFilter    string   `json:"search_filter"`
	Attributes      []string `json:"attributes"`
	TimeLimit       int      `json:"time_limit"`
	SizeLimit       int      `json:"size_limit"`
}

type LDAPSearchRequest struct {
	BaseDN     string   `json:"base_dn"`
	Filter     string   `json:"filter"`
	Attributes []string `json:"attributes"`
	PageSize   int      `json:"page_size"`
}

type LDAPAddRequest struct {
	DN         string              `json:"dn" validate:"required"`
	Attributes map[string][]string `json:"attributes" validate:"required"`
}

type LDAPModifyRequest struct {
	DN            string              `json:"dn" validate:"required"`
	Modifications map[string][]string `json:"modifications" validate:"required"`
}

type LDAPDeleteRequest struct {
	DN string `json:"dn" validate:"required"`
}

// Oracle Request/Response types
type OracleConnectRequest struct {
	Host              string `json:"host" validate:"required"`
	Port              int    `json:"port"`
	ServiceName       string `json:"service_name"`
	SID               string `json:"sid"`
	Username          string `json:"username" validate:"required"`
	Password          string `json:"password" validate:"required"`
	ConnectString     string `json:"connect_string"`
	Wallet            string `json:"wallet"`
	WalletPassword    string `json:"wallet_password"`
	MaxOpenConns      int    `json:"max_open_conns"`
	MaxIdleConns      int    `json:"max_idle_conns"`
	FetchArraySize    int    `json:"fetch_array_size"`
	StmtCacheSize     int    `json:"stmt_cache_size"`
	Timezone          string `json:"timezone"`
	Charset           string `json:"charset"`
}

type OracleQueryRequest struct {
	Query string        `json:"query" validate:"required"`
	Args  []interface{} `json:"args"`
}

type OracleExecuteRequest struct {
	Command string        `json:"command" validate:"required"`
	Args    []interface{} `json:"args"`
}

type OracleTableInfoRequest struct {
	Owner     string `json:"owner" validate:"required"`
	TableName string `json:"table_name" validate:"required"`
}

// RegisterRoutes registers connector routes
func (h *ConnectorsHandler) RegisterRoutes(e *echo.Echo) {
	connectorsGroup := e.Group("/api/v1/connectors")

	// LDAP endpoints
	ldapGroup := connectorsGroup.Group("/ldap")
	ldapGroup.POST("/connect", h.LDAPConnect)
	ldapGroup.POST("/search", h.LDAPSearch)
	ldapGroup.POST("/add", h.LDAPAdd)
	ldapGroup.POST("/modify", h.LDAPModify)
	ldapGroup.POST("/delete", h.LDAPDelete)
	ldapGroup.POST("/test", h.LDAPTestConnection)
	ldapGroup.GET("/schema", h.LDAPGetSchema)

	// Oracle endpoints
	oracleGroup := connectorsGroup.Group("/oracle")
	oracleGroup.POST("/connect", h.OracleConnect)
	oracleGroup.POST("/query", h.OracleQuery)
	oracleGroup.POST("/execute", h.OracleExecute)
	oracleGroup.POST("/table-info", h.OracleTableInfo)
	oracleGroup.POST("/test", h.OracleTestConnection)
	oracleGroup.GET("/version", h.OracleGetVersion)
}

// LDAP Handlers

// LDAPConnect establishes LDAP connection and performs test operations
func (h *ConnectorsHandler) LDAPConnect(c echo.Context) error {
	var req LDAPConnectRequest
	if err := h.validateLDAPRequest(c, &req); err != nil {
		return err
	}

	config := h.buildLDAPConfig(&req)
	connector, err := h.createLDAPConnector(config)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]string{
			"error": err.Error(),
		})
	}
	defer func() {
		if closer, ok := connector.(interface{ Close() error }); ok {
			closer.Close()
		}
	}()

	return h.performLDAPConnection(c, connector)
}

// LDAPSearch performs LDAP search operation
func (h *ConnectorsHandler) LDAPSearch(c echo.Context) error {
	var req LDAPSearchRequest
	if err := c.Bind(&req); err != nil {
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": "Invalid request body",
		})
	}

	// Get connection config from headers or session (simplified for demo)
	config := h.getLDAPConfigFromContext(c)
	if config == nil {
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": "LDAP connection configuration required",
		})
	}

	connector, err := connectors.NewLDAPConnector(config, h.logger)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]string{
			"error": err.Error(),
		})
	}
	defer func() {
		if closer, ok := connector.(interface{ Close() error }); ok {
			closer.Close()
		}
	}()

	err = connector.Connect(c.Request().Context())
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]string{
			"error": err.Error(),
		})
	}

	result, err := connector.Search(c.Request().Context(), req.BaseDN, req.Filter, req.Attributes)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]string{
			"error": err.Error(),
		})
	}

	return c.JSON(http.StatusOK, result)
}

// LDAPAdd adds a new LDAP entry
func (h *ConnectorsHandler) LDAPAdd(c echo.Context) error {
	var req LDAPAddRequest
	if err := c.Bind(&req); err != nil {
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": "Invalid request body",
		})
	}

	if err := c.Validate(&req); err != nil {
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": err.Error(),
		})
	}

	config := h.getLDAPConfigFromContext(c)
	if config == nil {
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": "LDAP connection configuration required",
		})
	}

	connector, err := connectors.NewLDAPConnector(config, h.logger)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]string{
			"error": err.Error(),
		})
	}
	defer func() {
		if closer, ok := connector.(interface{ Close() error }); ok {
			closer.Close()
		}
	}()

	err = connector.Connect(c.Request().Context())
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]string{
			"error": err.Error(),
		})
	}

	result, err := connector.Add(c.Request().Context(), req.DN, req.Attributes)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]interface{}{
			"error":  err.Error(),
			"result": result,
		})
	}

	return c.JSON(http.StatusOK, result)
}

